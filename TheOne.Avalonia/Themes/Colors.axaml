            <SolidColorBrush Color="{StaticResource One.TextColor}" x:Key="One.Gantt.Text" />
            <SolidColorBrush Color="{StaticResource One.LineColor}" x:Key="One.Gantt.Grid" />
            <SolidColorBrush Color="{StaticResource One.SubtleColor}" x:Key="One.Gantt.Header" />
            <SolidColorBrush Color="{StaticResource One.SubtleColor}" x:Key="One.Gantt.Weekend" />
            <SolidColorBrush Color="{StaticResource One.AccentSoftColor}" x:Key="One.Gantt.Task" />
            <SolidColorBrush Color="{StaticResource One.AccentColor}" x:Key="One.Gantt.Progress" />
            <SolidColorBrush Color="{StaticResource One.RowSelectedColor}" x:Key="One.Gantt.Selection" />
            <SolidColorBrush Color="{StaticResource One.MutedColor}" x:Key="One.Gantt.Muted" />
            <SolidColorBrush Color="{StaticResource One.OnAccentColor}" x:Key="One.Gantt.OnTask" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush Color="Transparent" x:Key="One.Transparent" />
</ResourceDictionary>