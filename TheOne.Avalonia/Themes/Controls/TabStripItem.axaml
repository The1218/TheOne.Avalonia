<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTheme TargetType="TabStripItem" x:Key="{x:Type TabStripItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Control}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Height}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_LayoutRoot">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Name="PART_ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Button
                                AutomationProperties.Name="关闭标签页"
                                Classes="one-close"
                                Command="{x:Static one:TabFeatures.CloseTabCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Grid.Column="1"
                                Height="24"
                                Margin="0,0,6,0"
                                MinHeight="0"
                                MinWidth="0"
                                Name="PART_CloseButton"
                                Padding="5"
                                Theme="{StaticResource One.CardTabHeaderButton}"
                                ToolTip.Tip="关闭标签页（Ctrl / ⌘ + W）"
                                Width="24">
                                <Button.IsVisible>
                                    <TemplateBinding Property="one:TabFeatures.ShowCloseButton" />
                                </Button.IsVisible>
                                <PathIcon
                                    Data="M 1,0 L 6,5 L 11,0 L 12,1 L 7,6 L 12,11 L 11,12 L 6,7 L 1,12 L 0,11 L 5,6 L 0,1 Z"
                                    Height="12"
                                    Width="12" />
                            </Button>
                        </Grid>
                        <Border
                            Background="{DynamicResource One.Accent}"
                            CornerRadius="1"
                            Height="2"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Margin="10,0,10,2"
                            Name="PART_SelectedPipe"
                            VerticalAlignment="Bottom" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource One.NeutralHover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource One.NeutralPressed}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:selected:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource One.AccentHover}" />
        </Style>
        <Style Selector="^:selected:pressed">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.AccentHover}" />
        </Style>
        <Style Selector="^:selected:pressed /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.AccentPressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>