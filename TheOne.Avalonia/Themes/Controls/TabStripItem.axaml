<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:one="using:TheOne.Avalonia.Controls" x:CompileBindings="True">

    <ControlTheme TargetType="TabStripItem" x:Key="{x:Type TabStripItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Control}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Height}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_LayoutRoot">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Name="PART_ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Button
                            Name="PART_CloseButton"
                            Grid.Column="1"
                            Classes="one-close"
                            Theme="{StaticResource One.CardTabHeaderButton}"
                            Command="{x:Static one:TabFeatures.CloseTabCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False"
                            Width="24" Height="24" MinWidth="0" MinHeight="0"
                            Margin="0,0,6,0" Padding="5"
                            AutomationProperties.Name="关闭标签页"
                            ToolTip.Tip="关闭标签页（Ctrl / ⌘ + W）">
                            <Button.IsVisible><TemplateBinding Property="one:TabFeatures.ShowCloseButton" /></Button.IsVisible>
                            <PathIcon Data="M 1,0 L 6,5 L 11,0 L 12,1 L 7,6 L 12,11 L 11,12 L 6,7 L 1,12 L 0,11 L 5,6 L 0,1 Z" Width="12" Height="12" />
                        </Button>
                        </Grid>
                        <Border
                            Background="{DynamicResource One.Accent}"
                            CornerRadius="1"
                            Height="2"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            Margin="10,0,10,2"
                            Name="PART_SelectedPipe"
                            VerticalAlignment="Bottom" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource One.NeutralHover}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource One.NeutralPressed}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:selected:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource One.AccentHover}" />
        </Style>
        <Style Selector="^:selected:pressed">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.AccentHover}" />
        </Style>
        <Style Selector="^:selected:pressed /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.AccentPressed}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
