<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="one:InfoCard" x:Key="{x:Type one:InfoCard}">
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="HeaderBackground" Value="{DynamicResource One.Subtle}" />
        <Setter Property="FooterBackground" Value="{DynamicResource One.InfoCard.Footer}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Card}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeaderFontSize" Value="16" />
        <Setter Property="HeaderSpacing" Value="12" />
        <Setter Property="HeaderIconSize" Value="18" />
        <Setter Property="HeaderContentSpacing" Value="10" />
        <Setter Property="FooterSpacing" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Background="Transparent"
                        BoxShadow="{TemplateBinding BoxShadow}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Name="PART_Shadow" />
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Name="PART_Surface">
                        <Grid
                            Name="PART_Layout"
                            RowDefinitions="Auto,*"
                            RowSpacing="0">
                            <Border
                                Background="{TemplateBinding HeaderBackground}"
                                IsVisible="False"
                                Name="PART_HeaderHost"
                                Padding="{TemplateBinding HeaderPadding}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                                    <Viewbox Width="{TemplateBinding HeaderIconSize}" Height="{TemplateBinding HeaderIconSize}"
                                             VerticalAlignment="Center" Stretch="Uniform"
                                             IsVisible="{CompiledBinding #PART_HeaderIconPresenter.IsVisible}">
                                        <ContentPresenter
                                            Content="{TemplateBinding HeaderIcon}"
                                            ContentTemplate="{TemplateBinding HeaderIconTemplate}"
                                            FontSize="{TemplateBinding HeaderIconSize}"
                                            Foreground="{TemplateBinding Foreground}"
                                            HorizontalContentAlignment="Stretch"
                                            IsVisible="False"
                                            Name="PART_HeaderIconPresenter"
                                            VerticalAlignment="Center"
                                            VerticalContentAlignment="Stretch">
                                            <ContentPresenter.DataTemplates>
                                                <DataTemplate DataType="{x:Type one:OneIconKind}" x:DataType="one:OneIconKind">
                                                    <one:OneIcon Kind="{CompiledBinding}"
                                                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                </DataTemplate>
                                                <DataTemplate DataType="{x:Type Geometry}" x:DataType="Geometry">
                                                    <PathIcon Data="{CompiledBinding}" />
                                                </DataTemplate>
                                            </ContentPresenter.DataTemplates>
                                        </ContentPresenter>
                                    </Viewbox>
                                    <Border
                                        Grid.Column="1"
                                        IsVisible="False"
                                        Name="PART_HeaderIconGap"
                                        Width="{TemplateBinding HeaderContentSpacing}" />
                                    <ContentPresenter
                                        Content="{TemplateBinding Header}"
                                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                                        FontSize="{TemplateBinding HeaderFontSize}"
                                        FontWeight="SemiBold"
                                        Foreground="{TemplateBinding Foreground}"
                                        Grid.Column="2"
                                        HorizontalContentAlignment="Stretch"
                                        IsVisible="False"
                                        Name="PART_HeaderPresenter"
                                        TextBlock.TextWrapping="Wrap"
                                        VerticalContentAlignment="Center" />
                                    <Border
                                        Grid.Column="3"
                                        IsVisible="False"
                                        Name="PART_HeaderActionsGap"
                                        Width="{TemplateBinding HeaderContentSpacing}" />
                                    <ContentPresenter
                                        Content="{TemplateBinding HeaderActions}"
                                        ContentTemplate="{TemplateBinding HeaderActionsTemplate}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Grid.Column="4"
                                        HorizontalContentAlignment="Right"
                                        IsVisible="False"
                                        Name="PART_HeaderActionsPresenter"
                                        VerticalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <Grid
                                Grid.Row="1"
                                Name="PART_ContentGrid"
                                RowDefinitions="Auto,*,Auto,Auto">
                                <Border IsVisible="False" Name="PART_HeaderGap">
                                    <Border
                                        Background="{DynamicResource One.Line}"
                                        Height="1"
                                        IsHitTestVisible="False"
                                        IsVisible="{TemplateBinding ShowHeaderSeparator}"
                                        Name="PART_HeaderSeparator" />
                                </Border>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    Grid.Row="1"
                                    IsVisible="False"
                                    Name="PART_ContentHost"
                                    Padding="{TemplateBinding Padding}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Name="PART_ContentPresenter"
                                        TextBlock.TextWrapping="Wrap"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <Border
                                    Grid.Row="2"
                                    IsVisible="False"
                                    Name="PART_FooterGap">
                                    <Border
                                        Background="{DynamicResource One.Line}"
                                        Height="1"
                                        IsHitTestVisible="False"
                                        IsVisible="{TemplateBinding ShowFooterSeparator}"
                                        Name="PART_FooterSeparator" />
                                </Border>
                                <Border
                                    Background="{TemplateBinding FooterBackground}"
                                    Grid.Row="3"
                                    IsVisible="False"
                                    Name="PART_FooterHost"
                                    Padding="{TemplateBinding FooterPadding}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Footer}"
                                        ContentTemplate="{TemplateBinding FooterTemplate}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalContentAlignment="Stretch"
                                        IsVisible="False"
                                        Name="PART_FooterPresenter"
                                        TextBlock.TextWrapping="Wrap"
                                        VerticalContentAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsHitTestVisible="False"
                        Name="PART_Outline" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:has-header /template/ Border#PART_HeaderHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-title /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-icon /template/ ContentPresenter#PART_HeaderIconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-actions /template/ ContentPresenter#PART_HeaderActionsPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-icon:has-title /template/ Border#PART_HeaderIconGap, ^:has-icon:has-actions /template/ Border#PART_HeaderIconGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-actions:has-title /template/ Border#PART_HeaderActionsGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-header:has-body /template/ Border#PART_HeaderGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-footer /template/ ContentPresenter#PART_FooterPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-footer:has-body /template/ Border#PART_FooterGap, ^:has-footer:has-header /template/ Border#PART_FooterGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-body /template/ Border#PART_ContentHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-footer /template/ Border#PART_FooterHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="HeaderBackground" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="FooterBackground" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
        <Style Selector="^.shadow:not(:disabled)">
            <Setter Property="BoxShadow" Value="{DynamicResource One.InfoCard.Shadow}" />
        </Style>
        <Style Selector="^.hove:pointerover:not(:disabled)">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Accent}" />
            <Setter Property="Background" Value="{DynamicResource One.SurfaceHover}" />
            <Setter Property="BoxShadow" Value="{DynamicResource One.InfoCard.HoverShadow}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
