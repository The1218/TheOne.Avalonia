<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="one:LoadingContainer" x:Key="{x:Type one:LoadingContainer}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="OverlayBrush" Value="{DynamicResource One.Surface}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_ContentPresenter"
                        Padding="{TemplateBinding Padding}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <Border
                        Background="Transparent"
                        BorderBrush="{DynamicResource One.Line}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        IsVisible="{TemplateBinding IsLoading}"
                        Name="PART_LoadingOverlay">
                        <Grid>
                            <Border
                                Background="{TemplateBinding OverlayBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Name="PART_OverlayBackground"
                                Opacity="{TemplateBinding OverlayOpacity}" />
                            <Border
                                Background="{DynamicResource One.Surface}"
                                BorderBrush="{DynamicResource One.Line}"
                                BorderThickness="1"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Center"
                                Margin="12"
                                Name="PART_LoadingStatus"
                                Padding="16"
                                VerticalAlignment="Center">
                                <StackPanel Spacing="12">
                                    <one:LoadingIndicator
                                        Foreground="{DynamicResource One.Accent}"
                                        Height="{CompiledBinding #PART_ContentPresenter.((one:LoadingContainer)TemplatedParent).LoadingIconSize}"
                                        IsActive="{TemplateBinding ShowDefaultLoadingIndicator}"
                                        IsVisible="{TemplateBinding ShowDefaultLoadingIndicator}"
                                        Name="PART_LoadingIndicator"
                                        Width="{CompiledBinding #PART_ContentPresenter.((one:LoadingContainer)TemplatedParent).LoadingIconSize}" />
                                    <ContentPresenter
                                        Content="{TemplateBinding LoadingIcon}"
                                        ContentTemplate="{TemplateBinding LoadingIconTemplate}"
                                        Foreground="{DynamicResource One.Accent}"
                                        Height="{TemplateBinding LoadingIconSize}"
                                        HorizontalContentAlignment="Stretch"
                                        IsVisible="{TemplateBinding HasCustomLoadingIcon}"
                                        Name="PART_LoadingIconPresenter"
                                        VerticalContentAlignment="Stretch"
                                        Width="{TemplateBinding LoadingIconSize}">
                                        <ContentPresenter.DataTemplates>
                                            <DataTemplate DataType="{x:Type Geometry}" x:DataType="Geometry">
                                                <PathIcon
                                                    Data="{CompiledBinding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch" />
                                            </DataTemplate>
                                        </ContentPresenter.DataTemplates>
                                    </ContentPresenter>
                                    <Border IsVisible="{TemplateBinding HasLoadingText}">
                                        <TextBlock
                                            AutomationProperties.LiveSetting="Polite"
                                            Foreground="{DynamicResource One.Text}"
                                            HorizontalAlignment="Center"
                                            Name="PART_LoadingText"
                                            Text="{TemplateBinding LoadingText}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:loading /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="LoadingIconSize" Value="22" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="LoadingIconSize" Value="34" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
