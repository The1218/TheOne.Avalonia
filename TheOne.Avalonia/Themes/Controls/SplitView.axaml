<!--  Adapted from Avalonia 12.1.4 (MIT). See THIRD-PARTY-NOTICES.md.  -->
<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush Color="#26000000" x:Key="One.SplitView.Overlay" />

    <ControlTheme TargetType="SplitView" x:Key="{x:Type SplitView}">
        <Setter Property="OpenPaneLength" Value="{DynamicResource One.SplitView.OpenPaneLength}" />
        <Setter Property="CompactPaneLength" Value="{DynamicResource One.SplitView.CompactPaneLength}" />
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Control}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="PaneBackground" Value="{DynamicResource One.Subtle}" />

        <Style Selector="^:left">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Name="SplitViewSurface"
                            Padding="{TemplateBinding BorderThickness}">
                            <Grid Name="Container">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{CompiledBinding #Container.((SplitView)TemplatedParent).TemplateSettings.PaneColumnGridLength}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Panel
                                    Background="{TemplateBinding PaneBackground}"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Left"
                                    Name="PART_PaneRoot"
                                    ZIndex="100">
                                    <ContentPresenter
                                        Content="{TemplateBinding Pane}"
                                        ContentTemplate="{TemplateBinding PaneTemplate}"
                                        x:Name="PART_PanePresenter" />
                                    <Rectangle
                                        Fill="{DynamicResource One.Line}"
                                        HorizontalAlignment="Right"
                                        Name="HCPaneBorder"
                                        Width="1" />
                                </Panel>

                                <Panel Grid.Column="1" Name="ContentRoot">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        x:Name="PART_ContentPresenter" />
                                    <Border
                                        Background="Transparent"
                                        IsVisible="False"
                                        Name="LightDismissLayer" />
                                </Panel>

                            </Grid>
                        </Border>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Name="SplitViewOutline" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </Style>
            </Style>

            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Name="SplitViewSurface"
                            Padding="{TemplateBinding BorderThickness}">
                            <Grid Name="Container">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{CompiledBinding #Container.((SplitView)TemplatedParent).TemplateSettings.PaneColumnGridLength}" />
                                </Grid.ColumnDefinitions>

                                <Panel
                                    Background="{TemplateBinding PaneBackground}"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Right"
                                    Name="PART_PaneRoot"
                                    ZIndex="100">
                                    <ContentPresenter
                                        Content="{TemplateBinding Pane}"
                                        ContentTemplate="{TemplateBinding PaneTemplate}"
                                        x:Name="PART_PanePresenter" />
                                    <Rectangle
                                        Fill="{DynamicResource One.Line}"
                                        HorizontalAlignment="Left"
                                        Name="HCPaneBorder"
                                        Width="1" />
                                </Panel>

                                <Panel Grid.Column="0" Name="ContentRoot">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        x:Name="PART_ContentPresenter" />
                                    <Border
                                        Background="Transparent"
                                        IsVisible="False"
                                        Name="LightDismissLayer" />
                                </Panel>

                            </Grid>
                        </Border>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Name="SplitViewOutline" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </Style>
            </Style>

            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <!--  TOP placement  -->
        <Style Selector="^:top">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Name="SplitViewSurface"
                            Padding="{TemplateBinding BorderThickness}">
                            <Grid Name="Container">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="{CompiledBinding #Container.((SplitView)TemplatedParent).TemplateSettings.PaneRowGridLength}" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Panel
                                    Background="{TemplateBinding PaneBackground}"
                                    ClipToBounds="True"
                                    Name="PART_PaneRoot"
                                    VerticalAlignment="Top"
                                    ZIndex="100">
                                    <ContentPresenter
                                        Content="{TemplateBinding Pane}"
                                        ContentTemplate="{TemplateBinding PaneTemplate}"
                                        x:Name="PART_PanePresenter" />
                                    <Rectangle
                                        Fill="{DynamicResource One.Line}"
                                        Height="1"
                                        Name="HCPaneBorder"
                                        VerticalAlignment="Bottom" />
                                </Panel>

                                <Panel Grid.Row="1" Name="ContentRoot">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        x:Name="PART_ContentPresenter" />
                                    <Border
                                        Background="Transparent"
                                        IsVisible="False"
                                        Name="LightDismissLayer" />
                                </Panel>

                            </Grid>
                        </Border>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Name="SplitViewOutline" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                </Style>
            </Style>

            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <!--  BOTTOM placement  -->
        <Style Selector="^:bottom">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Name="SplitViewSurface"
                            Padding="{TemplateBinding BorderThickness}">
                            <Grid Name="Container">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="{CompiledBinding #Container.((SplitView)TemplatedParent).TemplateSettings.PaneRowGridLength}" />
                                </Grid.RowDefinitions>

                                <Panel
                                    Background="{TemplateBinding PaneBackground}"
                                    ClipToBounds="True"
                                    Name="PART_PaneRoot"
                                    VerticalAlignment="Bottom"
                                    ZIndex="100">
                                    <ContentPresenter
                                        Content="{TemplateBinding Pane}"
                                        ContentTemplate="{TemplateBinding PaneTemplate}"
                                        x:Name="PART_PanePresenter" />
                                    <Rectangle
                                        Fill="{DynamicResource One.Line}"
                                        Height="1"
                                        Name="HCPaneBorder"
                                        VerticalAlignment="Top" />
                                </Panel>

                                <Panel Grid.Row="0" Name="ContentRoot">
                                    <ContentPresenter
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        x:Name="PART_ContentPresenter" />
                                    <Border
                                        Background="Transparent"
                                        IsVisible="False"
                                        Name="LightDismissLayer" />
                                </Panel>

                            </Grid>
                        </Border>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Name="SplitViewOutline" />
                    </Panel>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="2" />
                </Style>
            </Style>

            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="2" />
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>

            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.RowSpan" Value="1" />
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Height" Value="{CompiledBinding $self.((SplitView)TemplatedParent)?.TemplateSettings?.ClosedPaneHeight}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Row" Value="0" />
                    <Setter Property="Grid.RowSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:left /template/ ContentPresenter#PART_PanePresenter, ^:right /template/ ContentPresenter#PART_PanePresenter">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Width" Value="{CompiledBinding $parent[SplitView].OpenPaneLength}" />
        </Style>

        <!--
            Native TemplateSettings reserve inline space. Width/height changes are immediate
            so rapid toggles cannot leave an animated pane overlapping its new content track.
        -->
        <Style Selector="^:left:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{CompiledBinding $parent[SplitView].OpenPaneLength}" />
        </Style>
        <Style Selector="^:right:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{CompiledBinding $parent[SplitView].OpenPaneLength}" />
        </Style>

        <Style Selector="^:left:closed /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{CompiledBinding $parent[SplitView].TemplateSettings.ClosedPaneWidth}" />
        </Style>
        <Style Selector="^:right:closed /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{CompiledBinding $parent[SplitView].TemplateSettings.ClosedPaneWidth}" />
        </Style>

        <!--  Vertical pane sizing follows the same native layout contract.  -->
        <Style Selector="^:top:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{CompiledBinding $parent[SplitView].OpenPaneLength}" />
        </Style>

        <Style Selector="^:bottom:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{CompiledBinding $parent[SplitView].OpenPaneLength}" />
        </Style>

        <Style Selector="^:top:closed /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{CompiledBinding $parent[SplitView].TemplateSettings.ClosedPaneHeight}" />
        </Style>

        <Style Selector="^:bottom:closed /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{CompiledBinding $parent[SplitView].TemplateSettings.ClosedPaneHeight}" />
        </Style>

        <Style Selector="^:lightDismiss /template/ Border#LightDismissLayer">
            <Setter Property="Background" Value="{DynamicResource One.SplitView.Overlay}" />
        </Style>
        <Style Selector="^:overlay:open /template/ Border#LightDismissLayer">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:compactoverlay:open /template/ Border#LightDismissLayer">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
