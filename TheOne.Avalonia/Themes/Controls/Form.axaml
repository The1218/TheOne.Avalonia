<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="one:FormItem" x:Key="{x:Type one:FormItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel LastChildFill="True">
                    <StackPanel
                        DockPanel.Dock="{TemplateBinding LabelDock}"
                        IsVisible="{TemplateBinding HasLabel}"
                        Margin="0,0,8,6"
                        Width="{TemplateBinding EffectiveLabelWidth}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock
                                AutomationProperties.AccessibilityView="Raw"
                                Foreground="{DynamicResource One.Danger}"
                                IsVisible="{TemplateBinding IsRequired}"
                                Margin="0,0,4,0"
                                Text="*"
                                VerticalAlignment="Center" />
                            <Label
                                Content="{TemplateBinding Label}"
                                Grid.Column="1"
                                Name="PART_Label"
                                Padding="0"
                                VerticalContentAlignment="Center">
                                <Label.ContentTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{CompiledBinding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Label.ContentTemplate>
                            </Label>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Name="PART_ContentPresenter" />
                        <TextBlock
                            Foreground="{DynamicResource One.Muted}"
                            IsVisible="{TemplateBinding HasHelpText}"
                            Name="PART_HelpText"
                            Text="{TemplateBinding HelpText}"
                            TextWrapping="Wrap" />
                        <ItemsControl
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{DynamicResource One.Danger}"
                            IsVisible="{TemplateBinding HasErrors}"
                            ItemsSource="{TemplateBinding Errors}"
                            Name="PART_FieldErrors">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="one:StepValidationError">
                                    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="one:Form" x:Key="{x:Type one:Form}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <Border
                        Background="{DynamicResource One.DangerSoft}"
                        CornerRadius="6"
                        IsVisible="{TemplateBinding HasUnmappedErrors}"
                        Margin="0,0,0,12"
                        Name="PART_ErrorSummary"
                        Padding="10">
                        <ItemsControl
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{DynamicResource One.Danger}"
                            ItemsSource="{TemplateBinding UnmappedErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="one:StepValidationError">
                                    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Grid.Row="1"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_ContentPresenter"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[ShowErrorSummary=False] /template/ Border#PART_ErrorSummary">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:busy /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
