<!--  Adapted from Avalonia 12.1.4 (MIT). See THIRD-PARTY-NOTICES.md.  -->
<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Thickness x:Key="One.SliderTopHeaderMargin">0,0,0,4</Thickness>
    <GridLength x:Key="One.SliderPreContentMargin">15</GridLength>
    <GridLength x:Key="One.SliderPostContentMargin">15</GridLength>
    <x:Double x:Key="One.SliderHorizontalHeight">32</x:Double>
    <x:Double x:Key="One.SliderVerticalWidth">32</x:Double>
    <CornerRadius x:Key="One.SliderThumbCornerRadius">10</CornerRadius>
    <x:Double x:Key="One.SliderHorizontalThumbWidth">20</x:Double>
    <x:Double x:Key="One.SliderHorizontalThumbHeight">20</x:Double>
    <x:Double x:Key="One.SliderVerticalThumbWidth">20</x:Double>
    <x:Double x:Key="One.SliderVerticalThumbHeight">20</x:Double>

    <ControlTheme TargetType="RepeatButton" x:Key="One.SliderHorizontalRepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border
                        Background="Transparent"
                        Margin="0,-10"
                        Name="FocusTarget" />
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Height="{DynamicResource SliderTrackThemeHeight}"
                        Name="TrackBackground"
                        VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="RepeatButton" x:Key="One.SliderVerticalRepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border
                        Background="Transparent"
                        Margin="0,-10"
                        Name="FocusTarget" />
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        HorizontalAlignment="Center"
                        Name="TrackBackground"
                        Width="{DynamicResource SliderTrackThemeHeight}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="Thumb" x:Key="One.SliderThumbTheme">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource One.SliderThumbCornerRadius}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme TargetType="Slider" x:Key="{x:Type Slider}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Background" Value="{DynamicResource One.Line}" />
        <Setter Property="BorderThickness" Value="{DynamicResource SliderBorderThemeThickness}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid
                                Background="{DynamicResource One.Transparent}"
                                Margin="{TemplateBinding Padding}"
                                x:Name="SliderContainer">
                                <Grid.Styles>
                                    <Style Selector="TickBar">
                                        <Setter Property="ReservedSpace" Value="{CompiledBinding #PART_Track.Thumb.Bounds}" />
                                    </Style>
                                </Grid.Styles>
                                <Grid
                                    ColumnDefinitions="Auto,Auto,*"
                                    MinHeight="{TemplateBinding MinHeight}"
                                    x:Name="HorizontalTemplate">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TickBar
                                        Fill="{DynamicResource One.Muted}"
                                        Grid.ColumnSpan="3"
                                        Height="{DynamicResource SliderOutsideTickBarThemeHeight}"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        IsVisible="False"
                                        Margin="0,0,0,4"
                                        Maximum="{TemplateBinding Slider.Maximum}"
                                        Minimum="{TemplateBinding Slider.Minimum}"
                                        Name="TopTickBar"
                                        Orientation="{TemplateBinding Slider.Orientation}"
                                        Placement="Top"
                                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                        Ticks="{TemplateBinding Ticks}"
                                        VerticalAlignment="Bottom" />
                                    <TickBar
                                        Fill="{DynamicResource One.Muted}"
                                        Grid.ColumnSpan="3"
                                        Grid.Row="2"
                                        Height="{DynamicResource SliderOutsideTickBarThemeHeight}"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        IsVisible="False"
                                        Margin="0,4,0,0"
                                        Maximum="{TemplateBinding Slider.Maximum}"
                                        Minimum="{TemplateBinding Slider.Minimum}"
                                        Name="BottomTickBar"
                                        Orientation="{TemplateBinding Slider.Orientation}"
                                        Placement="Bottom"
                                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                        Ticks="{TemplateBinding Ticks}"
                                        VerticalAlignment="Top" />
                                    <Track
                                        Grid.ColumnSpan="3"
                                        Grid.Row="1"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Name="PART_Track"
                                        Orientation="Horizontal"
                                        Value="{TemplateBinding Value,
                                                                Mode=TwoWay}">
                                        <Track.DecreaseButton>
                                            <RepeatButton
                                                Background="{TemplateBinding Foreground}"
                                                Focusable="False"
                                                Name="PART_DecreaseButton"
                                                Theme="{StaticResource One.SliderHorizontalRepeatButton}" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton
                                                Background="{TemplateBinding Background}"
                                                Focusable="False"
                                                Name="PART_IncreaseButton"
                                                Theme="{StaticResource One.SliderHorizontalRepeatButton}" />
                                        </Track.IncreaseButton>
                                        <Thumb
                                            Background="{DynamicResource One.Accent}"
                                            BorderThickness="0"
                                            DataContext="{TemplateBinding Value}"
                                            Height="{DynamicResource One.SliderHorizontalThumbHeight}"
                                            Margin="0"
                                            Name="thumb"
                                            Padding="0"
                                            Theme="{StaticResource One.SliderThumbTheme}"
                                            Width="{DynamicResource One.SliderHorizontalThumbWidth}" />
                                    </Track>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid
                                Background="{DynamicResource One.Transparent}"
                                Margin="{TemplateBinding Padding}"
                                x:Name="SliderContainer">
                                <Grid.Styles>
                                    <Style Selector="TickBar">
                                        <Setter Property="ReservedSpace" Value="{CompiledBinding #PART_Track.Thumb.Bounds}" />
                                    </Style>
                                </Grid.Styles>
                                <Grid
                                    MinWidth="{TemplateBinding MinWidth}"
                                    RowDefinitions="*,Auto,Auto"
                                    x:Name="VerticalTemplate">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TickBar
                                        Fill="{DynamicResource One.Muted}"
                                        Grid.RowSpan="3"
                                        HorizontalAlignment="Right"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        IsVisible="False"
                                        Margin="0,0,4,0"
                                        Maximum="{TemplateBinding Slider.Maximum}"
                                        Minimum="{TemplateBinding Slider.Minimum}"
                                        Name="LeftTickBar"
                                        Orientation="{TemplateBinding Slider.Orientation}"
                                        Placement="Left"
                                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                        Ticks="{TemplateBinding Ticks}"
                                        Width="{DynamicResource SliderOutsideTickBarThemeHeight}" />
                                    <TickBar
                                        Fill="{DynamicResource One.Muted}"
                                        Grid.Column="2"
                                        Grid.RowSpan="3"
                                        HorizontalAlignment="Left"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        IsVisible="False"
                                        Margin="4,0,0,0"
                                        Maximum="{TemplateBinding Slider.Maximum}"
                                        Minimum="{TemplateBinding Slider.Minimum}"
                                        Name="RightTickBar"
                                        Orientation="{TemplateBinding Slider.Orientation}"
                                        Placement="Right"
                                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                        Ticks="{TemplateBinding Ticks}"
                                        Width="{DynamicResource SliderOutsideTickBarThemeHeight}" />
                                    <Track
                                        Grid.Column="1"
                                        Grid.RowSpan="3"
                                        IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Name="PART_Track"
                                        Orientation="Vertical"
                                        Value="{TemplateBinding Value,
                                                                Mode=TwoWay}">
                                        <Track.DecreaseButton>
                                            <RepeatButton
                                                Background="{TemplateBinding Foreground}"
                                                Focusable="False"
                                                Name="PART_DecreaseButton"
                                                Theme="{StaticResource One.SliderVerticalRepeatButton}" />
                                        </Track.DecreaseButton>
                                        <Track.IncreaseButton>
                                            <RepeatButton
                                                Background="{TemplateBinding Background}"
                                                Focusable="False"
                                                Name="PART_IncreaseButton"
                                                Theme="{StaticResource One.SliderVerticalRepeatButton}" />
                                        </Track.IncreaseButton>
                                        <Thumb
                                            Background="{DynamicResource One.Accent}"
                                            BorderThickness="0"
                                            DataContext="{TemplateBinding Value}"
                                            Height="{DynamicResource One.SliderVerticalThumbHeight}"
                                            Margin="0"
                                            Name="SliderThumb"
                                            Padding="0"
                                            Theme="{StaticResource One.SliderThumbTheme}"
                                            Width="{DynamicResource One.SliderVerticalThumbWidth}" />
                                    </Track>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  TickBar Placement States  -->

        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!--  PointerOver State  -->
        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.InputLine}" />
            </Style>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource One.AccentHover}" />
            </Style>


            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.AccentHover}" />
            </Style>

        </Style>

        <!--  Pressed State  -->
        <Style Selector="^:pressed">
            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.AccentPressed}" />
            </Style>
            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.NeutralPressed}" />
            </Style>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource One.Accent}" />
            </Style>
        </Style>

        <!--  Disabled State  -->
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            </Style>

            <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
                <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            </Style>

            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource One.DisabledText}" />
            </Style>

            <Style Selector="^ /template/ TickBar">
                <Setter Property="Fill" Value="{DynamicResource One.DisabledSurface}" />
            </Style>
        </Style>

        <Style Selector="^:error">
            <Setter Property="Foreground" Value="{DynamicResource One.Danger}" />
            <Style Selector="^ /template/ Thumb">
                <Setter Property="Background" Value="{DynamicResource One.Danger}" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
