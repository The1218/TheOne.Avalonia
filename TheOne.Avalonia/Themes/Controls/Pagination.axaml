<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button"
        x:Key="One.PaginationButton">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        <Setter Property="CornerRadius" Value="6" />
    </ControlTheme>
    <ControlTheme TargetType="ItemsControl" x:Key="One.PaginationPages">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Name="PART_ItemsPresenter" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="one:Pagination" x:Key="{x:Type one:Pagination}">
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="10">
                        <StackPanel.Styles>
                            <Style Selector="Button.pagination-navigation">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="{CompiledBinding $parent[one:Pagination].ItemHeight}" />
                            </Style>
                            <Style Selector="Button.pagination-action">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="MinHeight" Value="{CompiledBinding $parent[one:Pagination].ItemHeight}" />
                            </Style>
                            <Style Selector="ComboBox.pagination-size">
                                <Setter Property="Padding" Value="10,0,6,0" />
                                <Setter Property="MinHeight" Value="{CompiledBinding $parent[one:Pagination].ItemHeight}" />
                            </Style>
                            <Style Selector="TextBox.pagination-input">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="{CompiledBinding $parent[one:Pagination].ItemHeight}" />
                            </Style>
                        </StackPanel.Styles>
                        <one:PaginationPanel IsCompact="{TemplateBinding IsCompact}" Name="PART_Layout">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12"
                                IsVisible="{TemplateBinding HasSummary}"
                                Name="PART_Summary">
                                <TextBlock
                                    IsVisible="{TemplateBinding ShowTotal}"
                                    Name="PART_Total"
                                    Text="{TemplateBinding TotalText}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    AutomationProperties.Name="每页条数"
                                    Background="{DynamicResource One.Surface}"
                                    BorderBrush="{DynamicResource One.Line}"
                                    Classes="pagination-size"
                                    Grid.Column="1"
                                    IsVisible="{TemplateBinding ShowPageSizeSelector}"
                                    ItemsSource="{TemplateBinding PageSizes}"
                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                    MinWidth="112"
                                    Name="PART_PageSizes"
                                    Padding="10,0,6,0"
                                    VerticalAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="one:PaginationPageSize">
                                            <TextBlock Text="{CompiledBinding Text}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <Grid
                                ColumnDefinitions="Auto,*,Auto"
                                ColumnSpacing="6"
                                Name="PART_Navigation">
                                <Button
                                    AutomationProperties.Name="{TemplateBinding PreviousText}"
                                    Classes="pagination-navigation"
                                    IsEnabled="{TemplateBinding CanGoPrevious}"
                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                    MinWidth="{TemplateBinding ItemHeight}"
                                    Name="PART_PreviousButton"
                                    Padding="8,0"
                                    Theme="{StaticResource One.PaginationButton}">
                                    <Grid>
                                        <PathIcon
                                            Data="M 11,2 L 5,8 L 11,14 L 9,14 L 3,8 L 9,2 Z"
                                            Height="14"
                                            Name="PART_PreviousIcon"
                                            Width="14" />
                                        <TextBlock
                                            IsVisible="False"
                                            Margin="4,0"
                                            Name="PART_PreviousText"
                                            Text="{TemplateBinding PreviousText}" />
                                    </Grid>
                                </Button>
                                <ItemsControl
                                    AutomationProperties.Name="页码导航"
                                    Grid.Column="1"
                                    ItemsSource="{TemplateBinding PageItems}"
                                    Name="PART_Pages"
                                    Theme="{StaticResource One.PaginationPages}"
                                    VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="one:PaginationPageItem">
                                            <Grid>
                                                <Button
                                                    AutomationProperties.Name="{CompiledBinding AccessibleName}"
                                                    Classes.primary="{CompiledBinding IsCurrent}"
                                                    Content="{CompiledBinding Text}"
                                                    IsVisible="{CompiledBinding IsPage}"
                                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                                    MinWidth="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                                    Padding="6,0"
                                                    Theme="{StaticResource One.PaginationButton}" />
                                                <TextBlock
                                                    IsHitTestVisible="False"
                                                    IsVisible="{CompiledBinding IsEllipsis}"
                                                    Margin="6,0"
                                                    Text="…"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Grid.Column="1"
                                    IsVisible="False"
                                    Name="PART_CurrentPage"
                                    Text="{TemplateBinding CurrentPageText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <Button
                                    AutomationProperties.Name="{TemplateBinding NextText}"
                                    Classes="pagination-navigation"
                                    Grid.Column="2"
                                    IsEnabled="{TemplateBinding CanGoNext}"
                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                    MinWidth="{TemplateBinding ItemHeight}"
                                    Name="PART_NextButton"
                                    Padding="8,0"
                                    Theme="{StaticResource One.PaginationButton}">
                                    <Grid>
                                        <PathIcon
                                            Data="M 3,2 L 9,8 L 3,14 L 5,14 L 11,8 L 5,2 Z"
                                            Height="14"
                                            Name="PART_NextIcon"
                                            Width="14" />
                                        <TextBlock
                                            IsVisible="False"
                                            Margin="4,0"
                                            Name="PART_NextText"
                                            Text="{TemplateBinding NextText}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <StackPanel
                                IsEnabled="{TemplateBinding HasPages}"
                                IsVisible="{TemplateBinding ShowJump}"
                                Name="PART_Jump"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Text="{TemplateBinding JumpPrefixText}" VerticalAlignment="Center" />
                                <TextBox
                                    AutomationProperties.Name="跳转页码"
                                    Background="{DynamicResource One.Surface}"
                                    BorderBrush="{DynamicResource One.Line}"
                                    Classes="pagination-input"
                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                    Name="PART_JumpInput"
                                    Padding="8,0"
                                    TextAlignment="Center"
                                    Width="64" />
                                <TextBlock Text="{TemplateBinding PageUnitText}" VerticalAlignment="Center" />
                                <Button
                                    Classes="pagination-action"
                                    Content="{TemplateBinding JumpText}"
                                    MinHeight="{CompiledBinding $parent[one:Pagination].ItemHeight}"
                                    Name="PART_JumpButton"
                                    Padding="12,0"
                                    Theme="{StaticResource One.PaginationButton}" />
                            </StackPanel>
                        </one:PaginationPanel>
                        <TextBlock
                            Foreground="{DynamicResource One.Muted}"
                            IsVisible="{TemplateBinding ShowRange}"
                            Name="PART_Range"
                            Text="{TemplateBinding RangeText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{DynamicResource One.Danger}"
                            IsVisible="{TemplateBinding HasJumpError}"
                            Name="PART_JumpError"
                            Text="{TemplateBinding JumpError}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:compact /template/ ItemsControl#PART_Pages, ^:compact /template/ PathIcon#PART_PreviousIcon, ^:compact /template/ PathIcon#PART_NextIcon, ^:compact /template/ StackPanel#PART_Jump, ^:compact /template/ TextBlock#PART_Range">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:compact /template/ TextBlock#PART_CurrentPage, ^:compact /template/ TextBlock#PART_PreviousText, ^:compact /template/ TextBlock#PART_NextText">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:invalid-jump /template/ TextBox#PART_JumpInput">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Danger}" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ItemHeight" Value="30" />
        </Style>
        <Style Selector="^.one-normal">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ItemHeight" Value="36" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="ItemHeight" Value="44" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
