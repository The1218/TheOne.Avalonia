<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="One.CalendarBodyHeight.Small">258</x:Double>
    <x:Double x:Key="One.CalendarBodyHeight.Normal">294</x:Double>
    <x:Double x:Key="One.CalendarBodyHeight.Large">342</x:Double>

    <ControlTheme
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button"
        x:Key="One.CalendarNavigation">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="MinHeight" Value="36" />
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource One.NeutralHover}" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="CalendarItem" x:Key="{x:Type CalendarItem}">
        <Setter Property="DayTitleTemplate">
            <Template>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource One.Muted}"
                    HorizontalAlignment="Center"
                    Text="{CompiledBinding}"
                    VerticalAlignment="Center"
                    x:DataType="x:Object" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Margin="0" RowDefinitions="Auto,Auto">
                    <Grid ColumnDefinitions="*,40,40" Margin="2,0,2,6">
                        <Button
                            FontWeight="SemiBold"
                            HorizontalContentAlignment="Left"
                            Name="PART_HeaderButton"
                            Padding="10,4"
                            Theme="{StaticResource One.CalendarNavigation}" />
                        <Button
                            AutomationProperties.Name="上一页"
                            Grid.Column="1"
                            Name="PART_PreviousButton"
                            Padding="12"
                            Theme="{StaticResource One.CalendarNavigation}">
                            <PathIcon
                                Data="M 8,0 L 0,6 L 8,12 L 6.5,12 L 0,6 L 6.5,0 Z"
                                Height="12"
                                Width="8" />
                        </Button>
                        <Button
                            AutomationProperties.Name="下一页"
                            Grid.Column="2"
                            Name="PART_NextButton"
                            Padding="12"
                            Theme="{StaticResource One.CalendarNavigation}">
                            <PathIcon
                                Data="M 0,0 L 8,6 L 0,12 L 1.5,12 L 8,6 L 1.5,0 Z"
                                Height="12"
                                Width="8" />
                        </Button>
                    </Grid>
                    <Grid
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                        Grid.Row="1"
                        Height="{DynamicResource One.CalendarBodyHeight.Normal}"
                        HorizontalAlignment="Center"
                        IsVisible="False"
                        Name="PART_MonthView"
                        RowDefinitions="30,Auto,Auto,Auto,Auto,Auto,Auto" />
                    <Grid
                        ColumnDefinitions="*,*,*,*"
                        Grid.Row="1"
                        Height="{DynamicResource One.CalendarBodyHeight.Normal}"
                        IsVisible="False"
                        Name="PART_YearView"
                        RowDefinitions="*,*,*" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.one-small /template/ Grid#PART_MonthView, ^.one-small /template/ Grid#PART_YearView">
            <Setter Property="Height" Value="{DynamicResource One.CalendarBodyHeight.Small}" />
        </Style>
        <Style Selector="^.one-large /template/ Grid#PART_MonthView, ^.one-large /template/ Grid#PART_YearView">
            <Setter Property="Height" Value="{DynamicResource One.CalendarBodyHeight.Large}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
