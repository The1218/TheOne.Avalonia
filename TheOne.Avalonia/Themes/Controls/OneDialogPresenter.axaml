<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="one:OneDialogPresenter" x:Key="{x:Type one:OneDialogPresenter}">
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.OutlineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Popup}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12"
                            IsVisible="False"
                            Margin="0,0,0,20"
                            Name="PART_Header">
                            <ContentPresenter
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontSize="18"
                                FontWeight="SemiBold"
                                IsVisible="{TemplateBinding ShowTitle}"
                                Name="PART_HeaderPresenter"
                                VerticalAlignment="Center" />
                            <Button
                                AutomationProperties.Name="关闭对话框"
                                Classes="ghost"
                                Grid.Column="1"
                                IsVisible="{TemplateBinding ShowCloseButton}"
                                MinHeight="0"
                                MinWidth="0"
                                Name="PART_CloseButton"
                                Padding="8"
                                ToolTip.Tip="关闭对话框">
                                <PathIcon
                                    Data="M1,0 L6,5 L11,0 L12,1 L7,6 L12,11 L11,12 L6,7 L1,12 L0,11 L5,6 L0,1 Z"
                                    Height="12"
                                    Width="12" />
                            </Button>
                        </Grid>
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Disabled"
                            MaxHeight="480">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Name="PART_ContentPresenter"
                                TextBlock.TextWrapping="Wrap" />
                        </ScrollViewer>
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding ShowButtons}"
                            Margin="0,20,0,0"
                            Name="PART_Buttons"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Content="取消"
                                IsVisible="False"
                                Name="PART_CancelButton" />
                            <Button
                                Content="否"
                                IsVisible="False"
                                Name="PART_NoButton" />
                            <Button
                                Classes="primary"
                                Content="确定"
                                Name="PART_PrimaryButton" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:header /template/ Grid#PART_Header">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:yesno /template/ Button#PART_NoButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:yesno /template/ Button#PART_PrimaryButton">
            <Setter Property="Content" Value="是" />
        </Style>
        <Style Selector="^:cancel /template/ Button#PART_CancelButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>