<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Styling"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <x:Double x:Key="One.DatePickerFlyoutPresenterHighlightHeight">40</x:Double>
    <x:Double x:Key="One.DatePickerFlyoutPresenterItemHeight">40</x:Double>
    <x:Double x:Key="One.DatePickerFlyoutPresenterAcceptDismissHostGridHeight">41</x:Double>
    <x:Double x:Key="One.DatePickerThemeMinWidth">296</x:Double>
    <x:Double x:Key="One.DatePickerThemeMaxWidth">456</x:Double>
    <Thickness x:Key="One.DatePickerFlyoutPresenterItemPadding">0,3,0,6</Thickness>
    <Thickness x:Key="One.DatePickerFlyoutPresenterMonthPadding">9,3,0,6</Thickness>
    <Thickness x:Key="One.DatePickerHostPadding">0</Thickness>
    <Thickness x:Key="One.DatePickerHostMonthPadding">0</Thickness>
    <x:Double x:Key="One.DatePickerSpacerThemeWidth">1</x:Double>

    <ControlTheme TargetType="Button" x:Key="One.DatePickerFlyoutButton">
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Foreground="{TemplateBinding Foreground}"
                    HorizontalContentAlignment="Stretch"
                    Name="PART_ContentPresenter"
                    VerticalContentAlignment="Stretch" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource One.NeutralPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        </Style>

        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="DatePicker" x:Key="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.InputLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="{DynamicResource One.DatePickerThemeMinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource One.DatePickerThemeMaxWidth}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Grid Margin="{TemplateBinding Padding}" Name="LayoutRoot">
                        <Button
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Classes="one-picker-button"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{TemplateBinding IsEnabled}"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MinWidth="{TemplateBinding MinWidth}"
                            Name="PART_FlyoutButton"
                            TemplatedControl.IsTemplateFocusTarget="True"
                            Theme="{StaticResource One.DatePickerFlyoutButton}"
                            VerticalAlignment="Stretch">
                            <Grid ColumnDefinitions="78*,Auto,132*,Auto,78*" Name="PART_ButtonContentGrid">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Name="PART_DayTextBlock"
                                    Padding="{DynamicResource One.DatePickerHostPadding}"
                                    Text="{DynamicResource StringDatePickerDayText}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Name="PART_MonthTextBlock"
                                    Padding="{DynamicResource One.DatePickerHostMonthPadding}"
                                    Text="{DynamicResource StringDatePickerMonthText}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Name="PART_YearTextBlock"
                                    Padding="{DynamicResource One.DatePickerHostPadding}"
                                    Text="{DynamicResource StringDatePickerYearText}" />
                                <Rectangle
                                    Fill="{DynamicResource One.Surface}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    Width="1"
                                    x:Name="PART_FirstSpacer" />
                                <Rectangle
                                    Fill="{DynamicResource One.Surface}"
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    Width="1"
                                    x:Name="PART_SecondSpacer" />
                            </Grid>
                        </Button>

                        <Popup
                            IsLightDismissEnabled="True"
                            Name="PART_Popup"
                            Placement="Bottom"
                            PlacementTarget="{TemplateBinding}"
                            WindowManagerAddShadowHint="False">
                            <DatePickerPresenter Name="PART_PickerPresenter" />
                        </Popup>

                    </Grid>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled /template/ Rectangle">
            <Setter Property="Fill" Value="{DynamicResource One.DisabledSurface}" />
        </Style>

        <Style Selector="^ /template/ Button#PART_FlyoutButton TextBlock">
            <Setter Property="VerticalAlignment" Value="{TemplateBinding VerticalContentAlignment}" />
        </Style>

        <!--  Changes foreground for watermark text when SelectedDate is null  -->
        <Style Selector="^:hasnodate /template/ Button#PART_FlyoutButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        </Style>

        <Style Selector="^:error /template/ Button#PART_FlyoutButton">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Danger}" />
        </Style>
    </ControlTheme>

    <!--  WinUI: DatePickerFlyoutPresenter  -->
    <ControlTheme TargetType="DatePickerPresenter" x:Key="{x:Type DatePickerPresenter}">
        <Setter Property="Width" Value="296" />
        <Setter Property="MinWidth" Value="296" />
        <Setter Property="MaxHeight" Value="{Binding $self.(one:PickerSizing.PopupHeight)}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.OutlineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Popup}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        MaxHeight="{TemplateBinding MaxHeight}"
                        Name="Background"
                        Padding="4">
                        <Grid Name="ContentRoot" RowDefinitions="*,Auto">
                            <Grid Name="PART_PickerContainer">
                                <Grid.Styles>
                                    <Style Selector="DateTimePickerPanel">
                                        <Setter Property="one:PickerScroll.Enabled" Value="True" />
                                    </Style>
                                    <Style Selector="DateTimePickerPanel &gt; ListBoxItem">
                                        <Setter Property="Theme" Value="{StaticResource One.DateTimePickerItem}" />
                                    </Style>
                                </Grid.Styles>
                                <!--  Column Definitions set in code, ignore here  -->
                                <Grid Name="PART_MonthHost" RowDefinitions="Auto,*,Auto">
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        MaxHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ViewportHeight)}"
                                        VerticalAlignment="Center"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            ItemHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ItemHeight)}"
                                            Name="PART_MonthSelector"
                                            PanelType="Month"
                                            ShouldLoop="True" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Grid.Row="0"
                                        Name="PART_MonthUpButton"
                                        Theme="{StaticResource One.DateTimePickerUpButton}" />
                                    <RepeatButton
                                        Grid.Row="2"
                                        Name="PART_MonthDownButton"
                                        Theme="{StaticResource One.DateTimePickerDownButton}" />
                                </Grid>
                                <Grid Name="PART_DayHost" RowDefinitions="Auto,*,Auto">
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        MaxHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ViewportHeight)}"
                                        VerticalAlignment="Center"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            ItemHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ItemHeight)}"
                                            Name="PART_DaySelector"
                                            PanelType="Day"
                                            ShouldLoop="True" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Grid.Row="0"
                                        Name="PART_DayUpButton"
                                        Theme="{StaticResource One.DateTimePickerUpButton}" />
                                    <RepeatButton
                                        Grid.Row="2"
                                        Name="PART_DayDownButton"
                                        Theme="{StaticResource One.DateTimePickerDownButton}" />
                                </Grid>
                                <Grid Name="PART_YearHost" RowDefinitions="Auto,*,Auto">
                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Disabled"
                                        MaxHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ViewportHeight)}"
                                        VerticalAlignment="Center"
                                        VerticalScrollBarVisibility="Hidden">
                                        <DateTimePickerPanel
                                            ItemHeight="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ItemHeight)}"
                                            Name="PART_YearSelector"
                                            PanelType="Year"
                                            ShouldLoop="False" />
                                    </ScrollViewer>
                                    <RepeatButton
                                        Grid.Row="0"
                                        Name="PART_YearUpButton"
                                        Theme="{StaticResource One.DateTimePickerUpButton}" />
                                    <RepeatButton
                                        Grid.Row="2"
                                        Name="PART_YearDownButton"
                                        Theme="{StaticResource One.DateTimePickerDownButton}" />
                                </Grid>
                                <Border
                                    Background="{DynamicResource One.Accent}"
                                    CornerRadius="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="5"
                                    Height="{Binding $parent[PickerPresenterBase].(one:PickerSizing.ItemHeight)}"
                                    IsHitTestVisible="False"
                                    Name="HighlightRect"
                                    VerticalAlignment="Center"
                                    ZIndex="-1" />
                                <Rectangle
                                    Fill="{DynamicResource One.Line}"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Name="PART_FirstSpacer"
                                    Opacity="0.5"
                                    Width="{DynamicResource One.DatePickerSpacerThemeWidth}" />
                                <Rectangle
                                    Fill="{DynamicResource One.Line}"
                                    Grid.Column="3"
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Name="PART_SecondSpacer"
                                    Opacity="0.5"
                                    Width="{DynamicResource One.DatePickerSpacerThemeWidth}" />
                            </Grid>

                            <Grid
                                ColumnDefinitions="*,*"
                                Grid.Row="1"
                                Name="AcceptDismissGrid">
                                <Rectangle
                                    Fill="{DynamicResource One.Line}"
                                    Grid.ColumnSpan="2"
                                    Height="{DynamicResource One.DatePickerSpacerThemeWidth}"
                                    VerticalAlignment="Top" />
                                <Button
                                    Grid.Column="0"
                                    Height="{DynamicResource One.DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                                    HorizontalAlignment="Stretch"
                                    Name="PART_AcceptButton"
                                    Theme="{StaticResource One.DateTimePickerButton}"
                                    VerticalAlignment="Stretch">
                                    <TextBlock Text="确定" />
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Height="{DynamicResource One.DatePickerFlyoutPresenterAcceptDismissHostGridHeight}"
                                    HorizontalAlignment="Stretch"
                                    Name="PART_DismissButton"
                                    Theme="{StaticResource One.DateTimePickerButton}"
                                    VerticalAlignment="Stretch">
                                    <TextBlock Text="取消" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        BorderBrush="{Binding #Background.BorderBrush}"
                        BorderThickness="{Binding #Background.BorderThickness}"
                        CornerRadius="{Binding #Background.CornerRadius}"
                        IsHitTestVisible="False"
                        Name="InputOutline" />
                </Panel>
            </ControlTemplate>
        </Setter>

    </ControlTheme>


</ResourceDictionary>