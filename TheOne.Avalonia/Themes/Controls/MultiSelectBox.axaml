<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button"
        x:Key="One.MultiSelectAction">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalContentAlignment="Center"
                    Name="PART_ContentPresenter"
                    Padding="{TemplateBinding Padding}"
                    VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="one:MultiSelectBox" x:Key="{x:Type one:MultiSelectBox}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.InputLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding ItemHeight}"
                    Name="PART_Input"
                    Padding="{TemplateBinding Padding}">
                    <Border.Styles>
                        <Style Selector="Button.one-small, Button.one-normal, Button.one-large">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                        <Style Selector="one|Tag.one-small, one|Tag.one-normal, one|Tag.one-large">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <Grid VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{DynamicResource One.Placeholder}"
                                IsVisible="{TemplateBinding HasSelection,
                                                            Converter={x:Static BoolConverters.Not}}"
                                Name="PART_Placeholder"
                                Text="{TemplateBinding PlaceholderText}"
                                TextTrimming="CharacterEllipsis" />
                            <DockPanel IsVisible="{TemplateBinding HasSelection}">
                                <TextBlock
                                    DockPanel.Dock="Right"
                                    IsVisible="{TemplateBinding HasHiddenSelection}"
                                    Margin="4,0"
                                    Text="{CompiledBinding $self.((one:MultiSelectBox)TemplatedParent)?.HiddenSelectedCount, StringFormat='+{0}'}"
                                    VerticalAlignment="Center" />
                                <ItemsControl
                                    ItemsSource="{TemplateBinding DisplayTags}"
                                    Name="PART_Tags"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Name="PART_ItemsPresenter" />
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="one:MultiSelectBoxItem">
                                            <one:Tag
                                                Background="{DynamicResource One.AccentSoft}"
                                                Foreground="{DynamicResource One.Text}"
                                                Margin="0,1,4,1"
                                                MaxWidth="160"
                                                MinHeight="0"
                                                Padding="4,0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <ContentControl
                                                        ClipToBounds="True"
                                                        Content="{CompiledBinding TagContent}"
                                                        ContentTemplate="{CompiledBinding TagTemplate}"
                                                        MaxWidth="116"
                                                        VerticalContentAlignment="Center" />
                                                    <Button
                                                        AutomationProperties.Name="{CompiledBinding RemoveLabel}"
                                                        CommandParameter="{CompiledBinding Item}"
                                                        Grid.Column="1"
                                                        Height="20"
                                                        IsEnabled="{CompiledBinding CanRemove}"
                                                        MinHeight="0"
                                                        MinWidth="0"
                                                        Padding="0"
                                                        Theme="{StaticResource One.MultiSelectAction}"
                                                        Width="20">
                                                        <PathIcon
                                                            Data="M 2,0 L 5,3 L 8,0 L 10,2 L 7,5 L 10,8 L 8,10 L 5,7 L 2,10 L 0,8 L 3,5 L 0,2 Z"
                                                            Height="10"
                                                            Width="10" />
                                                    </Button>
                                                </Grid>
                                            </one:Tag>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Grid>
                        <Button
                            AutomationProperties.Name="{TemplateBinding ClearText}"
                            Grid.Column="1"
                            Height="24"
                            IsVisible="{TemplateBinding CanClear}"
                            MinHeight="0"
                            MinWidth="0"
                            Name="PART_ClearButton"
                            Padding="0"
                            Theme="{StaticResource One.MultiSelectAction}"
                            VerticalAlignment="Center"
                            Width="24">
                            <PathIcon
                                Data="M 2,0 L 5,3 L 8,0 L 10,2 L 7,5 L 10,8 L 8,10 L 5,7 L 2,10 L 0,8 L 3,5 L 0,2 Z"
                                Height="10"
                                Width="10" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{TemplateBinding OpenText}"
                            Focusable="False"
                            Grid.Column="2"
                            Height="24"
                            MinHeight="0"
                            MinWidth="0"
                            Name="PART_OpenButton"
                            Padding="0"
                            Theme="{StaticResource One.MultiSelectAction}"
                            VerticalAlignment="Center"
                            Width="24">
                            <PathIcon
                                Data="M 0,0 L 6,6 L 12,0 L 14,2 L 6,10 L -2,2 Z"
                                Height="8"
                                Width="12" />
                        </Button>
                        <Popup
                            IsLightDismissEnabled="True"
                            Name="PART_Popup"
                            OverlayDismissEventPassThrough="True"
                            Placement="Bottom"
                            WindowManagerAddShadowHint="False">
                            <Border
                                Background="{DynamicResource One.Surface}"
                                BorderBrush="{DynamicResource One.Line}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6">
                                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                    <TextBox
                                        AutomationProperties.Name="{TemplateBinding SearchPlaceholderText}"
                                        Name="PART_SearchBox"
                                        PlaceholderText="{TemplateBinding SearchPlaceholderText}"
                                        Text="{TemplateBinding SearchText,
                                                               Mode=TwoWay}" />
                                    <ListBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Grid.Row="1"
                                        MinHeight="0"
                                        Name="PART_Results"
                                        Padding="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.IsScrollChainingEnabled="False"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        SelectionMode="Multiple,Toggle">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem.one-small, ListBoxItem.one-normal, ListBoxItem.one-large">
                                                <Setter Property="Padding" Value="8,2" />
                                            </Style>
                                            <Style Selector="CheckBox.one-small, CheckBox.one-normal, CheckBox.one-large">
                                                <Setter Property="MinHeight" Value="20" />
                                                <Setter Property="Padding" Value="8,0,0,0" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerTheme>
                                            <ControlTheme
                                                BasedOn="{StaticResource {x:Type ListBoxItem}}"
                                                TargetType="ListBoxItem"
                                                x:DataType="one:MultiSelectBoxItem">
                                                <Setter Property="IsEnabled" Value="{CompiledBinding IsEnabled}" />
                                                <Setter Property="Padding" Value="8,2" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </ControlTheme>
                                        </ListBox.ItemContainerTheme>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="one:MultiSelectBoxItem">
                                                <CheckBox
                                                    AutomationProperties.Name="{CompiledBinding Text}"
                                                    Content="{CompiledBinding DisplayContent}"
                                                    ContentTemplate="{CompiledBinding ContentTemplate}"
                                                    Focusable="False"
                                                    IsChecked="{CompiledBinding IsSelected, Mode=OneWay}"
                                                    IsHitTestVisible="False"
                                                    MinHeight="20" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock
                                        Foreground="{DynamicResource One.Muted}"
                                        Grid.Row="1"
                                        IsVisible="{TemplateBinding HasNoResults}"
                                        Margin="8"
                                        Name="PART_Empty"
                                        Text="{TemplateBinding EmptyText}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ Border#PART_Input">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Input">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Input">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="^.one-normal">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="FontSize" Value="16" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
