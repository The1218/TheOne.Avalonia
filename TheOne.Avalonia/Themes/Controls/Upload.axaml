<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:DataType="one:Upload" x:Key="One.Upload.EmptyTemplate">
        <StackPanel
            HorizontalAlignment="Center"
            Margin="12,18"
            Spacing="10">
            <Border
                Background="{DynamicResource One.AccentSoft}"
                CornerRadius="12"
                Height="46"
                HorizontalAlignment="Center"
                Width="46">
                <PathIcon
                    Data="M11,2 L11,14 L13,14 L13,2 Z M6,7 L7.4,8.4 L12,3.8 L16.6,8.4 L18,7 L12,1 Z M3,14 L3,20 Q3,22 5,22 L19,22 Q21,22 21,20 L21,14 L19,14 L19,20 L5,20 L5,14 Z"
                    Foreground="{DynamicResource One.Accent}"
                    Height="23"
                    Width="23" />
            </Border>
            <TextBlock
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Text="{CompiledBinding Title}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{DynamicResource One.Muted}"
                HorizontalAlignment="Center"
                Text="{CompiledBinding Description}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                AutomationProperties.Name="选择上传图片"
                Classes="primary"
                Command="{CompiledBinding SelectCommand}"
                Content="{CompiledBinding SelectText}"
                HorizontalAlignment="Center"
                Name="PART_Select" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:DataType="one:Upload" x:Key="One.Upload.FileTemplate">
        <StackPanel Spacing="12">
            <Border
                Background="{DynamicResource One.Subtle}"
                ClipToBounds="True"
                CornerRadius="6"
                Height="170">
                <Grid>
                    <Image
                        Name="PART_Preview"
                        Source="{CompiledBinding PreviewImage}"
                        Stretch="Uniform" />
                    <PathIcon
                        Data="M5,2 L14,2 L20,8 L20,22 L4,22 L4,2 Z M6,4 L6,20 L18,20 L18,9 L13,9 L13,4 Z M15,5 L15,7 L17,7 Z M8,12 L16,12 L16,14 L8,14 Z M8,16 L14,16 L14,18 L8,18 Z"
                        Foreground="{DynamicResource One.Muted}"
                        Height="44"
                        IsVisible="{CompiledBinding !HasPreview}"
                        Width="44" />
                    <one:LoadingIndicator
                        HorizontalAlignment="Center"
                        IsVisible="{CompiledBinding IsPreviewLoading}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{CompiledBinding SelectedFile.Name}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Grid.Column="1"
                    Text="{CompiledBinding SelectedFile.SizeText}"
                    VerticalAlignment="Center" />
            </Grid>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:DataType="one:Upload" x:Key="One.Upload.ActionsTemplate">
        <WrapPanel>
            <Button
                Command="{CompiledBinding SelectCommand}"
                Content="{CompiledBinding ReplaceText}"
                Margin="0,0,8,8"
                Name="PART_Replace" />
            <Button
                Classes="ghost"
                Command="{CompiledBinding RemoveCommand}"
                Content="{CompiledBinding RemoveText}"
                Margin="0,0,8,8"
                Name="PART_Remove" />
            <Button
                Classes="primary"
                Command="{CompiledBinding RequestUploadCommand}"
                Content="{CompiledBinding UploadText}"
                Margin="0,0,0,8"
                Name="PART_Upload" />
        </WrapPanel>
    </DataTemplate>
    <ControlTheme TargetType="one:Upload" x:Key="{x:Type one:Upload}">
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.InputLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="EmptyTemplate" Value="{StaticResource One.Upload.EmptyTemplate}" />
        <Setter Property="FileTemplate" Value="{StaticResource One.Upload.FileTemplate}" />
        <Setter Property="ActionsTemplate" Value="{StaticResource One.Upload.ActionsTemplate}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Surface"
                    Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="12">
                        <ContentPresenter
                            Content="{CompiledBinding $parent[one:Upload]}"
                            ContentTemplate="{TemplateBinding EmptyTemplate}"
                            Name="PART_Empty" />
                        <ContentPresenter
                            Content="{CompiledBinding $parent[one:Upload]}"
                            ContentTemplate="{TemplateBinding FileTemplate}"
                            IsVisible="False"
                            Name="PART_File" />
                        <ProgressBar
                            HorizontalAlignment="Stretch"
                            IsVisible="False"
                            Maximum="100"
                            MinWidth="0"
                            Minimum="0"
                            Name="PART_Progress"
                            Value="{TemplateBinding Progress}" />
                        <TextBlock
                            Foreground="{DynamicResource One.Muted}"
                            Text="{TemplateBinding StatusText}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{DynamicResource One.Danger}"
                            IsVisible="False"
                            Name="PART_Error"
                            Text="{TemplateBinding ErrorMessage}"
                            TextWrapping="Wrap" />
                        <ContentPresenter
                            Content="{CompiledBinding $parent[one:Upload]}"
                            ContentTemplate="{TemplateBinding ActionsTemplate}"
                            IsVisible="False"
                            Name="PART_Actions" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:has-file /template/ ContentPresenter#PART_Empty">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-file /template/ ContentPresenter#PART_File">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-file /template/ ContentPresenter#PART_Actions">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:error /template/ TextBlock#PART_Error">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:error /template/ Border#PART_Surface">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Danger}" />
        </Style>
        <Style Selector="^:busy /template/ ProgressBar#PART_Progress">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
