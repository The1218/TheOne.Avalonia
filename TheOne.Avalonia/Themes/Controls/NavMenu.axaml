<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:styling="using:TheOne.Avalonia.Styling"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme
        BasedOn="{StaticResource {x:Type TreeView}}"
        TargetType="one:NavMenu"
        x:DataType="one:NavMenu"
        x:Key="{x:Type one:NavMenu}">
        <Setter Property="TransitionDuration" Value="{DynamicResource One.Motion.Expand}" />
        <Setter Property="Width" Value="{CompiledBinding $self.DisplayWidth}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="ItemHeight" Value="36" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="IconSpacing" Value="10" />
        <Setter Property="Indent" Value="16" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto,*">
                        <Grid
                            IsVisible="{TemplateBinding ShowFilter}"
                            Margin="0,0,0,8"
                            Name="PART_FilterHeader">
                            <Grid Name="PART_FilterInlineHost">
                                <one:NavMenuFilterBox
                                    ItemsSource="{TemplateBinding FilterResults}"
                                    MaxDropDownHeight="320"
                                    Name="PART_FilterBox"
                                    PlaceholderText="{TemplateBinding FilterPlaceholder}"
                                    Text="{TemplateBinding SearchText,
                                                           Mode=TwoWay}"
                                    ValueMemberBinding="{CompiledBinding Label}"
                                    x:DataType="one:NavMenuFilterResult">
                                    <one:NavMenuFilterBox.ItemTemplate>
                                        <DataTemplate x:DataType="one:NavMenuFilterResult">
                                            <StackPanel Spacing="2">
                                                <one:NavMenuSearchText SourceText="{CompiledBinding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource One.Muted}"
                                                    Text="{CompiledBinding Path}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </one:NavMenuFilterBox.ItemTemplate>
                                </one:NavMenuFilterBox>
                            </Grid>
                            <Button
                                AutomationProperties.Name="{TemplateBinding FilterPlaceholder}"
                                Background="{DynamicResource One.Transparent}"
                                BorderBrush="{DynamicResource One.Transparent}"
                                Height="{TemplateBinding ItemHeight}"
                                HorizontalAlignment="Center"
                                IsVisible="False"
                                MinHeight="0"
                                MinWidth="0"
                                Name="PART_FilterButton"
                                Padding="0"
                                ToolTip.Tip="{TemplateBinding FilterPlaceholder}"
                                Width="{TemplateBinding ItemHeight}">
                                <PathIcon
                                    Data="M 10,2 A 8,8 0 1 0 10,18 A 8,8 0 1 0 10,2 M 10,4 A 6,6 0 1 1 10,16 A 6,6 0 1 1 10,4 M 16,15 L 23,22 L 21,24 L 14,17 Z"
                                    Height="{TemplateBinding IconSize}"
                                    Width="{TemplateBinding IconSize}" />
                            </Button>
                            <Popup
                                HorizontalOffset="8"
                                IsLightDismissEnabled="True"
                                Name="PART_FilterPopup"
                                Placement="RightEdgeAlignedTop"
                                ShouldUseOverlayLayer="True">
                                <Border
                                    Background="{DynamicResource One.Surface}"
                                    BorderBrush="{DynamicResource One.OutlineStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource One.Radius.Popup}"
                                    Padding="8">
                                    <Grid Name="PART_FilterPopupHost" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ScrollViewer
                            AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                            Background="{TemplateBinding Background}"
                            BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}"
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                            IsDeferredScrollingEnabled="{TemplateBinding (ScrollViewer.IsDeferredScrollingEnabled)}"
                            IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                            Name="PART_MenuScrollViewer"
                            VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                            <ItemsPresenter
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Margin="{TemplateBinding Padding}"
                                Name="PART_ItemsPresenter" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:bounded-roots">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="^:collapsed">
        </Style>
        <Style Selector="^:collapsed /template/ Grid#PART_FilterInlineHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:collapsed /template/ Button#PART_FilterButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
    <ControlTheme
        BasedOn="{StaticResource One.TreeViewExpandCollapseChevron}"
        TargetType="ToggleButton"
        x:Key="One.NavMenuCascadeChevron">
        <Style Selector="^:checked /template/ Path#ChevronPath">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
    </ControlTheme>
    <ControlTheme
        BasedOn="{StaticResource {x:Type TreeViewItem}}"
        TargetType="one:NavMenuItem"
        x:Key="{x:Type one:NavMenuItem}">
        <!--  Retain one viewport on either side so reversing a fling reuses nearby rows.  -->
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <one:VirtualizingItemsPanel CacheLength="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Padding" Value="0,4,10,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style Selector="^:compact">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:compact /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:compact /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^:compact /template/ one|RevealHost#TreeContent">
            <Setter Property="IsOpen" Value="False" />
            <Setter Property="styling:Motion.Enabled" Value="False" />
        </Style>
        <Style Selector="^:cascade">
            <Setter Property="Padding" Value="10,4,4,4" />
        </Style>
        <Style Selector="^:cascade /template/ one|RevealHost#TreeContent">
            <Setter Property="IsOpen" Value="False" />
            <Setter Property="styling:Motion.Enabled" Value="False" />
        </Style>
        <Style Selector="^:cascade /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Grid.Column" Value="0" />
        </Style>
        <Style Selector="^:cascade /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:cascade /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Theme" Value="{StaticResource One.NavMenuCascadeChevron}" />
        </Style>
        <Style Selector="^:active-ancestor /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
        </Style>
        <Style Selector="^:active-ancestor /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:group /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        </Style>
        <Style Selector="^:active-ancestor:group /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.Transparent}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
