<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="one:RelationGraph" x:Key="{x:Type one:RelationGraph}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="NodeWidth" Value="260" />
        <Setter Property="NodeMinHeight" Value="88" />
        <Setter Property="NodeSpacing" Value="36" />
        <Setter Property="LevelSpacing" Value="80" />
        <Setter Property="ConnectorBrush" Value="{DynamicResource One.Accent}" />
        <Setter Property="ConnectorThickness" Value="1.5" />
        <Setter Property="ConnectorCornerRadius" Value="8" />
        <Setter Property="PortRadius" Value="3" />
        <Setter Property="Focusable" Value="False" />
        <Style Selector="^.one-small">
            <Setter Property="NodeWidth" Value="220" />
            <Setter Property="NodeMinHeight" Value="72" />
            <Setter Property="NodeSpacing" Value="28" />
            <Setter Property="LevelSpacing" Value="60" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="NodeWidth" Value="300" />
            <Setter Property="NodeMinHeight" Value="104" />
            <Setter Property="NodeSpacing" Value="44" />
            <Setter Property="LevelSpacing" Value="100" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="one:RelationGraphNodePresenter" x:Key="{x:Type one:RelationGraphNodePresenter}">
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="ContentForeground" Value="{DynamicResource One.Muted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeaderFontSize" Value="16" />
        <Setter Property="IconSize" Value="24" />
        <Setter Property="IconTileSize" Value="44" />
        <Setter Property="IconSpacing" Value="14" />
        <Setter Property="TextSpacing" Value="6" />
        <Setter Property="IconBackground" Value="{DynamicResource One.AccentSoft}" />
        <Setter Property="IconForeground" Value="{DynamicResource One.Accent}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_Surface"
                    Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,Auto,*" Name="PART_Layout">
                        <Border
                            Background="{TemplateBinding IconBackground}"
                            CornerRadius="6"
                            Height="{TemplateBinding IconTileSize}"
                            IsVisible="False"
                            Name="PART_IconHost"
                            VerticalAlignment="Center"
                            Width="{TemplateBinding IconTileSize}">
                            <ContentPresenter
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                FontSize="{TemplateBinding IconSize}"
                                Foreground="{TemplateBinding IconForeground}"
                                Height="{TemplateBinding IconSize}"
                                HorizontalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                Name="PART_IconPresenter"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Stretch"
                                Width="{TemplateBinding IconSize}" />
                        </Border>
                        <Border
                            Grid.Column="1"
                            IsVisible="False"
                            Name="PART_IconGap"
                            Width="{TemplateBinding IconSpacing}" />
                        <StackPanel
                            Grid.Column="2"
                            Name="PART_TextHost"
                            VerticalAlignment="Center">
                            <ContentPresenter
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                FontSize="{TemplateBinding HeaderFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="False"
                                Name="PART_HeaderPresenter"
                                TextBlock.TextWrapping="Wrap"
                                VerticalContentAlignment="Center" />
                            <Border
                                Height="{TemplateBinding TextSpacing}"
                                IsVisible="False"
                                Name="PART_TextGap" />
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding ContentForeground}"
                                HorizontalContentAlignment="Stretch"
                                IsVisible="False"
                                Name="PART_ContentPresenter"
                                TextBlock.TextWrapping="Wrap"
                                VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:root">
            <Setter Property="Background" Value="{DynamicResource One.RowSelected}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected):not(:root):not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource One.SurfaceHover}" />
        </Style>
        <Style Selector="^:selected:not(:disabled)">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
            <Setter Property="IconBackground" Value="{DynamicResource One.Accent}" />
            <Setter Property="IconForeground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Surface">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
        </Style>
        <Style Selector="^:has-icon /template/ Border#PART_IconHost">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-title /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-content /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-icon:has-title /template/ Border#PART_IconGap, ^:has-icon:has-content /template/ Border#PART_IconGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-title:has-content /template/ Border#PART_TextGap">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:icon-only /template/ Border#PART_IconHost">
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="^:icon-only /template/ StackPanel#PART_TextHost">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HeaderFontSize" Value="14" />
            <Setter Property="IconSize" Value="20" />
            <Setter Property="IconTileSize" Value="36" />
            <Setter Property="IconSpacing" Value="10" />
            <Setter Property="TextSpacing" Value="4" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HeaderFontSize" Value="18" />
            <Setter Property="IconSize" Value="28" />
            <Setter Property="IconTileSize" Value="52" />
            <Setter Property="IconSpacing" Value="18" />
            <Setter Property="TextSpacing" Value="8" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
            <Setter Property="ContentForeground" Value="{DynamicResource One.DisabledText}" />
            <Setter Property="IconForeground" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>