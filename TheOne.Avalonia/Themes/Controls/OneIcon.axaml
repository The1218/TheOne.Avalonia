<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:one="using:TheOne.Avalonia.Controls" x:CompileBindings="True">
    <ControlTheme x:Key="{x:Type one:OneIcon}" TargetType="one:OneIcon">
        <!-- Foreground inherits through the host; a default setter would mask button/menu states. -->
        <Setter Property="IconSize" Value="20" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Style Selector="^.one-small"><Setter Property="IconSize" Value="16" /></Style>
        <Style Selector="^.one-large"><Setter Property="IconSize" Value="24" /></Style>
        <Style Selector="^:disabled"><Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" /></Style>
    </ControlTheme>
</ResourceDictionary>
