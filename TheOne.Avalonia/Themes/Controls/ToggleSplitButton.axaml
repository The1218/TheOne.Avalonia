<!--  ToggleSplitButton natively uses SplitButton's StyleKey. This typed alias also supports explicit Theme selection.  -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme
        BasedOn="{StaticResource {x:Type SplitButton}}"
        TargetType="ToggleSplitButton"
        x:Key="{x:Type ToggleSplitButton}" />
</ResourceDictionary>