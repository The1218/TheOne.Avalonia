<!--  Adapted from Avalonia 12.1.4 (MIT). See THIRD-PARTY-NOTICES.md.  -->
<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="clr-namespace:TheOne.Avalonia.Controls;assembly=TheOne.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <x:Double x:Key="One.CalendarDatePickerCurrentDayFontSize">12</x:Double>
    <x:Double x:Key="One.CalendarDatePickerMinHeight">32</x:Double>

    <ControlTheme TargetType="Button" x:Key="One.CalendarDatePickerButton">
        <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    CornerRadius="{DynamicResource One.Radius.Control}"
                    Padding="0">
                    <Path
                        Data="M 2,3 L 14,3 L 14,14 L 2,14 Z M 2,6 L 14,6 M 5,1 L 5,5 M 11,1 L 11,5"
                        Height="16"
                        HorizontalAlignment="Center"
                        Stretch="Uniform"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="1.3"
                        VerticalAlignment="Center"
                        Width="16" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource One.NeutralHover}" />
        </Style>
    </ControlTheme>

    <ControlTheme TargetType="CalendarDatePicker" x:Key="{x:Type CalendarDatePicker}">
        <Setter Property="one:CalendarInput.OpenOnClick" Value="True" />
        <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource One.Placeholder}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.InputLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Height}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <Panel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        x:Name="LayoutRoot">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            x:Name="Background" />
                        <Border ClipToBounds="True" CornerRadius="{TemplateBinding CornerRadius}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Classes="one-embedded one-borderless"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Margin="{TemplateBinding BorderThickness}"
                                    MinHeight="0"
                                    Name="PART_TextBox"
                                    Padding="{TemplateBinding Padding}"
                                    PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                    PlaceholderText="{TemplateBinding PlaceholderText}"
                                    UseFloatingPlaceholder="{TemplateBinding UseFloatingPlaceholder}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <TextBox.Styles>
                                        <Style Selector="TextBox#PART_TextBox /template/ Border#PART_BorderElement">
                                            <!--  By default the TextBox has its own focused state, override this to disable it here  -->
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="TextBox#PART_TextBox:disabled">
                                            <Style Selector="^ /template/ Border#PART_BorderElement">
                                                <!--  By default the TextBox has its own disabled state, override this to make the border background show through  -->
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </Style>
                                            <Style Selector="^ /template/ TextBlock#PART_Placeholder, ^ TextBlock#PART_FloatingPlaceholder">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource One.DisabledText}" />
                                            </Style>
                                        </Style>
                                    </TextBox.Styles>
                                </TextBox>
                                <Button
                                    Focusable="False"
                                    Grid.Column="1"
                                    Name="PART_Button"
                                    Theme="{StaticResource One.CalendarDatePickerButton}" />
                                <Popup
                                    IsLightDismissEnabled="True"
                                    Name="PART_Popup"
                                    PlacementTarget="{TemplateBinding}">
                                    <Calendar
                                        DisplayDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=DisplayDate, Mode=TwoWay}"
                                        DisplayDateEnd="{TemplateBinding DisplayDateEnd}"
                                        DisplayDateStart="{TemplateBinding DisplayDateStart}"
                                        FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                        IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                        Name="PART_Calendar"
                                        SelectedDate="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=SelectedDate, Mode=TwoWay}"
                                        one:CalendarOptions.DisplayStyle="{TemplateBinding one:CalendarOptions.DisplayStyle}"
                                        one:CalendarOptions.Time="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(one:CalendarOptions.Time), Mode=TwoWay}" />
                                </Popup>
                            </Grid>
                        </Border>
                        <Border
                            BorderBrush="{Binding #Background.BorderBrush}"
                            BorderThickness="{Binding #Background.BorderThickness}"
                            CornerRadius="{Binding #Background.CornerRadius}"
                            IsHitTestVisible="False"
                            Name="InputOutline" />
                    </Panel>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>

        <!--  Pressed State  -->
        <Style Selector="^:pressed /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource One.NeutralPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Transparent}" />
        </Style>

        <!--  Pointer-over State  -->
        <Style Selector="^:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource One.NeutralHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Transparent}" />
        </Style>

        <!--  Disabled State  -->
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource One.DisabledSurface}" />
            </Style>

            <Style Selector="^ /template/ Button#PART_Button">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource One.DisabledText}" />
            </Style>
        </Style>

        <!--  Focused State  -->
        <Style Selector="^:focus-within /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
            <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThicknessFocused}" />
        </Style>

        <!--  Error State  -->
        <Style Selector="^:error /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Danger}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>