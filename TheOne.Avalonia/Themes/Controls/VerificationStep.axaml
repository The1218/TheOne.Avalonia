<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ControlTheme TargetType="ListBoxItem" x:Key="One.StepHeader">
        <Setter Property="Width" Value="200" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="Stretch"
                        Name="PART_ContentPresenter"
                        VerticalContentAlignment="Top" />
                    <Border
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Name="PART_HeaderFocus" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ Border#PART_HeaderFocus">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Focus}" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="one:StepField" x:Key="{x:Type one:StepField}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,Auto">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Name="PART_ContentPresenter" />
                    <ListBox
                        AutomationProperties.Name="字段验证错误"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Foreground="{DynamicResource One.Danger}"
                        Grid.Row="1"
                        IsVisible="{TemplateBinding HasErrors}"
                        ItemsSource="{TemplateBinding Errors}"
                        Margin="0,4,0,0"
                        MaxHeight="96"
                        MinHeight="0"
                        Name="PART_FieldErrors"
                        Padding="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem.one-small, ListBoxItem.one-normal, ListBoxItem.one-large">
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Name="PART_ContentPresenter" />
                                    </ControlTemplate>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="one:StepValidationError">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="ListBoxItem" x:Key="One.StepFormField">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalContentAlignment="Stretch"
                    Name="PART_ContentPresenter" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme
        BasedOn="{StaticResource {x:Type ListBox}}"
        TargetType="ListBox"
        x:Key="One.StepForm">
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource One.StepFormField}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme TargetType="one:VerificationStep" x:Key="{x:Type one:VerificationStep}">
        <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="360" />
        <Setter Property="MaxHeight" Value="720" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                        <ListBox
                            AutomationProperties.Name="步骤导航"
                            Background="Transparent"
                            BorderThickness="0"
                            Height="112"
                            HorizontalAlignment="{TemplateBinding HeaderHorizontalAlignment}"
                            ItemContainerTheme="{StaticResource One.StepHeader}"
                            MaxWidth="{TemplateBinding HeaderMaxWidth}"
                            MinHeight="0"
                            Name="PART_Steps"
                            Padding="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.IsScrollChainingEnabled="False"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="one:StepItem">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <Grid.Styles>
                                            <Style Selector="one|Tag.step-indicator">
                                                <Setter Property="Width" Value="36" />
                                                <Setter Property="Height" Value="36" />
                                            </Style>
                                            <Style Selector="one|Tag.step-indicator.one-small">
                                                <Setter Property="Width" Value="30" />
                                                <Setter Property="Height" Value="30" />
                                            </Style>
                                            <Style Selector="one|Tag.step-indicator.one-large">
                                                <Setter Property="Width" Value="42" />
                                                <Setter Property="Height" Value="42" />
                                            </Style>
                                        </Grid.Styles>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <Border
                                                Background="{DynamicResource One.Line}"
                                                Height="3"
                                                IsVisible="{Binding HasPrevious}"
                                                Name="PART_LeftConnector" />
                                            <Border
                                                Background="{DynamicResource One.Accent}"
                                                Classes.reached="{Binding IsReached}"
                                                Height="3"
                                                IsVisible="{Binding HasPrevious}"
                                                Name="PART_LeftProgress">
                                                <Border.Styles>
                                                    <Style Selector="Border">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </Style>
                                                    <Style Selector="Border.reached">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                            <one:Tag
                                                Classes="step-indicator"
                                                Content="{Binding Indicator}"
                                                CornerRadius="100"
                                                Grid.Column="1"
                                                HorizontalContentAlignment="Center"
                                                MinHeight="0"
                                                MinWidth="0"
                                                Name="PART_Indicator"
                                                Padding="0"
                                                Status="{Binding Status}"
                                                Variant="{Binding IndicatorVariant}"
                                                VerticalContentAlignment="Center" />
                                            <Border
                                                Background="{DynamicResource One.Line}"
                                                Grid.Column="2"
                                                Height="3"
                                                IsVisible="{Binding HasNext}"
                                                Name="PART_RightConnector" />
                                            <Border
                                                Background="{DynamicResource One.Accent}"
                                                Classes.reached="{Binding IsSuccess}"
                                                Grid.Column="2"
                                                Height="3"
                                                IsVisible="{Binding HasNext}"
                                                Name="PART_RightProgress">
                                                <Border.Styles>
                                                    <Style Selector="Border">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </Style>
                                                    <Style Selector="Border.reached">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </Style>
                                                </Border.Styles>
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Classes.reached="{Binding IsReached}"
                                            Grid.Row="1"
                                            Text="{Binding Title}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
                                                </Style>
                                                <Style Selector="TextBlock.reached">
                                                    <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource One.Muted}"
                                            Grid.Row="2"
                                            Text="{Binding Description}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ListBox
                            AutomationProperties.Name="步骤验证错误"
                            Background="{DynamicResource One.DangerSoft}"
                            BorderThickness="0"
                            Focusable="False"
                            Foreground="{DynamicResource One.Danger}"
                            Grid.Row="1"
                            IsVisible="{TemplateBinding HasUnmappedErrors}"
                            ItemsSource="{TemplateBinding UnmappedErrors}"
                            MaxHeight="120"
                            MinHeight="0"
                            Name="PART_ValidationErrors"
                            Padding="4">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="one:StepValidationError">
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ContentPresenter
                            Content="{TemplateBinding CurrentContent}"
                            ContentTemplate="{TemplateBinding CurrentContentTemplate}"
                            Grid.Row="2"
                            HorizontalContentAlignment="Stretch"
                            Name="PART_ContentPresenter"
                            VerticalContentAlignment="Stretch" />
                        <Grid
                            ColumnDefinitions="*,Auto,Auto"
                            ColumnSpacing="10"
                            Grid.Row="3">
                            <ProgressBar
                                Height="4"
                                HorizontalAlignment="Left"
                                IsIndeterminate="True"
                                IsVisible="{TemplateBinding IsBusy}"
                                MaxWidth="180"
                                Name="PART_Progress"
                                VerticalAlignment="Center"
                                Width="120" />
                            <Button
                                Content="{TemplateBinding PreviousText}"
                                Grid.Column="1"
                                IsEnabled="{TemplateBinding CanGoBack}"
                                Name="PART_PreviousButton" />
                            <Button
                                Classes="primary"
                                Content="{TemplateBinding ForwardText}"
                                Grid.Column="2"
                                IsEnabled="{TemplateBinding CanGoNext}"
                                Name="PART_NextButton" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:busy /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>
    </ControlTheme>
</ResourceDictionary>