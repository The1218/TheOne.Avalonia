<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:conv="using:TheOne.Avalonia.Converters"
    xmlns:markup="using:Avalonia.Markup.Xaml.MarkupExtensions"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <conv:TagDashRadiusConverter x:Key="One.Tag.DashRadiusConverter" />
    <ControlTheme TargetType="one:Tag" x:Key="{x:Type one:Tag}">
        <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Name="PART_Surface"
                        Padding="{TemplateBinding Padding}">
                        <Grid
                            ColumnDefinitions="Auto,*"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <Ellipse
                                Fill="{TemplateBinding Foreground}"
                                Height="6"
                                IsVisible="False"
                                Margin="0,0,6,0"
                                Name="PART_StatusDot"
                                VerticalAlignment="Center"
                                Width="6" />
                            <Grid
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="{TemplateBinding Spacing}"
                                Grid.Column="1"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Name="PART_ContentLayout"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Viewbox
                                    Height="{TemplateBinding IconSize}"
                                    Stretch="Uniform"
                                    Width="{TemplateBinding IconSize}">
                                    <ContentPresenter
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"
                                        IsVisible="False"
                                        Name="PART_IconPresenter"
                                        VerticalContentAlignment="Center">
                                        <ContentPresenter.DataTemplates>
                                            <DataTemplate DataType="{x:Type one:OneIconKind}" x:DataType="one:OneIconKind">
                                                <one:OneIcon Kind="{CompiledBinding}"
                                                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type Geometry}" x:DataType="Geometry">
                                                <PathIcon Data="{CompiledBinding}" />
                                            </DataTemplate>
                                        </ContentPresenter.DataTemplates>
                                    </ContentPresenter>
                                </Viewbox>
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Grid.Column="1"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Name="PART_ContentPresenter"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Rectangle
                        IsHitTestVisible="False"
                        IsVisible="False"
                        Margin="0.5"
                        Name="PART_DashedOutline"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeDashArray="3,2"
                        StrokeThickness="1">
                        <Rectangle.RadiusX>
                            <MultiBinding Converter="{StaticResource One.Tag.DashRadiusConverter}">
                                <markup:CompiledBindingExtension Path="#PART_Surface.CornerRadius" />
                                <markup:CompiledBindingExtension Path="#PART_DashedOutline.Bounds" />
                            </MultiBinding>
                        </Rectangle.RadiusX>
                        <Rectangle.RadiusY>
                            <MultiBinding Converter="{StaticResource One.Tag.DashRadiusConverter}">
                                <markup:CompiledBindingExtension Path="#PART_Surface.CornerRadius" />
                                <markup:CompiledBindingExtension Path="#PART_DashedOutline.Bounds" />
                            </MultiBinding>
                        </Rectangle.RadiusY>
                    </Rectangle>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Viewbox">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-icon /template/ Viewbox">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:has-icon /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(:has-icon) /template/ Grid#PART_ContentLayout, ^:not(:has-content) /template/ Grid#PART_ContentLayout">
            <Setter Property="ColumnSpacing" Value="0" />
        </Style>
        <Style Selector="^:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        </Style>
        <Style Selector="^:solid">
            <Setter Property="Background" Value="{DynamicResource One.Text}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Canvas}" />
        </Style>
        <Style Selector="^:information">
            <Setter Property="Foreground" Value="{DynamicResource One.Info}" />
            <Setter Property="Background" Value="{DynamicResource One.InfoSoft}" />
        </Style>
        <Style Selector="^:information:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Info}" />
        </Style>
        <Style Selector="^:information:solid">
            <Setter Property="Background" Value="{DynamicResource One.Info}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^:success">
            <Setter Property="Foreground" Value="{DynamicResource One.Success}" />
            <Setter Property="Background" Value="{DynamicResource One.SuccessSoft}" />
        </Style>
        <Style Selector="^:success:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Success}" />
        </Style>
        <Style Selector="^:success:solid">
            <Setter Property="Background" Value="{DynamicResource One.Success}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^:warning">
            <Setter Property="Foreground" Value="{DynamicResource One.Warning}" />
            <Setter Property="Background" Value="{DynamicResource One.WarningSoft}" />
        </Style>
        <Style Selector="^:warning:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Warning}" />
        </Style>
        <Style Selector="^:warning:solid">
            <Setter Property="Background" Value="{DynamicResource One.Warning}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^:error">
            <Setter Property="Foreground" Value="{DynamicResource One.Danger}" />
            <Setter Property="Background" Value="{DynamicResource One.DangerSoft}" />
        </Style>
        <Style Selector="^:error:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Danger}" />
        </Style>
        <Style Selector="^:error:solid">
            <Setter Property="Background" Value="{DynamicResource One.Danger}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^:processing">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
        </Style>
        <Style Selector="^:processing:outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:processing:solid">
            <Setter Property="Background" Value="{DynamicResource One.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
        </Style>
        <Style Selector="^.pill">
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="^.square">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="^.dashed">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.dashed /template/ Rectangle#PART_DashedOutline">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.dot /template/ Ellipse#PART_StatusDot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.gradient">
            <Setter Property="Background" Value="{DynamicResource One.Gradient.Brand}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.one-small">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="^.one-large">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="11,4" />
        </Style>
        <Style Selector="^:disabled, ^:disabled:solid, ^:disabled:outline, ^:disabled:soft">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
