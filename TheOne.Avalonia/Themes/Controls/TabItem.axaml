<ResourceDictionary
    x:CompileBindings="True"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <x:Double x:Key="One.TabItemMinHeight">40</x:Double>
    <x:Double x:Key="One.TabItemVerticalPipeHeight">24</x:Double>
    <x:Double x:Key="One.TabItemPipeThickness">2</x:Double>

    <ControlTheme TargetType="TabItem" x:Key="{x:Type TabItem}">
        <Setter Property="FontSize" Value="{DynamicResource TabItemHeaderFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TabItemHeaderThemeFontWeight}" />
        <Setter Property="Background" Value="{DynamicResource One.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        <Setter Property="Padding" Value="{DynamicResource TabItemHeaderMargin}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource One.TabItemMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Name="PART_LayoutRoot"
                    Padding="{TemplateBinding Padding}">
                    <Panel>
                        <ContentPresenter
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Name="PART_ContentPresenter"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border
                            Background="{DynamicResource One.Accent}"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            IsVisible="False"
                            Name="PART_SelectedPipe" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RecognizesAccessKey" Value="True" />
        </Style>

        <!--  Selected state  -->
        <!--  We don't use selector to PART_LayoutRoot, so developer can override selected item background with TabStripItem.Background  -->
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!--  PointerOver state  -->
        <Style Selector="^:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource One.Text}" />
        </Style>

        <!--  Selected PointerOver state  -->
        <Style Selector="^:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource One.Accent}" />
        </Style>

        <!--  Pressed state  -->
        <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.Line}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource One.Text}" />
        </Style>

        <!--  Selected Pressed state  -->
        <Style Selector="^:selected:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource One.Accent}" />
        </Style>

        <!--  Disabled state  -->
        <Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.DisabledSurface}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>

        <!--  TabStripPlacement States Group  -->
        <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_SelectedPipe">
            <Setter Property="Width" Value="{DynamicResource One.TabItemPipeThickness}" />
            <Setter Property="Height" Value="{DynamicResource One.TabItemVerticalPipeHeight}" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style Selector="^[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe, ^[TabStripPlacement=Bottom] /template/ Border#PART_SelectedPipe">
            <Setter Property="Height" Value="{DynamicResource One.TabItemPipeThickness}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style Selector="^[TabStripPlacement=Right] /template/ Border#PART_SelectedPipe">
            <Setter Property="Width" Value="{DynamicResource One.TabItemPipeThickness}" />
            <Setter Property="Height" Value="{DynamicResource One.TabItemVerticalPipeHeight}" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right]">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="Button" x:Key="One.CardTabHeaderButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Name="ButtonBackground">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="Center"
                        Margin="{TemplateBinding Padding}"
                        Name="PART_ContentPresenter"
                        VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource One.CardTabHover}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource One.Line}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
    <ControlTheme TargetType="TabItem" x:Key="One.CardTabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="16,0,12,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource One.Radius.Control}" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Height}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <one:CardTabChrome
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsSelected="{TemplateBinding IsSelected}"
                    Name="PART_LayoutRoot"
                    Placement="{TemplateBinding TabStripPlacement}">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto" Margin="{TemplateBinding Padding}">
                            <ContentPresenter
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Name="PART_ContentPresenter"
                                RecognizesAccessKey="True"
                                VerticalAlignment="Center" />
                            <Button
                                AutomationProperties.Name="关闭标签页"
                                Classes="one-close"
                                Command="{x:Static one:TabFeatures.CloseTabCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Focusable="False"
                                Grid.Column="1"
                                Height="24"
                                Margin="8,0,-4,0"
                                MinHeight="0"
                                MinWidth="0"
                                Name="PART_CloseButton"
                                Padding="5"
                                Theme="{StaticResource One.CardTabHeaderButton}"
                                ToolTip.Tip="关闭标签页（Ctrl / ⌘ + W）"
                                Width="24">
                                <Button.IsVisible>
                                    <TemplateBinding Property="one:TabFeatures.ShowCloseButton" />
                                </Button.IsVisible>
                                <PathIcon
                                    Data="M 1,0 L 6,5 L 11,0 L 12,1 L 7,6 L 12,11 L 11,12 L 6,7 L 1,12 L 0,11 L 5,6 L 0,1 Z"
                                    Height="12"
                                    Width="12" />
                            </Button>
                        </Grid>
                        <Border
                            Background="{DynamicResource One.CardTabBorder}"
                            Height="16"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            Name="PART_Separator"
                            VerticalAlignment="Center"
                            Width="1" />
                    </Panel>
                </one:CardTabChrome>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:selected) /template/ Button#PART_CloseButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pointerover /template/ one|CardTabChrome#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.CardTabHover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.CardTabBorder}" />
            <Setter Property="ZIndex" Value="2" />
        </Style>
        <Style Selector="^:selected:pointerover /template/ one|CardTabChrome#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Separator, ^.before-selected /template/ Border#PART_Separator, ^.last-tab /template/ Border#PART_Separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_Separator, ^[TabStripPlacement=Right] /template/ Border#PART_Separator">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^.drop-target /template/ one|CardTabChrome#PART_LayoutRoot">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="^.dragging">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
