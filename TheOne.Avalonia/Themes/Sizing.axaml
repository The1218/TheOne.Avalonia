    <!--  Labels align with form fields; selectable paragraphs retain content-driven height.  -->
    <Style Selector="Label.one-small">
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Small.Height}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.one-small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="{DynamicResource One.Text.Small.LineHeight}" />
    </Style>
    <Style Selector="Label.one-normal">
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Height}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="SelectableTextBlock.one-normal">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="{DynamicResource One.Text.LineHeight}" />
    </Style>
    <Style Selector="Label.one-large">
        <Setter Property="MinHeight" Value="{DynamicResource One.Size.Large.Height}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="SelectableTextBlock.one-large">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="{DynamicResource One.Text.Large.LineHeight}" />
    </Style>
    <Style Selector="FlyoutPresenter.one-small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="{DynamicResource One.Flyout.Small.Padding}" />
    </Style>
    <Style Selector="FlyoutPresenter.one-normal">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{DynamicResource One.Flyout.Padding}" />
    </Style>
    <Style Selector="FlyoutPresenter.one-large">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="{DynamicResource One.Flyout.Large.Padding}" />
    </Style>

    <Style Selector="TabStrip.one-small, TabStripItem.one-small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TabStripItem.one-small">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="TabStrip.one-normal, TabStripItem.one-normal">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TabStripItem.one-normal">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="TabStrip.one-large, TabStripItem.one-large">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="TabStripItem.one-large">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
    <!--  Internal scroll buttons retain the track thickness at every inherited density.  -->
    <Style Selector="RepeatButton.one-scroll-button">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!--  Carousel density affects content spacing; its viewport remains layout-driven.  -->
    <Style Selector="n|NotificationCard.one-small">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Small.Width}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="{DynamicResource One.Notification.Small.Padding}" />
    </Style>
    <Style Selector="n|NotificationCard.one-small /template/ Border#PART_StatusBadge">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Small.BadgeSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Small.BadgeSize}" />
    </Style>
    <Style Selector="n|NotificationCard.one-small /template/ PathIcon#PART_StatusIcon">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Small.IconSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Small.IconSize}" />
    </Style>
    <Style Selector="n|NotificationCard.one-small /template/ Button#PART_CloseButton">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Small.CloseSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Small.CloseSize}" />
    </Style>
    <Style Selector="n|NotificationCard.one-normal">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Width}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="{DynamicResource One.Notification.Padding}" />
    </Style>
    <Style Selector="n|NotificationCard.one-large">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Large.Width}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="{DynamicResource One.Notification.Large.Padding}" />
    </Style>
    <Style Selector="n|NotificationCard.one-large /template/ Border#PART_StatusBadge">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Large.BadgeSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Large.BadgeSize}" />
    </Style>
    <Style Selector="n|NotificationCard.one-large /template/ PathIcon#PART_StatusIcon">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Large.IconSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Large.IconSize}" />
    </Style>
    <Style Selector="n|NotificationCard.one-large /template/ Button#PART_CloseButton">
        <Setter Property="Width" Value="{DynamicResource One.Notification.Large.CloseSize}" />
        <Setter Property="Height" Value="{DynamicResource One.Notification.Large.CloseSize}" />
    </Style>
    <Style Selector="TransitioningContentControl.one-small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="{DynamicResource One.ContentTransition.Small.Padding}" />
    </Style>
    <Style Selector="TransitioningContentControl.one-normal">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{DynamicResource One.ContentTransition.Padding}" />
    </Style>
    <Style Selector="TransitioningContentControl.one-large">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="{DynamicResource One.ContentTransition.Large.Padding}" />
    </Style>
    <Style Selector="Carousel.one-small">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="{DynamicResource One.Carousel.Small.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Carousel.Small.MinHeight}" />
    </Style>
    <Style Selector="Carousel.one-normal">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="{DynamicResource One.Carousel.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Carousel.MinHeight}" />
    </Style>
    <Style Selector="Carousel.one-large">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="{DynamicResource One.Carousel.Large.Padding}" />
        <Setter Property="MinHeight" Value="{DynamicResource One.Carousel.Large.MinHeight}" />
    </Style>

    <Style Selector="RefreshContainer.one-small, RefreshVisualizer.one-small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="RefreshVisualizer.one-small">
        <Setter Property="Height" Value="{DynamicResource One.Refresh.Small.Height}" />
        <Setter Property="one:RefreshOptions.IndicatorSize" Value="{DynamicResource One.Refresh.Small.IndicatorSize}" />
    </Style>
    <Style Selector="RefreshVisualizer.one-small.one-refresh-horizontal">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="{DynamicResource One.Refresh.Small.Height}" />
    </Style>
    <Style Selector="RefreshContainer.one-normal, RefreshVisualizer.one-normal">
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="RefreshVisualizer.one-normal">
        <Setter Property="Height" Value="{DynamicResource One.Refresh.Height}" />
        <Setter Property="one:RefreshOptions.IndicatorSize" Value="{DynamicResource One.Refresh.IndicatorSize}" />
    </Style>
    <Style Selector="RefreshVisualizer.one-normal.one-refresh-horizontal">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="{DynamicResource One.Refresh.Height}" />
    </Style>
    <Style Selector="RefreshContainer.one-large, RefreshVisualizer.one-large">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="RefreshVisualizer.one-large">
        <Setter Property="Height" Value="{DynamicResource One.Refresh.Large.Height}" />
        <Setter Property="one:RefreshOptions.IndicatorSize" Value="{DynamicResource One.Refresh.Large.IndicatorSize}" />
    </Style>
    <Style Selector="RefreshVisualizer.one-large.one-refresh-horizontal">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Width" Value="{DynamicResource One.Refresh.Large.Height}" />
    </Style>
    <Style Selector="DatePickerPresenter.one-small, TimePickerPresenter.one-small">
        <Setter Property="styling:PickerSizing.ItemHeight" Value="32" />
        <Setter Property="styling:PickerSizing.ViewportHeight" Value="160" />
        <Setter Property="styling:PickerSizing.PopupHeight" Value="288" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="DatePickerPresenter.one-normal, TimePickerPresenter.one-normal">
        <Setter Property="styling:PickerSizing.ItemHeight" Value="40" />
        <Setter Property="styling:PickerSizing.ViewportHeight" Value="200" />
        <Setter Property="styling:PickerSizing.PopupHeight" Value="340" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="DatePickerPresenter.one-large, TimePickerPresenter.one-large">
        <Setter Property="styling:PickerSizing.ItemHeight" Value="48" />
        <Setter Property="styling:PickerSizing.ViewportHeight" Value="240" />
        <Setter Property="styling:PickerSizing.PopupHeight" Value="400" />
        <Setter Property="FontSize" Value="16" />
    </Style>
</Styles>
