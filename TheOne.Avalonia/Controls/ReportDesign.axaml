<UserControl
    Background="{DynamicResource One.Surface}"
    FontFamily="Microsoft YaHei, PingFang SC, Segoe UI, Arial"
    x:Class="TheOne.Avalonia.Controls.ReportDesign"
    x:DataType="one:ReportDesign"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:report="using:TheOne.Avalonia.Reporting"
    xmlns:styling="using:TheOne.Avalonia.Styling"
    xmlns:sys="using:System"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush Color="#EAF6F6" x:Key="One.Report.TabBackground" />
                    <SolidColorBrush Color="#EFF4F5" x:Key="One.Report.PreviewBackground" />
                    <SolidColorBrush Color="#E6E9EB" x:Key="One.Report.WorkspaceBackground" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource One.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource One.OnAccent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="Button.flat">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool.active">
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
            <Setter Property="Background" Value="{DynamicResource One.Report.TabBackground}" />
        </Style>
        <Style Selector="ToggleButton.tool">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        </Style>
        <Style Selector="ToggleButton.tool /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource One.Report.TabBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource One.Accent}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource One.DisabledText}" />
        </Style>
        <Style Selector="ToggleButton.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.toolbar-editor">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="ComboBox#FontFamilyPicker /template/ Popup#PART_Popup">
            <Setter Property="Width" Value="320" />
            <Setter Property="MaxWidth" Value="320" />
        </Style>
        <Style Selector="Expander.condition /template/ ToggleButton#ExpanderHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ToggleButton.tool:checked">
            <Setter Property="Background" Value="{DynamicResource One.AccentSoft}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander.condition /template/ ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource One.Text}" />
        </Style>
        <Style Selector="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="UniformGrid.palette &gt; Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.header">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource One.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ShowButtonSpinner" Value="False" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="TextBox[AcceptsReturn=False]:not(.one-small)">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBox.expression /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource One.Surface}" />
        </Style>
        <Style Selector="CheckBox.compact">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
        <Style Selector="Menu &gt; MenuItem">
            <Setter Property="MinWidth" Value="74" />
        </Style>
        <Style Selector="ComboBox.one-normal, NumericUpDown.one-normal, TextBox.one-normal">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner">
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TreeView#StructureTree TreeViewItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TreeView#StructureTree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Expander.condition">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander.condition /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.condition /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Expander.condition:expanded one|ReportIcon.disclosure">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="Border.inspector TextBox[AcceptsReturn=False], Border.inspector ComboBox.one-normal, Border.inspector NumericUpDown.one-normal">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Border.inspector NumericUpDown /template/ ButtonSpinner#PART_Spinner.one-normal">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="NaN" />
        </Style>
        <Style Selector="Border.inspector NumericUpDown /template/ TextBox#PART_TextBox.one-normal">
            <Setter Property="Height" Value="NaN" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Border.inspector TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.inspector ColorPicker">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.one-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        </Style>
    </UserControl.Styles>
    <Grid
        DataContext="{CompiledBinding #Root.State}"
        RowDefinitions="46,58,*,32"
        x:DataType="one:ReportDesignState">
        <Border Padding="24,6,22,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <Border
                        Background="{DynamicResource One.Accent}"
                        CornerRadius="3"
                        Padding="3">
                        <one:ReportIcon
                            Foreground="{DynamicResource One.OnAccent}"
                            Height="18"
                            Kind="Logo"
                            Width="18" />
                    </Border>
                    <TextBlock
                        FontFamily="Arial, Helvetica"
                        FontSize="20"
                        FontWeight="Bold"
                        LetterSpacing="-0.4"
                        Text="ReportDesign"
                        VerticalAlignment="Center" />
                </StackPanel>
                <Border
                    Background="{DynamicResource One.Line}"
                    Grid.Column="1"
                    Height="20"
                    Margin="26,0,26,0"
                    Width="1" />
                <TabStrip
                    AutomationProperties.Name="当前报表"
                    BorderThickness="0"
                    Grid.Column="2"
                    IsVisible="{CompiledBinding HasDocument}"
                    ItemsSource="{CompiledBinding OpenDocuments}"
                    Padding="0"
                    SelectedItem="{CompiledBinding #Root.Document, Mode=OneWay}"
                    one:TabFeatures.CanClose="True"
                    one:TabFeatures.CloseCommand="{CompiledBinding #Root.CloseDocumentCommand}"
                    x:Name="ReportNameTabs">
                    <TabStrip.Styles>
                        <Style Selector="TabStripItem">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </TabStrip.Styles>
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="report:ReportDocument">
                            <TextBlock
                                MaxWidth="180"
                                Text="{CompiledBinding Title}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <TextBlock
                    Classes="caption"
                    Grid.Column="3"
                    Margin="20,0"
                    Text="{CompiledBinding SaveStatus}"
                    VerticalAlignment="Center" />
                <StackPanel
                    Grid.Column="4"
                    Margin="0,0,14,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Classes="header"
                        Click="OnNew"
                        Content="新建"
                        x:Name="NewReportButton" />
                    <Button
                        Classes="header"
                        Click="OnLoadTemplate"
                        Content="打开" />
                    <Button
                        Classes="header"
                        Click="OnSaveRequested"
                        Command="{CompiledBinding #Root.SaveCommand}"
                        CommandParameter="{CompiledBinding Document}"
                        Content="保存"
                        IsEnabled="{CompiledBinding HasDocument}"
                        x:Name="SaveButton" />
                </StackPanel>
                <Button
                    Classes="header"
                    Click="OnPageSettings"
                    Content="页面设置"
                    Grid.Column="5"
                    IsEnabled="{CompiledBinding HasDocument}"
                    Margin="0,0,12,0"
                    Padding="18,5"
                    x:Name="PageSettingsButton" />
                <Button
                    BorderBrush="{DynamicResource One.Accent}"
                    Classes="header"
                    Click="OnPreview"
                    Content="预览"
                    Foreground="{DynamicResource One.Accent}"
                    Grid.Column="6"
                    IsEnabled="{CompiledBinding HasDocument}"
                    Margin="0,0,12,0"
                    Padding="28,5"
                    x:Name="PreviewButton" />
                <Button
                    Classes="primary header"
                    Click="OnExportPdf"
                    Content="导出 PDF"
                    Grid.Column="7"
                    IsEnabled="{CompiledBinding CanExport}"
                    Padding="22,5"
                    x:Name="ExportPdfButton" />
            </Grid>
        </Border>

        <Border
            BorderThickness="0,1,0,1"
            Classes="divider"
            Grid.Row="1"
            Padding="20,10,22,10">
            <Grid ColumnDefinitions="*,122">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    x:Name="ToolbarScroll">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="0"
                        x:Name="CommandBar">
                        <Grid ColumnDefinitions="36,16,36,*" Width="110">
                            <Button
                                AutomationProperties.Name="撤销"
                                Classes="tool"
                                Click="OnUndo"
                                IsEnabled="{CompiledBinding CanUndo}"
                                ToolTip.Tip="撤销"
                                Width="36"
                                x:Name="UndoButton">
                                <one:ReportIcon
                                    Height="20"
                                    Kind="Undo"
                                    Width="20" />
                            </Button>
                            <Button
                                AutomationProperties.Name="重做"
                                Classes="tool"
                                Click="OnRedo"
                                Grid.Column="2"
                                IsEnabled="{CompiledBinding CanRedo}"
                                ToolTip.Tip="重做"
                                Width="36"
                                x:Name="RedoButton">
                                <one:ReportIcon
                                    Height="20"
                                    Kind="Redo"
                                    Width="20" />
                            </Button>
                        </Grid>
                        <Border
                            Background="{DynamicResource One.Line}"
                            Height="30"
                            Width="1" />
                        <Border Padding="23,0,0,0" Width="239">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button
                                    AutomationProperties.Name="选择元素"
                                    Classes="tool active"
                                    Click="OnSelectTool"
                                    ToolTip.Tip="选择元素">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Pointer"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="插入文本"
                                    Classes="tool"
                                    Click="OnInsert"
                                    Tag="Text"
                                    ToolTip.Tip="插入文本">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Text"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="插入表格"
                                    Classes="tool"
                                    Click="OnInsert"
                                    Tag="Table"
                                    ToolTip.Tip="插入表格">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Table"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="插入图片"
                                    Classes="tool"
                                    Click="OnInsert"
                                    Tag="Image"
                                    ToolTip.Tip="插入图片">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Image"
                                        Width="20" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{DynamicResource One.Line}"
                            Height="30"
                            Width="1" />
                        <Border Padding="19,0,0,0" Width="267">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox
                                    AutomationProperties.Name="字体"
                                    Classes="toolbar-editor"
                                    IsEnabled="{CompiledBinding HasElement}"
                                    ItemsSource="{CompiledBinding FontFamilies}"
                                    PlaceholderText="微软雅黑"
                                    SelectedItem="{CompiledBinding #Root.FontFamilyName, Mode=TwoWay}"
                                    Width="145"
                                    x:Name="FontFamilyPicker">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="sys:String">
                                            <TextBlock
                                                Text="{CompiledBinding .}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{CompiledBinding .}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox
                                    AutomationProperties.Name="字号"
                                    Classes="toolbar-editor"
                                    IsEnabled="{CompiledBinding HasElement}"
                                    ItemsSource="{CompiledBinding FontSizes}"
                                    SelectedItem="{CompiledBinding #Root.FontSizeValue, Mode=TwoWay}"
                                    Width="91"
                                    x:Name="FontEditor" />
                            </StackPanel>
                        </Border>
                        <Border Padding="17,0,0,0" Width="166">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <ToggleButton
                                    AutomationProperties.Name="加粗"
                                    Classes="tool"
                                    IsChecked="{CompiledBinding SelectedElement.Bold, Mode=TwoWay}"
                                    IsEnabled="{CompiledBinding HasElement}"
                                    ToolTip.Tip="加粗"
                                    x:Name="BoldButton">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Bold"
                                        Width="20" />
                                </ToggleButton>
                                <ToggleButton
                                    AutomationProperties.Name="斜体"
                                    Classes="tool"
                                    IsChecked="{CompiledBinding SelectedElement.Italic, Mode=TwoWay}"
                                    IsEnabled="{CompiledBinding HasElement}"
                                    ToolTip.Tip="斜体"
                                    x:Name="ItalicButton">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Italic"
                                        Width="20" />
                                </ToggleButton>
                                <ToggleButton
                                    AutomationProperties.Name="下划线"
                                    Classes="tool"
                                    IsChecked="{CompiledBinding SelectedElement.Underline, Mode=TwoWay}"
                                    IsEnabled="{CompiledBinding HasElement}"
                                    ToolTip.Tip="下划线"
                                    x:Name="UnderlineButton">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Underline"
                                        Width="20" />
                                </ToggleButton>
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{DynamicResource One.Line}"
                            Height="30"
                            Width="1" />
                        <Border Padding="14,0,0,0" Width="215">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Button
                                    AutomationProperties.Name="文字左对齐"
                                    Classes="tool"
                                    Click="OnTextAlignment"
                                    Tag="Left"
                                    ToolTip.Tip="文字左对齐">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="AlignLeft"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="文字居中"
                                    Classes="tool"
                                    Click="OnTextAlignment"
                                    Tag="Center"
                                    ToolTip.Tip="文字居中">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="AlignCenter"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="文字右对齐"
                                    Classes="tool"
                                    Click="OnTextAlignment"
                                    Tag="Right"
                                    ToolTip.Tip="文字右对齐">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="AlignRight"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="文字两端对齐"
                                    Classes="tool"
                                    Click="OnTextAlignment"
                                    Tag="Justify"
                                    ToolTip.Tip="文字两端对齐">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="Justify"
                                        Width="20" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{DynamicResource One.Line}"
                            Height="30"
                            Width="1" />
                        <Border Padding="21,0,0,0" Width="139">
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <Button
                                    AutomationProperties.Name="项目符号列表"
                                    Classes="tool"
                                    Click="OnTextList"
                                    IsEnabled="{CompiledBinding HasBindableElement}"
                                    Tag="Bullet"
                                    ToolTip.Tip="项目符号列表">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="List"
                                        Width="20" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="勾选列表"
                                    Classes="tool"
                                    Click="OnTextList"
                                    IsEnabled="{CompiledBinding HasBindableElement}"
                                    Tag="Check"
                                    ToolTip.Tip="勾选列表">
                                    <one:ReportIcon
                                        Height="20"
                                        Kind="CheckBox"
                                        Width="20" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button
                            AutomationProperties.Name="边框"
                            Classes="tool"
                            IsEnabled="{CompiledBinding HasElement}"
                            ToolTip.Tip="边框"
                            Width="60"
                            x:Name="BorderMenuButton">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <one:ReportIcon
                                    Height="20"
                                    Kind="Table"
                                    Width="20" />
                                <one:ReportIcon
                                    Height="10"
                                    Kind="Chevron"
                                    Width="10" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel
                                        Spacing="10"
                                        Width="210"
                                        x:DataType="one:ReportDesignState">
                                        <TextBlock FontWeight="SemiBold" Text="边框" />
                                        <CheckBox
                                            Content="显示边框"
                                            IsChecked="{CompiledBinding SelectedElement.ShowBorder, Mode=TwoWay}"
                                            x:Name="BorderToggle" />
                                        <TextBlock Classes="caption" Text="文字 / 边框颜色" />
                                        <ColorPicker AutomationProperties.Name="边框颜色" Color="{CompiledBinding SelectedElement.Foreground, Mode=TwoWay, Converter={x:Static one:ReportColorConverter.Instance}}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button
                            AutomationProperties.Name="填充颜色"
                            Classes="tool"
                            IsEnabled="{CompiledBinding HasElement}"
                            Margin="4,0,0,0"
                            ToolTip.Tip="填充颜色"
                            Width="60"
                            x:Name="FillMenuButton">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <one:ReportIcon
                                    Height="20"
                                    Kind="Fill"
                                    Width="20" />
                                <one:ReportIcon
                                    Height="10"
                                    Kind="Chevron"
                                    Width="10" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel
                                        Spacing="10"
                                        Width="210"
                                        x:DataType="one:ReportDesignState">
                                        <TextBlock FontWeight="SemiBold" Text="填充颜色" />
                                        <ColorPicker
                                            AutomationProperties.Name="填充颜色值"
                                            Color="{CompiledBinding SelectedElement.Fill, Mode=TwoWay, Converter={x:Static one:ReportColorConverter.Instance}}"
                                            x:Name="ToolbarFillEditor" />
                                        <TextBlock
                                            Classes="caption"
                                            Text="支持颜色名称、#RRGGBB 和 Transparent"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <Grid ColumnDefinitions="1,30,33,14,44" Grid.Column="1">
                    <Border
                        Background="{DynamicResource One.Line}"
                        Height="30"
                        Width="1" />
                    <TextBlock
                        FontSize="14"
                        Grid.Column="2"
                        Text="吸附"
                        VerticalAlignment="Center" />
                    <ToggleSwitch
                        AutomationProperties.Name="吸附到毫米网格"
                        Grid.Column="4"
                        IsChecked="{CompiledBinding Snap, Mode=TwoWay}"
                        MinWidth="44"
                        OffContent=""
                        OnContent=""
                        Padding="0" />
                </Grid>
            </Grid>
        </Border>

        <Grid
            ColumnDefinitions="252,1,*,1,330"
            Grid.Row="2"
            RowDefinitions="Auto,*">
            <Border
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="0,0,0,1"
                Grid.Column="2"
                Grid.ColumnSpan="3">
                <TabControl
                    AutomationProperties.Name="设计与预览"
                    Classes="card"
                    Padding="0"
                    SelectedIndex="{CompiledBinding ViewTabIndex, Mode=TwoWay}"
                    one:TabFeatures.CanClose="False"
                    one:TabFeatures.CanReorder="False"
                    x:Name="ViewTabs">
                    <TabItem
                        Header="设计"
                        HorizontalContentAlignment="Center"
                        MinWidth="80"
                        x:Name="DesignTab" />
                    <TabItem
                        Header="预览"
                        HorizontalContentAlignment="Center"
                        MinWidth="80"
                        x:Name="PreviewTab" />
                </TabControl>
            </Border>
            <Border
                BorderThickness="0,0,1,0"
                Classes="divider"
                Grid.RowSpan="2">
                <Grid Margin="0,0,0,10" RowDefinitions="*">
                    <TabControl
                        AutomationProperties.Name="组件与数据"
                        Classes="card"
                        Padding="0"
                        one:TabFeatures.CanClose="False"
                        one:TabFeatures.CanReorder="False"
                        x:Name="SourceTabs">
                        <TabItem
                            Header="组件"
                            HorizontalContentAlignment="Center"
                            IsSelected="{CompiledBinding IsComponentsTab, Mode=OneWay}"
                            MinWidth="80"
                            x:Name="ComponentsTabButton">
                            <Border Padding="12,8">
                                <Grid RowDefinitions="Auto,*">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="section" Text="基础组件" />
                                        <UniformGrid
                                            Classes="palette"
                                            Columns="3">
                                            <Button
                                                Click="OnInsert"
                                                Tag="Text"
                                                x:Name="TextPalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Text" Width="14" Height="14" />
                                                    <TextBlock Text="文本" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="Table"
                                                x:Name="TablePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Table" Width="14" Height="14" />
                                                    <TextBlock Text="表格" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="Image"
                                                x:Name="ImagePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Image" Width="14" Height="14" />
                                                    <TextBlock Text="图片" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="Line"
                                                x:Name="LinePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Line" Width="14" Height="14" />
                                                    <TextBlock Text="线条" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="Rectangle"
                                                x:Name="RectanglePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Rectangle" Width="14" Height="14" />
                                                    <TextBlock Text="矩形" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="PageNumber"
                                                x:Name="PageNumberPalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="PageNumber" Width="14" Height="14" />
                                                    <TextBlock Text="页码" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="CheckBox"
                                                x:Name="CheckBoxPalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="CheckBoxElement" Width="14" Height="14" />
                                                    <TextBlock Text="复选框" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="Barcode"
                                                x:Name="BarcodePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="Barcode" Width="14" Height="14" />
                                                    <TextBlock Text="条码" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                Click="OnInsert"
                                                Tag="QRCode"
                                                x:Name="QRCodePalette">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <one:ReportIcon Kind="QRCode" Width="14" Height="14" />
                                                    <TextBlock Text="二维码" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                        <TextBlock
                                            Classes="caption"
                                            Text="拖入组件；选中后拖动边框调整大小。"
                                            TextWrapping="Wrap" />

                                    </StackPanel>
                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        RowDefinitions="Auto,*,Auto"
                                        RowSpacing="4">
                                        <TextBlock Classes="section" Text="报表结构" />
                                        <TreeView
                                            AutomationProperties.Name="报表结构"
                                            Background="Transparent"
                                            Grid.Row="1"
                                            ItemsSource="{CompiledBinding Structure}"
                                            Margin="0,4,0,0"
                                            MinHeight="0"
                                            SelectionChanged="OnStructureSelection"
                                            x:Name="StructureTree">
                                            <TreeView.Resources />
                                            <TreeView.Styles>
                                                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron.one-normal, TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron.one-small, TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron.one-large">
                                                    <Setter Property="Width" Value="24" />
                                                    <Setter Property="Height" Value="24" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                </Style>
                                                <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
                                                    <Setter Property="Margin" Value="0" />
                                                </Style>
                                                <Style Selector="TreeViewItem.one-normal, TreeViewItem.one-small, TreeViewItem.one-large" x:DataType="one:ReportStructureNode">
                                                    <Setter Property="IsExpanded" Value="{CompiledBinding Expanded}" />
                                                    <Setter Property="MinHeight" Value="28" />
                                                    <Setter Property="Padding" Value="0" />
                                                </Style>
                                            </TreeView.Styles>
                                            <TreeView.ItemTemplate>
                                                <TreeDataTemplate ItemsSource="{CompiledBinding Children}" x:DataType="one:ReportStructureNode">
                                                    <StackPanel
                                                        Margin="0,3"
                                                        Orientation="Horizontal"
                                                        Spacing="10">
                                                        <one:ReportIcon
                                                            Height="17"
                                                            Kind="{CompiledBinding Icon}"
                                                            Width="17" />
                                                        <TextBlock Text="{CompiledBinding Name}" />
                                                    </StackPanel>
                                                </TreeDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="4,10,0,6"
                                            Orientation="Horizontal"
                                            Spacing="10">
                                            <one:ReportIcon
                                                Height="17"
                                                Kind="Info"
                                                Width="17" />
                                            <TextBlock
                                                Classes="caption"
                                                MaxWidth="192"
                                                Text="拖入组件；点击结构节点定位元素。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>
                        <TabItem
                            Header="数据"
                            HorizontalContentAlignment="Center"
                            IsSelected="{CompiledBinding IsDataTab, Mode=TwoWay}"
                            MinWidth="84"
                            x:Name="DataTabButton">
                            <Border Padding="14,12">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                                    <TextBlock Classes="section" Text="数据源" />
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,8">
                                    <Button
                                        Click="OnFetchData"
                                        Content="＋ 添加数据源"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{CompiledBinding CanFetch}"
                                        x:Name="AddDataSourceButton" />
                                    <Button Grid.Column="1" Click="OnRefreshDataSource"
                                            x:Name="RefreshDataSourceButton"
                                            IsVisible="{CompiledBinding HasApiSource}"
                                            IsEnabled="{CompiledBinding CanFetch}" Padding="8"
                                            ToolTip.Tip="刷新数据源" AutomationProperties.Name="刷新数据源">
                                        <one:ReportIcon Kind="Refresh" Width="14" Height="14" />
                                    </Button>
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="2"
                                        Margin="0,0,0,8"
                                        Spacing="4">
                                        <TextBlock
                                            Classes="caption"
                                            Text="{CompiledBinding ApiUrl}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{CompiledBinding ApiUrl}" />
                                        <TextBlock
                                            Classes="caption"
                                            IsVisible="{CompiledBinding HasApiError}"
                                            Text="{CompiledBinding ApiStatus}"
                                            TextWrapping="Wrap"
                                            x:Name="ApiSourceStatus" />
                                    </StackPanel>
                                    <TextBox
                                        Grid.Row="3"
                                        Margin="0,0,0,8"
                                        PlaceholderText="搜索数据"
                                        TextChanged="OnSearch"
                                        styling:ControlSizing.Size="Small"
                                        x:Name="FieldSearch" />
                                    <TreeView
                                        AutomationProperties.Name="接口数据"
                                        Background="Transparent"
                                        Grid.Row="4"
                                        ItemsSource="{CompiledBinding DataNodes}"
                                        MinHeight="0"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.IsScrollChainingEnabled="False"
                                        styling:ControlSizing.Size="Small"
                                        x:Name="DataTree">
                                        <TreeView.ItemsPanel>
                                            <!--  A bounded JSON hierarchy uses one physical scroll viewport.  -->
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </TreeView.ItemsPanel>
                                        <TreeView.Styles>
                                            <Style Selector="TreeViewItem" x:DataType="report:ReportDataNode">
                                                <Setter Property="IsExpanded" Value="{CompiledBinding IsExpanded, Mode=TwoWay}" />
                                                <Setter Property="ItemsPanel">
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </Setter>
                                            </Style>
                                        </TreeView.Styles>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{CompiledBinding Children}" x:DataType="report:ReportDataNode">
                                                <Grid
                                                    ClipToBounds="True"
                                                    ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="8">
                                                    <ToolTip.Tip>
                                                        <StackPanel MaxWidth="360" Spacing="4">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Text="{CompiledBinding Name}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock Text="{CompiledBinding Pointer}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{CompiledBinding Preview}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip.Tip>
                                                    <one:ReportIcon
                                                        Kind="{CompiledBinding IconKind}"
                                                        Width="14" Height="14"
                                                        Foreground="{DynamicResource One.Accent}"
                                                        VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="3" Margin="0,3">
                                                        <TextBlock Text="{CompiledBinding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="caption" Text="{CompiledBinding Preview}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Classes="caption"
                                                        Grid.Column="2"
                                                        Text="{CompiledBinding TypeLabel}"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                </Grid>
            </Border>
            <GridSplitter
                Background="{DynamicResource One.Subtle}"
                Grid.Column="1"
                ResizeDirection="Columns" />
            <Grid
                Background="{DynamicResource One.Report.WorkspaceBackground}"
                Grid.Column="2"
                Grid.Row="1"
                RowDefinitions="*,Auto">
                <ScrollViewer
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    x:Name="PageScroll">
                    <one:ReportPageSurface
                        HorizontalAlignment="Center"
                        Margin="26,11,12,12"
                        VerticalAlignment="Top"
                        x:Name="PageSurface" />
                </ScrollViewer>
                <Border
                    Background="{DynamicResource One.Surface}"
                    Grid.Row="1"
                    IsVisible="{CompiledBinding IsPreview}"
                    Padding="8">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Click="OnPreviousPage"
                            Content="上一页"
                            IsEnabled="{CompiledBinding CanPrevious}"
                            x:Name="PreviousPageButton" />
                        <TextBlock Text="{CompiledBinding PageStatus}" VerticalAlignment="Center" />
                        <Button
                            Click="OnNextPage"
                            Content="下一页"
                            IsEnabled="{CompiledBinding CanNext}"
                            x:Name="NextPageButton" />
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter
                Background="{DynamicResource One.Subtle}"
                Grid.Column="3"
                Grid.Row="1"
                ResizeDirection="Columns" />
            <Border
                BorderThickness="1,0,0,0"
                Classes="divider inspector"
                Grid.Column="4"
                Grid.Row="1">
                <Grid RowDefinitions="Auto,*,32">
                    <StackPanel Margin="12,8,12,8" Spacing="8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="属性" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <one:ReportIcon
                                Height="24"
                                Kind="Table"
                                Width="24" />
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{CompiledBinding SelectionLabel}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TabControl
                        AutomationProperties.Name="元素属性"
                        Classes="card"
                        Grid.Row="1"
                        Padding="0"
                        SelectedIndex="{CompiledBinding PropertyTab, Mode=TwoWay}"
                        one:TabFeatures.CanClose="False"
                        one:TabFeatures.CanReorder="False"
                        x:Name="PropertyTabs">
                        <TabItem
                            Header="属性"
                            HorizontalContentAlignment="Center"
                            MinWidth="90"
                            x:Name="StylePropertiesTab">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <Border Padding="12,8,12,10">
                                    <StackPanel Spacing="6">
                                        <Expander Header="位置与尺寸 · mm" IsExpanded="False">
                                            <StackPanel Spacing="6">
                                                <Grid
                                                    ColumnDefinitions="*,100"
                                                    IsEnabled="{CompiledBinding HasElement}"
                                                    RowDefinitions="Auto,Auto,Auto,Auto">
                                                    <TextBlock Text="X" VerticalAlignment="Center" />
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8"
                                                        Maximum="297"
                                                        Minimum="0"
                                                        Value="{CompiledBinding SelectedElement.X, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="Y"
                                                        VerticalAlignment="Center" />
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Grid.Row="1"
                                                        Margin="0,0,0,8"
                                                        Maximum="420"
                                                        Minimum="0"
                                                        Value="{CompiledBinding SelectedElement.Y, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Row="2"
                                                        Text="宽度"
                                                        VerticalAlignment="Center" />
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Grid.Row="2"
                                                        Margin="0,0,0,8"
                                                        Maximum="297"
                                                        Minimum="8"
                                                        Value="{CompiledBinding SelectedElement.Width, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Grid.Row="3"
                                                        Text="高度"
                                                        VerticalAlignment="Center" />
                                                    <NumericUpDown
                                                        Grid.Column="1"
                                                        Grid.Row="3"
                                                        Maximum="420"
                                                        Minimum="2"
                                                        Value="{CompiledBinding SelectedElement.Height, Mode=TwoWay}" />
                                                </Grid>
                                                <Button
                                                    Click="OnDeleteElement"
                                                    Content="删除选中元素"
                                                    IsEnabled="{CompiledBinding HasElement}" />
                                            </StackPanel>
                                        </Expander>
                                        <StackPanel IsVisible="{CompiledBinding HasImageElement}" Spacing="10">
                                            <TextBlock Classes="section" Text="服务器图片" />
                                            <TextBox
                                                AutomationProperties.Name="图片网络地址"
                                                PlaceholderText="https://server/logo.png"
                                                Text="{CompiledBinding SelectedElement.ImageUrl, Mode=TwoWay}" />
                                            <Button Click="OnLoadRemoteImage" Content="加载网络图片" />
                                            <TextBlock Classes="section" Text="图片" />
                                            <Button
                                                Click="OnChooseImage"
                                                Content="选择 / 替换图片…"
                                                x:Name="ChooseImageButton" />
                                            <TextBlock
                                                Classes="caption"
                                                Text="{CompiledBinding SelectedElement.ImageName}"
                                                TextWrapping="Wrap" />
                                            <ComboBox
                                                AutomationProperties.Name="图片缩放方式"
                                                SelectedIndex="{CompiledBinding #Root.ImageFitIndex, Mode=TwoWay}"
                                                x:Name="ImageFitPicker">
                                                <ComboBoxItem Content="等比适应" />
                                                <ComboBoxItem Content="等比填充（裁剪）" />
                                                <ComboBoxItem Content="拉伸填充" />
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Classes="section" Text="元素名称" />
                                        <TextBox IsEnabled="{CompiledBinding HasElement}" Text="{CompiledBinding SelectedElement.Name, Mode=TwoWay}" />
                                        <TextBlock
                                            Classes="section"
                                            IsVisible="{CompiledBinding HasTextElement}"
                                            Text="内容 / 标签" />
                                        <TextBox
                                            AcceptsReturn="True"
                                            IsVisible="{CompiledBinding HasTextElement}"
                                            MinHeight="64"
                                            Text="{CompiledBinding SelectedElement.Text, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            x:Name="ElementTextEditor" />
                                        <CheckBox
                                            Content="默认勾选（绑定字段优先）"
                                            IsChecked="{CompiledBinding SelectedElement.IsChecked, Mode=TwoWay}"
                                            IsVisible="{CompiledBinding HasCheckBoxElement}"
                                            x:Name="ElementCheckedEditor" />
                                        <StackPanel IsVisible="{CompiledBinding HasBarcodeElement}" Spacing="6">
                                            <TextBlock
                                                Classes="caption"
                                                Text="Code 128 · 支持英文、数字和常用 ASCII 符号（1–128 字符）"
                                                TextWrapping="Wrap" />
                                            <CheckBox
                                                Content="显示条码文字"
                                                IsChecked="{CompiledBinding SelectedElement.BarcodeShowText, Mode=TwoWay}"
                                                x:Name="BarcodeTextToggle" />
                                        </StackPanel>
                                        <StackPanel IsVisible="{CompiledBinding HasQRCodeElement}" Spacing="6">
                                            <TextBlock Classes="section" Text="二维码" />
                                            <TextBlock Classes="caption"
                                                Text="支持中文、链接和字段绑定；黑白矢量绘制，静区至少 4 模块。Low / Medium / Quartile / High 为四档纠错等级。"
                                                TextWrapping="Wrap" />
                                            <TextBlock Text="纠错等级" />
                                            <ComboBox ItemsSource="{CompiledBinding QRCodeLevels}"
                                                SelectedItem="{CompiledBinding SelectedElement.QRCodeErrorCorrection, Mode=TwoWay}"
                                                x:Name="QRCodeCorrectionEditor" />
                                            <TextBlock Text="静区（模块）" />
                                            <NumericUpDown Minimum="4" Maximum="32" Increment="1"
                                                Value="{CompiledBinding SelectedElement.QRCodeQuietZone, Mode=TwoWay}"
                                                x:Name="QRCodeQuietZoneEditor" />
                                            <Button Content="恢复静态内容" Click="OnClearBinding"
                                                HorizontalAlignment="Left" x:Name="QRCodeClearBindingButton"
                                                ToolTip.Tip="清除字段绑定，恢复内容编辑框中的静态文本。" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,90">
                                            <TextBlock Text="字号" VerticalAlignment="Center" />
                                            <NumericUpDown
                                                Grid.Column="1"
                                                IsEnabled="{CompiledBinding HasElement}"
                                                Maximum="150"
                                                Minimum="6"
                                                Value="{CompiledBinding #Root.FontSizeValue, Mode=TwoWay}" />
                                        </Grid>
                                        <CheckBox
                                            Content="加粗"
                                            IsChecked="{CompiledBinding SelectedElement.Bold, Mode=TwoWay}"
                                            IsEnabled="{CompiledBinding HasElement}" />
                                        <TextBlock Text="文字 / 线条颜色" />
                                        <ColorPicker Color="{CompiledBinding SelectedElement.Foreground, Mode=TwoWay, Converter={x:Static one:ReportColorConverter.Instance}}" IsEnabled="{CompiledBinding HasElement}" />
                                        <TextBlock Text="填充颜色" />
                                        <ColorPicker Color="{CompiledBinding SelectedElement.Fill, Mode=TwoWay, Converter={x:Static one:ReportColorConverter.Instance}}" IsEnabled="{CompiledBinding HasElement}" />
                                        <CheckBox
                                            Content="显示边框"
                                            IsChecked="{CompiledBinding SelectedElement.ShowBorder, Mode=TwoWay}"
                                            IsEnabled="{CompiledBinding HasElement}" />
                                        <StackPanel IsVisible="{CompiledBinding HasTableColumn}" Spacing="8">
                                            <TextBlock Classes="section" Text="表格列标题" />
                                            <TextBox Text="{CompiledBinding SelectedColumn.Header, Mode=TwoWay}" x:Name="HeaderEditor" />
                                            <TextBlock Text="静态单元格内容" />
                                            <TextBox Text="{CompiledBinding SelectedColumn.Text, Mode=TwoWay}" />
                                            <Grid ColumnDefinitions="*,90">
                                                <TextBlock Text="列宽权重" VerticalAlignment="Center" />
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Increment="0.25"
                                                    Maximum="10000"
                                                    Minimum="0.001"
                                                    Value="{CompiledBinding SelectedColumn.WidthWeight, Mode=TwoWay}" />
                                            </Grid>
                                            <Button
                                                Click="OnAddColumn"
                                                Content="添加列"
                                                x:Name="AddColumnButton" />
                                            <Button Click="OnRemoveColumn" Content="删除此列" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem
                            Header="数据"
                            HorizontalContentAlignment="Center"
                            MinWidth="90"
                            x:Name="DataPropertiesTab">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                <Border Padding="12,8,12,10">
                                    <StackPanel Spacing="0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Margin="0,2,0,16"
                                            Text="▾  数据绑定" />
                                        <Grid
                                            ColumnDefinitions="82,*"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="6">
                                            <TextBlock Text="数据源" VerticalAlignment="Center" />
                                            <Border
                                                BorderBrush="{DynamicResource One.Line}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Grid.Column="1"
                                                Padding="12,8">
                                                <TextBlock Text="{CompiledBinding SourceName}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="字段"
                                                VerticalAlignment="Center" />
                                            <ComboBox
                                                AutomationProperties.Name="绑定字段"
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                IsEnabled="{CompiledBinding HasBindableElement}"
                                                ItemsSource="{CompiledBinding #Root.SourceFields}"
                                                SelectedItem="{CompiledBinding #Root.SelectedField, Mode=TwoWay}"
                                                x:Name="BindingPicker">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="report:ReportFieldInfo">
                                                        <TextBlock Text="{CompiledBinding Key}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="2"
                                                Text="表达式"
                                                VerticalAlignment="Center" />
                                            <Grid
                                                ColumnDefinitions="*,38"
                                                ColumnSpacing="8"
                                                Grid.Column="1"
                                                Grid.Row="2">
                                                <TextBox
                                                    Classes="expression"
                                                    IsReadOnly="True"
                                                    Text="{CompiledBinding BindingStatus}"
                                                    ToolTip.Tip="{CompiledBinding BindingStatus}" />
                                                <Button
                                                    AutomationProperties.Name="选择绑定字段表达式"
                                                    Click="OnOpenFieldPicker"
                                                    Content="ƒx"
                                                    FontSize="18"
                                                    FontStyle="Italic"
                                                    Grid.Column="1"
                                                    IsEnabled="{CompiledBinding HasBindableElement}"
                                                    Padding="6,3"
                                                    ToolTip.Tip="选择绑定字段"
                                                    x:Name="BindFieldButton" />
                                            </Grid>
                                        </Grid>
                                        <StackPanel IsVisible="{CompiledBinding HasTableColumn}" Spacing="0">
                                            <Separator Margin="0,10,0,8" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Margin="0,0,0,16"
                                                Text="▾  显示格式" />
                                            <Grid
                                                ColumnDefinitions="82,*"
                                                RowDefinitions="Auto,Auto,Auto,Auto"
                                                RowSpacing="6">
                                                <TextBlock Text="类型" VerticalAlignment="Center" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    SelectedIndex="{CompiledBinding #Root.FormatIndex, Mode=TwoWay}"
                                                    x:Name="FormatPicker">
                                                    <ComboBoxItem Content="自动" />
                                                    <ComboBoxItem Content="文本" />
                                                    <ComboBoxItem Content="数字" />
                                                    <ComboBoxItem Content="货币" />
                                                    <ComboBoxItem Content="日期" />
                                                </ComboBox>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="小数位数"
                                                    VerticalAlignment="Center" />
                                                <NumericUpDown
                                                    Grid.Column="1"
                                                    Grid.Row="1"
                                                    Maximum="8"
                                                    Minimum="0"
                                                    Value="{CompiledBinding SelectedColumn.DecimalPlaces, Mode=TwoWay}"
                                                    x:Name="DecimalEditor" />
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Text="千分位"
                                                    VerticalAlignment="Center" />
                                                <CheckBox
                                                    Classes="compact"
                                                    Content="使用千分位分隔符"
                                                    FontSize="12"
                                                    Grid.Column="1"
                                                    Grid.Row="2"
                                                    IsChecked="{CompiledBinding SelectedColumn.UseThousandsSeparator, Mode=TwoWay}" />
                                                <TextBlock
                                                    Grid.Row="3"
                                                    Text="格式预览"
                                                    VerticalAlignment="Center" />
                                                <Border
                                                    Background="{DynamicResource One.Report.PreviewBackground}"
                                                    CornerRadius="4"
                                                    Grid.Column="1"
                                                    Grid.Row="3"
                                                    Padding="12,8">
                                                    <TextBlock Text="{CompiledBinding FormatSample}" />
                                                </Border>
                                            </Grid>
                                            <Separator Margin="0,10,0,8" />
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Margin="0,0,0,16"
                                                Text="▾  汇总" />
                                            <Grid ColumnDefinitions="82,*">
                                                <TextBlock Text="汇总方式" VerticalAlignment="Center" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    SelectedIndex="{CompiledBinding #Root.SumIndex, Mode=TwoWay}"
                                                    x:Name="SumPicker">
                                                    <ComboBoxItem Content="无" />
                                                    <ComboBoxItem Content="求和（末页）" />
                                                </ComboBox>
                                            </Grid>
                                            <CheckBox
                                                Content="末页显示此列合计"
                                                IsChecked="{CompiledBinding SelectedColumn.ShowSum, Mode=TwoWay}"
                                                IsVisible="False"
                                                x:Name="SumEditor" />
                                        </StackPanel>
                                        <Separator Margin="0,10,0,8" />
                                        <Expander
                                            Classes="condition"
                                            IsExpanded="False"
                                            IsVisible="{CompiledBinding HasTableColumn}"
                                            x:Name="ConditionalStylesExpander">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <one:ReportIcon
                                                        Classes="disclosure"
                                                        Height="10"
                                                        Kind="Disclosure"
                                                        Width="10" />
                                                    <TextBlock FontWeight="SemiBold" Text="条件样式" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <StackPanel Margin="0,10" Spacing="10">
                                                <CheckBox
                                                    Content="启用数字条件"
                                                    IsChecked="{CompiledBinding SelectedColumn.ConditionEnabled, Mode=TwoWay}"
                                                    x:Name="ConditionToggle" />
                                                <ComboBox AutomationProperties.Name="数字条件比较方式" SelectedIndex="{CompiledBinding #Root.ConditionIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="大于" />
                                                    <ComboBoxItem Content="小于" />
                                                    <ComboBoxItem Content="等于" />
                                                </ComboBox>
                                                <NumericUpDown
                                                    AutomationProperties.Name="条件阈值"
                                                    Maximum="1000000000000000"
                                                    Minimum="-1000000000000000"
                                                    Value="{CompiledBinding SelectedColumn.ConditionValue, Mode=TwoWay}" />
                                                <TextBlock Classes="caption" Text="满足条件时的文字颜色" />
                                                <ColorPicker AutomationProperties.Name="条件文字颜色" Color="{CompiledBinding SelectedColumn.ConditionColor, Mode=TwoWay, Converter={x:Static one:ReportColorConverter.Instance}}" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </TabItem>

                    </TabControl>
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource One.Accent}"
                        Grid.Row="2"
                        Margin="18,0"
                        Text="{CompiledBinding BindingSummary}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <Border
            BorderThickness="0,1,0,0"
            Classes="divider"
            Grid.Row="3"
            Padding="20,3">
            <Grid ColumnDefinitions="318,*,Auto,140,Auto,Auto,Auto">
                <TextBlock
                    Classes="caption"
                    Text="{CompiledBinding PaperLabel}"
                    VerticalAlignment="Center" />
                <TextBlock
                    Classes="caption"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Margin="22,0"
                    Text="{CompiledBinding StatusDisplay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{CompiledBinding Status}"
                    VerticalAlignment="Center"
                    x:Name="StatusText" />
                <Button
                    AutomationProperties.Name="缩小"
                    Classes="tool"
                    Click="OnZoomOut"
                    Grid.Column="2"
                    ToolTip.Tip="缩小">
                    <one:ReportIcon
                        Height="14"
                        Kind="Minus"
                        Width="14" />
                </Button>
                <Slider
                    Grid.Column="3"
                    Margin="8,0"
                    Maximum="1.5"
                    Minimum="0.35"
                    Value="{CompiledBinding Zoom, Mode=TwoWay}"
                    x:Name="ZoomSlider" />
                <Button
                    AutomationProperties.Name="放大"
                    Classes="tool"
                    Click="OnZoomIn"
                    Grid.Column="4"
                    ToolTip.Tip="放大">
                    <one:ReportIcon
                        Height="14"
                        Kind="Plus"
                        Width="14" />
                </Button>
                <TextBlock
                    Grid.Column="5"
                    Text="{CompiledBinding ZoomLabel}"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    Width="64" />
                <Button
                    AutomationProperties.Name="适合页面"
                    Classes="tool"
                    Click="OnFitPage"
                    Grid.Column="6"
                    ToolTip.Tip="适合页面">
                    <one:ReportIcon Kind="Fit" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
