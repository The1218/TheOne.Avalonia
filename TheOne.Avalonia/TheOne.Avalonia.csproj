<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../PackageVersions.props" />

    <PropertyGroup>
        <Version>$(TheOnePackageVersion)</Version>
        <PackageVersion>$(TheOnePackageVersion)</PackageVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageDescription>TheOne themes and extended controls for Avalonia, with native DataGrid filtering, frozen columns and numeric summaries.</PackageDescription>
        <PackageReleaseNotes>Adds Form/FormItem, searchable virtualized MultiSelectBox, enum-based theme color switching, bindable ThemeColorPicker and palette gradients. Improves theme refresh and NavMenu reverse scrolling performance. Fixes input borders, item spacing, selection states, calendar layout and DataGrid filter indicators. Expands bilingual control/window-owner documentation and PreviewHost Home, code and print examples. Requires .NET 10 and Avalonia 12.1.4; upgrade TheOne.Avalonia.DataGrid to the same preview version.</PackageReleaseNotes>
        <WarningsAsErrors>$(WarningsAsErrors);NU5104</WarningsAsErrors>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaVersion>12.1.4</AvaloniaVersion>
        <DataGridVersion>12.1.2</DataGridVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../vendor/Avalonia.Controls.DataGrid/Avalonia.Controls.DataGrid.csproj" />
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
        <None Include="../LICENSE" Pack="true" PackagePath="" />
        <None Update="PACKAGE.md" Pack="true" PackagePath="README.md" />
    </ItemGroup>

</Project>
