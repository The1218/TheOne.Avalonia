<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../PackageVersions.props"/>

    <PropertyGroup>
        <Version>$(TheOnePackageVersion)</Version>
        <PackageVersion>$(TheOnePackageVersion)</PackageVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageDescription>TheOne themes and extended controls for Avalonia, with native DataGrid filtering, frozen columns and numeric summaries.</PackageDescription>
        <PackageReleaseNotes>Adds OneIcon with 320 vectors in 20 categories, Breadcrumb navigation, DateTimePicker and Timeline event history. Optimizes the icon gallery with recycled native buttons and cached text layout; desktop scrolling p95 improved from 33.48ms to 17.46ms in the documented macOS workload. Includes icon variants, observable models, compiled-binding templates, theme/window updates, independent previews and bilingual guides. Requires .NET 10 and Avalonia 12.1.4; upgrade both TheOne packages to preview.8. NuGet upload is manual.</PackageReleaseNotes>
        <WarningsAsErrors>$(WarningsAsErrors);NU5104</WarningsAsErrors>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaVersion>12.1.4</AvaloniaVersion>
        <DataGridVersion>12.1.2</DataGridVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../vendor/Avalonia.Controls.DataGrid/Avalonia.Controls.DataGrid.csproj"/>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath=""/>
        <None Include="../LICENSE" Pack="true" PackagePath=""/>
        <None Update="PACKAGE.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

</Project>
