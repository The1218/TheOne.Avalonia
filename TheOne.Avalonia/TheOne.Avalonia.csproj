<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../PackageVersions.props"/>

    <PropertyGroup>
        <Version>$(TheOnePackageVersion)</Version>
        <PackageVersion>$(TheOnePackageVersion)</PackageVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageDescription>TheOne themes and extended controls for Avalonia, with native DataGrid filtering, frozen columns and numeric summaries.</PackageDescription>
        <PackageReleaseNotes>Adds TreeSelect with stable-key single/multiple selection, cascading checks, typed model adapters, ancestor-preserving search and virtualized rows. Separates semantic colors and appearances for Button, ToggleButton, RepeatButton and IconButton while preserving native interactions. Adds Tag variants and fixes dynamic style cleanup, TabControl compact content/template switching, and ColorPicker Custom popup sizing. Includes bilingual guides, migration notes and previews. Requires .NET 10 and Avalonia 12.1.4; upgrade both TheOne packages to preview.7. NuGet upload is manual.</PackageReleaseNotes>
        <WarningsAsErrors>$(WarningsAsErrors);NU5104</WarningsAsErrors>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaVersion>12.1.4</AvaloniaVersion>
        <DataGridVersion>12.1.2</DataGridVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../vendor/Avalonia.Controls.DataGrid/Avalonia.Controls.DataGrid.csproj"/>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)"/>
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath=""/>
        <None Include="../LICENSE" Pack="true" PackagePath=""/>
        <None Update="PACKAGE.md" Pack="true" PackagePath="README.md"/>
    </ItemGroup>

</Project>
