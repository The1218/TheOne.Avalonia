<UserControl
    Name="AuditRoot"
    x:Class="TheOne.NativeAotSmoke.AuditView"
    x:CompileBindings="True"
    x:DataType="local:AuditModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.NativeAotSmoke"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector=":is(one|ChartBase).consumer-chart" x:DataType="local:AuditModel">
            <Setter Property="Height" Value="220" />
            <Setter Property="Title" Value="Compiled consumer chart" />
            <Setter Property="SeriesSource" Value="{Binding ChartSeries}" />
            <Setter Property="SelectedSeriesIndex" Value="{Binding ChartSeriesIndex, Mode=TwoWay}" />
            <Setter Property="SelectedIndex" Value="{Binding ChartPointIndex, Mode=TwoWay}" />
            <Setter Property="Viewport" Value="{Binding ChartViewport, Mode=TwoWay}" />
            <Setter Property="NavigationAxes" Value="{Binding ChartAxes}" />
            <Setter Property="IsZoomEnabled" Value="True" />
            <Setter Property="IsPanEnabled" Value="True" />
            <Setter Property="SamplingMode" Value="{Binding ChartSamplingMode}" />
            <Setter Property="SamplingPointBudget" Value="{Binding ChartSamplingBudget}" />
            <Setter Property="SecondaryUnit" Value="人" />
            <Setter Property="SecondaryValueFormat" Value="0" />
            <Setter Property="SecondaryYAxisTitle" Value="{Binding ChartSecondaryTitle}" />
            <Setter Property="ShowCrosshair" Value="{Binding ChartCrosshair}" />
            <Setter Property="TooltipMode" Value="{Binding ChartTooltipMode}" />
            <Setter Property="IsLegendInteractive" Value="{Binding ChartLegendInteractive}" />
            <Setter Property="IsSmooth" Value="{Binding ChartSmooth}" />
            <Setter Property="IsAnimationEnabled" Value="{Binding ChartAnimateUpdates}" />
            <Setter Property="AnimationDuration" Value="{Binding ChartAnimationDuration}" />
        </Style>
    </UserControl.Styles>
    <Grid
        ColumnDefinitions="*,*"
        ColumnSpacing="16"
        Margin="16">
        <StackPanel Spacing="8">
            <TextBox
                Classes="clearButton"
                Name="Editor"
                Text="{Binding Draft, Mode=TwoWay}" />
            <WrapPanel>
                <Button
                    Command="{Binding ApplyCommand}"
                    Content="Apply"
                    Name="Action" />
                <RepeatButton Command="{Binding ApplyCommand}" Content="Repeat" />
                <ToggleButton Content="Toggle" IsChecked="{Binding Selected, Mode=TwoWay}" />
                <SplitButton
                    Command="{Binding ApplyCommand}"
                    Content="Split"
                    Name="Split">
                    <SplitButton.Flyout>
                        <Flyout>
                            <TextBlock Text="{Binding Draft}" />
                        </Flyout>
                    </SplitButton.Flyout>
                </SplitButton>
                <ToggleSplitButton Content="Toggle split" IsChecked="{Binding Selected, Mode=TwoWay}" />
            </WrapPanel>
            <WrapPanel>
                <CheckBox
                    Content="Checked"
                    IsChecked="{Binding Selected, Mode=TwoWay}"
                    Name="Check" />
                <RadioButton Content="Radio" IsChecked="{Binding Selected}" />
                <ToggleSwitch Content="Switch" IsChecked="{Binding Selected, Mode=TwoWay}" />
            </WrapPanel>
            <NumericUpDown Name="Number" Value="{Binding Number, Mode=TwoWay}" />
            <Slider Name="Range" Value="{Binding Range, Mode=TwoWay}" />
            <ProgressBar
                Name="Progress"
                ShowProgressText="True"
                Value="{Binding Range}" />
            <ComboBox
                ItemsSource="{Binding Rows}"
                Name="Choices"
                SelectedItem="{Binding Choice, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <AutoCompleteBox
                ItemsSource="{Binding Suggestions}"
                Name="Suggestions"
                Text="{Binding Draft, Mode=TwoWay}" />
            <CalendarDatePicker
                Name="Date"
                SelectedDate="{Binding Date, Mode=TwoWay}"
                one:CalendarOptions.DisplayStyle="DateTime"
                one:CalendarOptions.Format="yyyy-MM-dd HH:mm"
                one:CalendarOptions.Time="{Binding Time, Mode=TwoWay}" />
            <DatePicker Name="DateParts" SelectedDate="{Binding OffsetDate, Mode=TwoWay}" />
            <TimePicker Name="TimeParts" SelectedTime="{Binding Time, Mode=TwoWay}" />
            <Label Content="Editor" Target="{Binding #Editor}" />
            <SelectableTextBlock Name="Selectable" Text="{Binding Draft}" />
            <Separator />
            <Expander
                Header="Expand"
                IsExpanded="{Binding Expanded, Mode=TwoWay}"
                Name="Reveal">
                <TextBlock Text="{Binding Draft}" />
            </Expander>
            <SplitView
                DisplayMode="Inline"
                Height="80"
                IsPaneOpen="{Binding Expanded, Mode=TwoWay}"
                Name="Pane"
                OpenPaneLength="100">
                <SplitView.Pane>
                    <TextBlock Text="Pane" />
                </SplitView.Pane>
                <TextBlock Text="Content" />
            </SplitView>
            <Grid ColumnDefinitions="*,6,*" Height="50">
                <Border Background="{DynamicResource One.Subtle}" />
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                <Border Background="{DynamicResource One.AccentSoft}" Grid.Column="2" />
            </Grid>
            <TransitioningContentControl
                Content="{Binding Page}"
                Height="60"
                Name="Transition">
                <TransitioningContentControl.ContentTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </TransitioningContentControl.ContentTemplate>
            </TransitioningContentControl>
            <Button Content="Flyout" Name="FlyoutButton">
                <Button.Flyout>
                    <Flyout>
                        <TextBlock Text="{Binding Draft}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8">
            <Menu Name="Commands">
                <MenuItem Header="File">
                    <MenuItem Command="{Binding ApplyCommand}" Header="Apply" />
                    <MenuItem
                        Header="Selected"
                        IsChecked="{Binding Selected, Mode=TwoWay}"
                        ToggleType="CheckBox" />
                </MenuItem>
            </Menu>
            <ListBox
                Height="120"
                ItemsSource="{Binding Rows}"
                Name="Records"
                SelectedItem="{Binding Choice, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding ApplyCommand}" Header="Apply" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            <TreeView
                Height="120"
                ItemsSource="{Binding Roots}"
                Name="Tree">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="local:AuditRow">
                        <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
            </TreeView>
            <TabControl
                Classes="card"
                Height="110"
                ItemsSource="{Binding Rows}"
                Name="Tabs"
                one:TabFeatures.CanClose="True"
                one:TabFeatures.CanReorder="True">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
            <TabStrip
                Height="44"
                ItemsSource="{Binding Suggestions}"
                Name="Strip" />
            <Carousel
                Height="60"
                ItemsSource="{Binding Rows}"
                Name="Carousel">
                <Carousel.ItemTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </Carousel.ItemTemplate>
            </Carousel>
            <RefreshContainer Height="100" Name="Refresh">
                <ListBox ItemsSource="{Binding Rows}" />
            </RefreshContainer>
            <ItemsControl
                Height="60"
                ItemsSource="{Binding Rows}"
                Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:AuditRow">
                        <TextBlock Text="{Binding Caption}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DataGrid
                AutoGenerateColumns="False"
                Height="180"
                ItemsSource="{Binding Rows}"
                MaxColumnWidth="240"
                Name="Table">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Caption, Mode=TwoWay}" Header="Caption" />
                    <DataGridCheckBoxColumn Binding="{Binding Expanded, Mode=TwoWay}" Header="Expanded" />
                </DataGrid.Columns>
            </DataGrid>
            <ComboBox
                ItemsSource="{Binding ChartAxisOptions}"
                Name="ConsumerSeriesAxis"
                SelectedItem="{Binding ChartSeries[1].YAxis, Mode=TwoWay}" />
            <ContentControl Content="{Binding #AuditRoot.CurrentChart}" Name="ConsumerChartHost" />
            <TextBlock Name="ConsumerHoverCount" Text="{Binding #AuditRoot.CurrentChart.HoveredPoints.Count, StringFormat='Hover models: {0}'}" />
            <one:GaugeChart
                GaugeStyle="{Binding GaugeStyle}"
                Height="140"
                Name="ConsumerGauge"
                ShowGaugeNeedle="{Binding ChartGaugeNeedle}"
                ShowGaugeTicks="{Binding ChartGaugeTicks}"
                Title="Compiled gauge"
                Unit="%"
                Value="{Binding Range}">
                <one:GaugeChart.GaugeSegments>
                    <one:GaugeSegment
                        Brush="#FF6E76"
                        Fraction="0.25"
                        Label="Grade D" />
                    <one:GaugeSegment
                        Brush="#FDDD60"
                        Fraction="0.5"
                        Label="Grade C" />
                    <one:GaugeSegment
                        Brush="#58D9F9"
                        Fraction="0.75"
                        Label="Grade B" />
                    <one:GaugeSegment
                        Brush="#7CFFB2"
                        Fraction="1"
                        Label="Grade A" />
                </one:GaugeChart.GaugeSegments>
            </one:GaugeChart>
        </StackPanel>
    </Grid>
</UserControl>