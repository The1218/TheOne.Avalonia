<UserControl
    x:Class="TheOne.DesignPreview.ChartShowcaseView"
    x:DataType="local:PreviewPageDescriptor"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="StackPanel.chart-variant">
            <Setter Property="Width" Value="300" />
        </Style>
        <Style Selector="StackPanel.chart-variant.one-small">
            <Setter Property="Width" Value="240" />
        </Style>
        <Style Selector="StackPanel.chart-variant.one-large">
            <Setter Property="Width" Value="360" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="{CompiledBinding Title}" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="同一图表的多种样式 · 可点击数据和图例 · 使用顶部工具栏切换主题、尺寸和动效"
            TextWrapping="Wrap" />
        <WrapPanel Name="Variants" />
        <Expander Header="交互与数据实验" Name="Editor" />
    </StackPanel>
</UserControl>
