<UserControl
    x:Class="TheOne.DesignPreview.DataGridBindingDemoView"
    x:DataType="local:DataGridBindingDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="集合绑定与单元格操作 / 千条数据" />
        <WrapPanel>
            <Button
                Command="{CompiledBinding UseListCommand}"
                Content="List 源"
                Margin="0,0,8,4"
                Name="UseList" />
            <Button
                Command="{CompiledBinding UseObservableCommand}"
                Content="ObservableCollection 源"
                Margin="0,0,8,4"
                Name="UseObservable" />
            <Button
                Command="{CompiledBinding AddCommand}"
                Content="新增一项"
                IsEnabled="{CompiledBinding CanAdd}"
                Margin="0,0,0,4"
                Name="AddRow" />
        </WrapPanel>
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource One.Muted}"
            Text="{CompiledBinding SourceLabel}"
            TextWrapping="Wrap" />
        <DataGrid
            AutoGenerateColumns="False"
            Height="240"
            ItemsSource="{CompiledBinding Rows}"
            MaxColumnWidth="280"
            Name="CollectionGrid"
            SelectedItem="{CompiledBinding Selected, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{CompiledBinding Id}"
                    Header="编号"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Binding="{CompiledBinding Name, Mode=TwoWay}"
                    Header="设备"
                    Width="*" />
                <DataGridCheckBoxColumn Binding="{CompiledBinding Enabled, Mode=TwoWay}" Header="启用" />

                <DataGridTemplateColumn CanUserSort="False" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Command="{CompiledBinding $parent[local:DataGridBindingDemoView].Model.InspectCommand}"
                                CommandParameter="{CompiledBinding}"
                                Content="查看" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn CanUserSort="False" Header="标记">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton Content="标记" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource One.Accent}"
            Text="{CompiledBinding ActionLabel}" />
        <TextBlock
            FontSize="12"
            Foreground="{DynamicResource One.Muted}"
            Text="列头按钮：未排序 → 升序 → 降序 → 未排序；Shift 多列排序并显示优先级，Ctrl／⌘ 清除。三种尺寸下操作按钮和复选框均应完整显示。"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
