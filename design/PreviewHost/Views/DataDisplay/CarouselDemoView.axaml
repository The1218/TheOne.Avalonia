<UserControl
    x:Class="TheOne.DesignPreview.CarouselDemoView"
    x:CompileBindings="True"
    x:DataType="local:CarouselDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="Carousel · 内容轮播" />
            <TextBlock Classes="helper" Text="1,000 项数据，按需创建页面。切换顶部主题和尺寸，使用按钮、方向键或拖动浏览。" />
        </StackPanel>
        <WrapPanel>
            <CheckBox
                Content="允许拖动"
                IsChecked="{CompiledBinding Swipe, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="EnableSwipe" />
            <CheckBox
                Content="循环切换"
                IsChecked="{CompiledBinding Wrap, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="WrapPages" />
            <CheckBox
                Content="过渡效果"
                IsChecked="{CompiledBinding Animate, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="AnimatePages" />
            <CheckBox
                Content="启用轮播"
                IsChecked="{CompiledBinding Enabled, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="EnableCarousel" />
            <ComboBox
                AutomationProperties.Name="页面显示比例"
                Margin="0,0,0,8"
                Name="ViewportPicker"
                SelectedIndex="{CompiledBinding ViewportIndex, Mode=TwoWay}"
                Width="160">
                <ComboBoxItem Content="完整页面" />
                <ComboBoxItem Content="显示相邻页面" />
            </ComboBox>
        </WrapPanel>
        <Carousel
            AutomationProperties.Name="一千项内容轮播"
            Height="340"
            IsEnabled="{CompiledBinding Enabled}"
            IsSwipeEnabled="{CompiledBinding Swipe}"
            ItemsSource="{CompiledBinding Slides}"
            Name="CarouselSample"
            SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
            ViewportFraction="{CompiledBinding ViewportFraction}"
            WrapSelection="{CompiledBinding Wrap}">
            <Carousel.ItemTemplate>
                <DataTemplate x:DataType="local:CarouselSlide">
                    <Border
                        Background="{DynamicResource One.Subtle}"
                        CornerRadius="12"
                        Margin="4"
                        Padding="16">
                        <Grid ColumnDefinitions="112,20,*" VerticalAlignment="Center">
                            <Border
                                Background="{DynamicResource One.AccentSoft}"
                                CornerRadius="12"
                                Grid.Column="0"
                                Height="128"
                                VerticalAlignment="Center"
                                Width="112">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource One.Accent}"
                                        HorizontalAlignment="Center"
                                        LetterSpacing="2"
                                        Text="PAGE" />
                                    <TextBlock
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource One.Accent}"
                                        HorizontalAlignment="Center"
                                        Text="{CompiledBinding Number, StringFormat='{}{0:0000}'}" />
                                </StackPanel>
                            </Border>
                            <StackPanel
                                Grid.Column="2"
                                Spacing="12"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource One.Muted}"
                                    Text="{CompiledBinding Category}" />
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Name="SlideTitle"
                                    Text="{CompiledBinding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Name="SlideDescription"
                                    Text="{CompiledBinding Description}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Command="{CompiledBinding $parent[local:CarouselDemoView].Model.SlideActionCommand}"
                                    CommandParameter="{CompiledBinding}"
                                    Content="查看详情"
                                    HorizontalAlignment="Left"
                                    Name="SlideAction" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </Carousel.ItemTemplate>
        </Carousel>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button
                Command="{CompiledBinding PreviousCommand}"
                Content="上一页"
                IsEnabled="{CompiledBinding CanPrevious}"
                Name="PreviousPage" />
            <TextBlock
                FontWeight="SemiBold"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Name="PagePosition"
                Text="{CompiledBinding Position}"
                VerticalAlignment="Center" />
            <Button
                Command="{CompiledBinding NextCommand}"
                Content="下一页"
                Grid.Column="2"
                IsEnabled="{CompiledBinding CanNext}"
                Name="NextPage" />
        </Grid>
        <Separator />
        <WrapPanel>
            <NumericUpDown
                AutomationProperties.Name="目标页面序号"
                Margin="0,0,8,8"
                Maximum="1000"
                Minimum="1"
                Name="PageIndex"
                Value="{CompiledBinding Target, Mode=TwoWay}"
                Width="144" />
            <Button
                Command="{CompiledBinding JumpCommand}"
                Content="跳转"
                Margin="0,0,8,8"
                Name="JumpPage" />
            <Button
                Command="{CompiledBinding LastCommand}"
                Content="最后一页"
                Margin="0,0,8,8"
                Name="LastPage" />
            <Button
                Command="{CompiledBinding ReverseCommand}"
                Content="快速往返"
                Margin="0,0,8,8"
                Name="ReversePages" />
            <Button
                Command="{CompiledBinding ResetCommand}"
                Content="重置"
                Margin="0,0,8,8"
                Name="ResetCarousel" />
        </WrapPanel>
        <TextBlock
            Classes="helper"
            Name="CarouselMetrics"
            Text="{CompiledBinding Metrics}" />
        <Border
            Background="{DynamicResource One.Subtle}"
            CornerRadius="8"
            Padding="16">
            <StackPanel Spacing="6">
                <TextBlock
                    Name="CarouselStatus"
                    Text="{CompiledBinding Status}"
                    TextWrapping="Wrap" />
                <TextBlock Classes="helper" Text="聚焦轮播后使用 ← / →、Home / End；拖动页面可切换，开启循环后可跨越首尾页。" />
            </StackPanel>
        </Border>
        <TextBlock FontWeight="SemiBold" Text="相邻页面预览 · 精简卡片模板" />
        <Carousel
            Height="180"
            IsSwipeEnabled="True"
            ItemsSource="{CompiledBinding Slides}"
            Name="CompactCarouselSample"
            SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
            ViewportFraction="0.8"
            WrapSelection="True">
            <Carousel.ItemTemplate>
                <DataTemplate x:DataType="local:CarouselSlide">
                    <Border
                        Background="{DynamicResource One.AccentSoft}"
                        CornerRadius="12"
                        Margin="8"
                        Padding="20">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource One.Accent}" Text="{CompiledBinding Category}" />
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{CompiledBinding Title}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </Carousel.ItemTemplate>
        </Carousel>
    </StackPanel>
</UserControl>
