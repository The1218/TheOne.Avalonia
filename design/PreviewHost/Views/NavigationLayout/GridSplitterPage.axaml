<local:BasicControlPage
    x:Class="TheOne.DesignPreview.GridSplitterPage"
    x:DataType="local:GridSplitterPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="GridSplitter" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <Grid ColumnDefinitions="*,6,*" Height="300">
                <Border Background="{DynamicResource One.Subtle}" Padding="20">
                    <TextBlock Text="左侧内容" />
                </Border>
                <GridSplitter
                    Grid.Column="1"
                    Name="ControlSample"
                    ResizeDirection="Columns" />
                <Border Grid.Column="2" Padding="20">
                    <TextBlock Text="右侧内容" />
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
