<UserControl
    x:Class="TheOne.DesignPreview.NavMenuDemoView"
    x:DataType="local:NavMenuDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <TextBlock Classes="section-title" Text="NavMenu · 多级导航" />
        <TextBlock
            Classes="helper"
            Text="图标与内容独立模板；Entries 指定子级来源。每一级都有 1,000 条数据，按视口创建和回收。方向键导航，Enter / 空格调用菜单。"
            TextWrapping="Wrap" />
        <WrapPanel>
            <ToggleButton
                Content="折叠侧栏"
                IsChecked="{CompiledBinding IsCollapsed, Mode=TwoWay}"
                Margin="0,0,8,8"
                Name="CompactToggle" />
            <Button
                Command="{CompiledBinding ToggleBranchCommand}"
                Content="展开 / 收起千条子项"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding ToggleNestedBranchCommand}"
                Content="展开 / 收起三级"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding ReverseSidebarCommand}"
                Content="快速反转侧栏"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding OpenCommand}"
                Content="打开产品菜单"
                Margin="0,0,8,8"
                Name="OpenSubmenu" />
            <Button
                Command="{CompiledBinding CloseCommand}"
                Content="关闭弹层"
                Margin="0,0,8,8"
                Name="CloseSubmenu" />
            <Button
                Command="{CompiledBinding JumpRootCommand}"
                Content="末尾根菜单"
                Margin="0,0,8,8"
                Name="JumpRoot" />
            <Button
                Command="{CompiledBinding JumpChildCommand}"
                Content="末尾二级菜单"
                Margin="0,0,8,8"
                Name="JumpChild" />
            <Button
                Command="{CompiledBinding JumpDeepCommand}"
                Content="末尾三级菜单"
                Margin="0,0,8,8"
                Name="JumpDeep" />
            <ToggleButton
                Content="悬停打开"
                IsChecked="{CompiledBinding OpenOnHover, Mode=TwoWay}"
                Margin="0,0,8,8"
                Name="HoverToggle" />
            <Button
                Command="{CompiledBinding CollapseCommand}"
                Content="收起所有"
                Margin="0,0,8,8" />
        </WrapPanel>
        <WrapPanel>
            <CheckBox
                Content="显示内置搜索"
                IsChecked="{CompiledBinding ShowFilter, Mode=TwoWay}"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding SearchDeepCommand}"
                Content="搜索三级末项"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding SearchAllChildrenCommand}"
                Content="搜索千条子菜单"
                Margin="0,0,8,8" />
            <Button
                Command="{CompiledBinding ClearSearchCommand}"
                Content="清空并恢复状态"
                Margin="0,0,8,8"
                Name="ClearMenuSearch" />
        </WrapPanel>
        <TextBlock
            Classes="helper"
            Text="顶部自动补全搜索支持任意层级和父级路径；折叠后点击搜索图标打开输入弹层。↑ / ↓ 选择建议，Enter 或点击结果定位原菜单并关闭搜索弹层；Esc 或点击外部取消并恢复状态。"
            TextWrapping="Wrap" />
        <WrapPanel>
            <NumericUpDown
                Increment="40"
                Margin="0,0,8,8"
                Maximum="1400"
                Minimum="260"
                Name="EdgeWindowWidth"
                Value="{CompiledBinding EdgeWidth, Mode=TwoWay}"
                Width="156" />
            <CheckBox
                Content="靠右放置图标栏"
                IsChecked="{CompiledBinding EdgeRight, Mode=TwoWay}"
                Margin="0,0,16,8" />
            <Button
                Command="{CompiledBinding EdgeCommand}"
                Content="边缘与窄窗口验证"
                Margin="0,0,8,8" />
        </WrapPanel>
        <Grid ColumnDefinitions="Auto,20,*">
            <Border
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
                <one:NavMenu
                    ExpandedWidth="300"
                    ChildrenBinding="{CompiledBinding Entries}"
                    ExpandedBinding="{CompiledBinding IsExpanded, Mode=TwoWay}"
                    Height="400"
                    IsCollapsed="{CompiledBinding IsCollapsed, Mode=TwoWay}"
                    IsGroupBinding="{CompiledBinding IsGroup}"
                    IsItemEnabledBinding="{CompiledBinding IsEnabled}"
                    ItemInvokedCommand="{CompiledBinding InvokeCommand}"
                    ItemsSource="{CompiledBinding Roots}"
                    Name="DemoMenu"
                    OpenOnHover="{CompiledBinding OpenOnHover}"
                    SearchText="{CompiledBinding Search, Mode=TwoWay}"
                    SearchTextBinding="{CompiledBinding Title}"
                    SelectedItem="{CompiledBinding Selected, Mode=TwoWay}"
                    SelectionChanged="OnSelected"
                    ShowFilter="{CompiledBinding ShowFilter, Mode=TwoWay}">
                    <one:NavMenu.IconTemplate>
                        <DataTemplate>
                            <Path
                                Data="{CompiledBinding Icon}"
                                Stretch="Uniform"
                                Stroke="{CompiledBinding $parent[ContentPresenter].Foreground}"
                                StrokeThickness="1.3" />
                        </DataTemplate>
                    </one:NavMenu.IconTemplate>
                    <one:NavMenu.ContentTemplate>
                        <DataTemplate>
                            <one:NavMenuSearchText SourceText="{CompiledBinding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </one:NavMenu.ContentTemplate>
                </one:NavMenu>
            </Border>
            <StackPanel Grid.Column="2" Spacing="16">
                <TextBlock FontWeight="SemiBold" Text="当前页面" />
                <TextBlock
                    FontSize="20"
                    Name="SelectedLabel"
                    Text="{CompiledBinding Selected.Title, TargetNullValue=尚未选择}"
                    TextWrapping="Wrap" />
                <TextBlock Text="{CompiledBinding InvocationStatus}" TextWrapping="Wrap" />
                <TextBlock
                    Classes="helper"
                    Name="MenuMetrics"
                    Text="{CompiledBinding Metrics}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Classes="helper"
                    Text="选择和展开状态绑定到数据模型；悬停图标 100ms 打开菜单，移出 300ms 后关闭；级联菜单在边缘自动翻转，窄窗口使用返回按钮逐级浏览。Left / Esc 逐级返回，点击叶子或弹层外关闭。顶部工具栏切换尺寸、主题与动效；子菜单按可见视口展开 / 收起，侧栏切换时图标平移、文字渐显。可快速反转，动效关闭立即切换。"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
