<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ScrollViewerPage"
    x:DataType="local:ScrollViewerPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ScrollViewer" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <ScrollViewer Height="300" Name="ControlSample">
                <StackPanel Spacing="16">
                    <TextBlock Text="滚动视口" />
                    <Border
                        Background="{DynamicResource One.Subtle}"
                        CornerRadius="8"
                        Height="720">
                        <TextBlock Margin="24" Text="有限示例内容" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
</local:BasicControlPage>