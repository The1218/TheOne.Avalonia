<UserControl
    x:Class="TheOne.DesignPreview.TabStripDemoView"
    x:CompileBindings="True"
    x:DataType="local:TabStripDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="20">
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="TabStrip · 独立标签导航" />
            <TextBlock Classes="helper" Text="原生选择与方向键导航。使用顶部主题和尺寸设置检查外观，标签标题按需创建与回收。" />
        </StackPanel>
        <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="工作流" />
            <TabStrip
                AutomationProperties.Name="工作流导航"
                Name="WorkflowStrip"
                SelectedIndex="{CompiledBinding Workflow, Mode=TwoWay}">
                <TabStripItem Content="_Overview / 概览" />
                <TabStripItem Content="_Activity / 动态" />
                <TabStripItem Content="归档（禁用）" IsEnabled="False" />
            </TabStrip>
            <Border
                Background="{DynamicResource One.Subtle}"
                CornerRadius="8"
                Padding="16">
                <TextBlock
                    Name="WorkflowStatus"
                    Text="{CompiledBinding WorkflowStatus}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <Separator />
        <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="10,000 个标签" />
            <TextBlock Classes="helper" Text="滚动查看或跳转至远处标签；聚焦标题后使用 ← / →、Home / End。选中项在视口中保持可见。" />
            <WrapPanel>
                <NumericUpDown
                    AutomationProperties.Name="目标标签序号"
                    Margin="0,0,8,8"
                    Maximum="10000"
                    Minimum="1"
                    Name="TargetIndex"
                    Value="{CompiledBinding Target, Mode=TwoWay}"
                    Width="156" />
                <Button
                    Command="{CompiledBinding JumpCommand}"
                    Content="跳转"
                    Margin="0,0,8,8"
                    Name="JumpTarget" />
                <Button
                    Command="{CompiledBinding LastCommand}"
                    Content="最后一项"
                    Margin="0,0,8,8"
                    Name="JumpLast" />
                <Button
                    Command="{CompiledBinding ResetCommand}"
                    Content="回到首项"
                    Margin="0,0,8,8"
                    Name="ResetTabs" />
                <CheckBox
                    Content="启用标签"
                    IsChecked="{CompiledBinding Enabled, Mode=TwoWay}"
                    Name="EnableStrip" />
            </WrapPanel>
            <TabStrip
                AutomationProperties.Name="一万项标签导航"
                Height="80"
                IsEnabled="{CompiledBinding Enabled}"
                ItemsSource="{CompiledBinding Rows}"
                Name="HugeStrip"
                SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}">
                <TabStrip.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{CompiledBinding}" VerticalAlignment="Center" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
            <TextBlock
                Classes="helper"
                Name="TabMetrics"
                Text="{CompiledBinding Metrics}" />
            <Border
                Background="{DynamicResource One.Subtle}"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Name="SelectedTitle"
                        Text="{CompiledBinding SelectedTitle}" />
                    <TextBlock Classes="helper" Text="此内容区域由消费项目绑定 SelectedItem；TabStrip 本身只负责导航，不创建每个标签的内容页面。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
