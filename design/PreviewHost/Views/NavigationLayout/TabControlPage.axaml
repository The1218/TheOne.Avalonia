<local:BasicControlPage
    x:Class="TheOne.DesignPreview.TabControlPage"
    x:DataType="local:TabControlPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="TabControl" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <TextBlock Text="标题跟随指针，相邻标签平滑让位；停在边缘可连续滚动，Esc 取消，松手确认排序。点击选中标签的关闭按钮关闭。" TextWrapping="Wrap" />
            <TabControl
                Classes="card"
                Height="300"
                ItemsSource="{CompiledBinding Tabs}"
                Name="ControlSample"
                SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{CompiledBinding}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{CompiledBinding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{CompiledBinding LastTabCommand}" Content="末尾标签" />
            <Button Command="{CompiledBinding AddTabCommand}" Content="添加标签" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <TabControl
                Classes="pills"
                Height="160"
                ItemsSource="{CompiledBinding Tabs}"
                Name="PillsTabSample"
                SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{CompiledBinding}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{CompiledBinding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
