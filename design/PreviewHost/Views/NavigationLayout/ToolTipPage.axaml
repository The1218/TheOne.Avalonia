<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ToolTipPage"
    x:DataType="local:ToolTipPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ToolTip" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <Button
                Content="悬停查看提示"
                HorizontalAlignment="Left"
                Name="ControlSample"
                ToolTip.Tip="{CompiledBinding Text}" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
