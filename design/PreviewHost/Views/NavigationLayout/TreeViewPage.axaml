<local:BasicControlPage
    x:Class="TheOne.DesignPreview.TreeViewPage"
    x:DataType="local:TreeViewPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="TreeView" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="简洁节点 / 带说明节点 · 独立模型、双向展开状态与 1,000 项根及子集合"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <WrapPanel>
                <StackPanel
                    Margin="0,0,16,16"
                    Spacing="8"
                    Width="340">
                    <TextBlock Foreground="{DynamicResource One.Muted}" Text="简洁树节点" />
                    <TreeView
                        Height="280"
                        ItemsSource="{Binding TreeRoots}"
                        Name="ControlSample"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="local:PreviewTreeNode">
                                <TextBlock Text="{Binding Name}" />
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="local:PreviewTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </StackPanel>
                <StackPanel
                    Margin="0,0,16,16"
                    Spacing="8"
                    Width="340">
                    <TextBlock Foreground="{DynamicResource One.Muted}" Text="标题与说明节点" />
                    <TreeView
                        Height="280"
                        ItemsSource="{Binding TreeRoots}"
                        Name="DetailedSample"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <TreeView.DataTemplates>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="local:PreviewTreeNode">
                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource One.Muted}"
                                        Text="{Binding Description}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="local:PreviewTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        <Button
            Command="{Binding LastCommand}"
            Content="第 1,000 项"
            HorizontalAlignment="Left" />
    </StackPanel>
</local:BasicControlPage>