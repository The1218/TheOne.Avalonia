<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ScrollBarPage"
    x:DataType="local:ScrollBarPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ScrollBar" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <ScrollBar
                HorizontalAlignment="Left"
                Maximum="100"
                Name="ControlSample"
                Orientation="Horizontal"
                Value="{Binding Value, Mode=TwoWay}"
                ViewportSize="20"
                Width="360" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
</local:BasicControlPage>