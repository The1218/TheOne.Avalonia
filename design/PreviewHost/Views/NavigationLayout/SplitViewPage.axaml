<local:BasicControlPage
    x:Class="TheOne.DesignPreview.SplitViewPage"
    x:DataType="local:SplitViewPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="SplitView" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <ToggleButton
                Content="展开侧栏"
                HorizontalAlignment="Left"
                IsChecked="{CompiledBinding Expanded, Mode=TwoWay}" />
            <WrapPanel>
                <ComboBox
                    ItemsSource="{CompiledBinding Modes}"
                    Margin="0,0,12,8"
                    SelectedItem="{CompiledBinding DisplayMode, Mode=TwoWay}"
                    Width="180" />
                <ComboBox
                    ItemsSource="{CompiledBinding Placements}"
                    Margin="0,0,12,8"
                    SelectedItem="{CompiledBinding PanePlacement, Mode=TwoWay}"
                    Width="140" />
                <Button
                    Command="{CompiledBinding LastCommand}"
                    Content="定位第 1000 项"
                    Margin="0,0,0,8" />
            </WrapPanel>
            <SplitView
                DisplayMode="{CompiledBinding DisplayMode}"
                Height="420"
                IsPaneOpen="{CompiledBinding Expanded, Mode=TwoWay}"
                Name="ControlSample"
                PanePlacement="{CompiledBinding PanePlacement}">
                <SplitView.Pane>
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        ItemsSource="{CompiledBinding Items}"
                        Name="DetailedSample"
                        SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon
                                        Data="M3,3 H9 V9 H3 Z M12,3 H18 V9 H12 Z M3,12 H9 V18 H3 Z M12,12 H18 V18 H12 Z"
                                        Height="16"
                                        Width="16" />
                                    <TextBlock
                                        IsVisible="{CompiledBinding $parent[SplitView].IsPaneOpen}"
                                        Text="{CompiledBinding}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </SplitView.Pane>
                <TextBlock Margin="24" Text="{CompiledBinding Text}" />
            </SplitView>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
