<local:BasicControlPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOne.DesignPreview" xmlns:one="using:TheOne.Avalonia.Controls" x:Class="TheOne.DesignPreview.SplitViewPage" x:DataType="local:SplitViewPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Text="SplitView" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="独立控件页面 · 双向绑定 · 使用顶部工具栏切换尺寸、主题与动效" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap"/>
    <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
    <StackPanel Spacing="16" IsEnabled="{Binding Enabled}">
      <ToggleButton Content="展开侧栏" IsChecked="{Binding Expanded, Mode=TwoWay}" HorizontalAlignment="Left"/>
      <WrapPanel>
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding DisplayMode, Mode=TwoWay}" Width="180" Margin="0,0,12,8" />
        <ComboBox ItemsSource="{Binding Placements}" SelectedItem="{Binding PanePlacement, Mode=TwoWay}" Width="140" Margin="0,0,12,8" />
        <Button Content="定位第 1000 项" Command="{Binding LastCommand}" Margin="0,0,0,8" />
      </WrapPanel>
      <SplitView Name="ControlSample" Height="420" IsPaneOpen="{Binding Expanded, Mode=TwoWay}" DisplayMode="{Binding DisplayMode}" PanePlacement="{Binding PanePlacement}">
        <SplitView.Pane>
          <ListBox Name="DetailedSample" Background="Transparent" BorderThickness="0" CornerRadius="0"
                   ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <PathIcon Width="16" Height="16" Data="M3,3 H9 V9 H3 Z M12,3 H18 V9 H12 Z M3,12 H9 V18 H3 Z M12,12 H18 V18 H12 Z" />
                  <TextBlock Text="{Binding}" IsVisible="{CompiledBinding $parent[SplitView].IsPaneOpen}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </SplitView.Pane>
        <TextBlock Text="{Binding Text}" Margin="24"/>
      </SplitView>
    </StackPanel>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
  </StackPanel>
</local:BasicControlPage>
