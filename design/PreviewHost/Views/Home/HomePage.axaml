<UserControl
    x:Class="TheOne.DesignPreview.HomePage"
    x:CompileBindings="True"
    x:DataType="local:HomePage"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:styling="using:TheOne.Avalonia.Styling"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Stretch" Spacing="28">
        <StackPanel Spacing="12">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource One.Accent}"
                Text="THEONE · AVALONIA" />
            <TextBlock
                FontSize="30"
                FontWeight="Bold"
                Text="从原生控件，到完整的业务界面。"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{DynamicResource One.Muted}"
                HorizontalAlignment="Left"
                MaxWidth="760"
                Text="保留熟悉的输入、焦点和数据绑定，用统一的主题构建桌面应用。先试试样式，再进入完整示例。"
                TextWrapping="Wrap" />
            <WrapPanel>
                <TextBlock Margin="0,0,20,8" Text=".NET 10 / Avalonia 12" />
                <TextBlock Margin="0,0,20,8" Text="Light / Dark" />
                <TextBlock Margin="0,0,20,8" Text="Small / Normal / Large" />
            </WrapPanel>
            <WrapPanel>
                <Button
                    Classes="primary"
                    Click="NavigateClicked"
                    Content="从表单开始"
                    Margin="0,0,10,8"
                    Name="ExploreButton"
                    Tag="322" />
                <Button
                    Click="NavigateClicked"
                    Content="查看 DataGrid"
                    Margin="0,0,10,8"
                    Tag="10" />
                <Button
                    Click="NavigateClicked"
                    Content="报表与打印"
                    Margin="0,0,10,8"
                    Tag="319" />
            </WrapPanel>
        </StackPanel>
        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="20"
            Name="Examples"
            RowSpacing="20">
            <Border
                Background="{DynamicResource One.Surface}"
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="1"
                Classes="home-panel"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="亲手试一试" />
                    <TextBlock
                        Foreground="{DynamicResource One.Muted}"
                        Text="输入、标签与操作，共用一套密度和颜色。"
                        TextWrapping="Wrap" />
                    <one:FormItem HelpText="原生 TextBox，支持编辑、选择与键盘焦点。" Label="工作区名称">
                        <TextBox
                            Name="WorkspaceInput"
                            PlaceholderText="输入工作区名称"
                            Text="设计工作区" />
                    </one:FormItem>
                    <one:FormItem Label="关注的能力">
                        <one:MultiSelectBox Name="Capabilities" PlaceholderText="选择控件能力" />
                    </one:FormItem>
                    <WrapPanel>
                        <Button
                            Classes="primary"
                            Click="SaveClicked"
                            Content="保存设置"
                            Margin="0,0,8,8" />
                        <Button
                            Classes="soft"
                            Content="柔和按钮"
                            Margin="0,0,8,8" />
                        <Button Content="默认按钮" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock
                        Foreground="{DynamicResource One.Muted}"
                        Name="SampleStatus"
                        Text="修改上方内容，点击保存查看反馈。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border
                Background="{DynamicResource One.Subtle}"
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Column="1"
                Name="QuickStart"
                Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="只加载一次主题" />
                    <TextBlock
                        Foreground="{DynamicResource One.Muted}"
                        Text="在 App.axaml 注册 OneTheme，然后继续使用原生 Avalonia 控件。"
                        TextWrapping="Wrap" />
                    <local:PreviewCodeBlock Text="&lt;Application.Styles&gt;&#10;  &lt;themes:OneTheme /&gt;&#10;&lt;/Application.Styles&gt;&#10;&#10;&lt;!-- themes: using:TheOne.Avalonia.Themes --&gt;&#10;&#10;&lt;Button Classes=&quot;primary&quot;&#10;        Content=&quot;保存&quot; /&gt;&#10;&lt;TextBox PlaceholderText=&quot;输入内容&quot; /&gt;" />
                    <TextBlock
                        Foreground="{DynamicResource One.Muted}"
                        Text="顶部配置可实时更新预览；尺寸、动效及继承规则在下方统一说明。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Border
            Background="{DynamicResource One.Surface}"
            BorderBrush="{DynamicResource One.Line}"
            BorderThickness="1"
            CornerRadius="8"
            Name="SharedConfiguration"
            Padding="20">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="通用配置：尺寸与动效"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="以下通用附加属性可设在控件、容器或窗口上。各页只展示本库新增、支持 Binding / CompiledBinding 的公开可写属性和模型属性，以及必要的业务 API；不列只读运行状态、内部字段或原生属性清单。默认 OneWay 的可写属性也可显式设置 Mode=TwoWay；编译绑定请声明实际 x:DataType。"
                    TextWrapping="Wrap" />
                <one:Description
                    LabelWidth="210"
                    Name="SharedConfigurationDetails"
                    StackWidth="620">
                    <one:DescriptionItem Header="ControlSizing.Size">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ControlSize 枚举，默认 Normal，可绑定并沿控件树继承。Small / Normal / Large 提供紧凑、标准、宽松三档密度；子控件显式设置可覆盖该分支。" TextWrapping="Wrap" />
                            <SelectableTextBlock
                                FontFamily="Menlo, Consolas, monospace"
                                FontSize="12"
                                Text="&lt;StackPanel styling:ControlSizing.Size=&quot;{CompiledBinding ControlSize}&quot; /&gt;"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </one:DescriptionItem>
                    <one:DescriptionItem Header="Motion.Enabled">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Boolean，默认 True，可绑定并沿控件树继承。False 关闭该分支遵循 Motion 设置的动效。通知、刷新和内容切换的专用参数在各自页面说明。" TextWrapping="Wrap" />
                            <SelectableTextBlock
                                FontFamily="Menlo, Consolas, monospace"
                                FontSize="12"
                                Text="&lt;StackPanel styling:Motion.Enabled=&quot;{CompiledBinding EnableMotion}&quot; /&gt;"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </one:DescriptionItem>
                </one:Description>
                <TextBlock
                    FontWeight="SemiBold"
                    Text="三档密度直接对照"
                    TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="每组只在容器上设置一次 ControlSizing.Size，内部按钮、输入框和标签自动继承。三组显式保留各自尺寸，便于同时比较。"
                    TextWrapping="Wrap" />
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="16"
                    Name="DensitySamples"
                    RowSpacing="16">
                    <Border
                        BorderBrush="{DynamicResource One.Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                        <StackPanel
                            Name="SmallDensitySample"
                            Spacing="12"
                            styling:ControlSizing.Size="Small">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Small · 紧凑"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{DynamicResource One.Muted}"
                                Text="ControlSizing.Size = Small"
                                TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button
                                    Classes="primary"
                                    Content="保存"
                                    Margin="0,0,8,8"
                                    Name="SmallDensityButton" />
                                <one:Tag
                                    Content="状态标签"
                                    Margin="0,0,0,8"
                                    Status="Processing" />
                            </WrapPanel>
                            <TextBox Name="SmallDensityInput" Text="紧凑密度输入框" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="{DynamicResource One.Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Grid.Column="1"
                        Padding="12">
                        <StackPanel
                            Name="NormalDensitySample"
                            Spacing="12"
                            styling:ControlSizing.Size="Normal">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Normal · 标准"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{DynamicResource One.Muted}"
                                Text="ControlSizing.Size = Normal"
                                TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button
                                    Classes="primary"
                                    Content="保存"
                                    Margin="0,0,8,8"
                                    Name="NormalDensityButton" />
                                <one:Tag
                                    Content="状态标签"
                                    Margin="0,0,0,8"
                                    Status="Processing" />
                            </WrapPanel>
                            <TextBox Name="NormalDensityInput" Text="标准密度输入框" />
                        </StackPanel>
                    </Border>
                    <Border
                        BorderBrush="{DynamicResource One.Line}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Grid.Column="2"
                        Padding="12">
                        <StackPanel
                            Name="LargeDensitySample"
                            Spacing="12"
                            styling:ControlSizing.Size="Large">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Large · 宽松"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{DynamicResource One.Muted}"
                                Text="ControlSizing.Size = Large"
                                TextWrapping="Wrap" />
                            <WrapPanel>
                                <Button
                                    Classes="primary"
                                    Content="保存"
                                    Margin="0,0,8,8"
                                    Name="LargeDensityButton" />
                                <one:Tag
                                    Content="状态标签"
                                    Margin="0,0,0,8"
                                    Status="Processing" />
                            </WrapPanel>
                            <TextBox Name="LargeDensityInput" Text="宽松密度输入框" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>
        <Border
            BorderBrush="{DynamicResource One.Line}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20">
            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="主题、配色与资源" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="默认 Nova，可选择 10 套配色。顶部配色选择器切换颜色资源，太阳 / 月亮按钮只切换 Light / Dark；尺寸和业务数据保持独立。"
                    TextWrapping="Wrap" />
                <local:PreviewCodeBlock CodeType="CSharp" Text="OneTheme.SetColor(ThemeColor.Atlas);&#10;// 启动时先读取应用保存的 ThemeColor，再创建主窗口。&#10;OneTheme.SetColor(settings.ColorTheme);&#10;// 在窗口中使用编译绑定：&#10;// &lt;one:ThemeColorPicker SelectThemeColor=&quot;{CompiledBinding ColorTheme}&quot; /&gt;&#10;// ColorTheme 为 ThemeColor；默认双向绑定。由应用负责保存配置。" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="动态资源随配色更新：One.Surface、One.Text、One.Accent 等。渐变提供 Subtle（柔和）和 Vivid（明显）两类，每类包含 Brand、Cool、Natural、Warm。以下色块可随顶部选择实时变化。"
                    TextWrapping="Wrap" />
                <WrapPanel Name="GradientSamples" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="用法：Background=&quot;{DynamicResource One.Gradient.Subtle.Brand}&quot;&#10;文档：docs/theme/zh-cn/theme-color-picker.md · theme-colors.md"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <StackPanel Spacing="8">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="从这些控件开始" />
            <TextBlock
                Foreground="{DynamicResource One.Muted}"
                Text="每个入口都包含可交互预览。下面的片段展示接入方式，业务视图仍需声明实际 x:DataType。"
                TextWrapping="Wrap" />
        </StackPanel>
        <Grid
            ColumnSpacing="16"
            Name="Features"
            RowSpacing="16" />
        <Border
            BorderBrush="{DynamicResource One.Line}"
            BorderThickness="0,1,0,0"
            Padding="0,20,0,0">
            <StackPanel Spacing="10">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="窗口，也是一等公民" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="OneWindow 提供主题标题栏、通知与对话框；LoginWindow 保留原生窗口生命周期，并负责登录后的主窗口交接。"
                    TextWrapping="Wrap" />
                <local:PreviewCodeBlock Text="&lt;one:OneWindow Title=&quot;工作区&quot; /&gt;&#10;&lt;!-- one: using:TheOne.Avalonia.Controls --&gt;" />
                <local:PreviewCodeBlock CodeType="CSharp" Text="if (await login.CompleteLoginAsync(new MainWindow()))&#10;    await OneToast.ShowAsync(&quot;欢迎回来&quot;);" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="文档：docs/controls/zh-cn/windows.md · login-window.md&#10;登录演示：从左侧菜单打开 LoginWindow 页面"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
