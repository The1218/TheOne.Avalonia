<UserControl
    x:Class="TheOne.DesignPreview.ControlGallery"
    x:DataType="local:GalleryViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*,Auto">
    <Button Name="ExplorerButton" Content="按样式与额外属性探索 →" Margin="28,8,28,0" HorizontalAlignment="Right" />
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Name="PageScroll">
        <Border Padding="28" Name="PageFrame">
            <ContentControl HorizontalContentAlignment="Stretch" Name="PageHost" />
        </Border>
    </ScrollViewer>
    <local:PreviewSourcePanel Grid.Row="2" Name="SourcePanel" Margin="28,0,28,12" />
    </Grid>
</UserControl>
