<UserControl
    x:Class="TheOne.DesignPreview.RefreshDemoView"
    x:CompileBindings="True"
    x:DataType="local:RefreshDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ListBox#RefreshList ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="Refresh · 下拉刷新" />
            <TextBlock Classes="helper" Text="在列表顶部向下拖动，释放后刷新。1,000 条数据按需显示，支持手动刷新、完成与失败重试。" />
        </StackPanel>
        <WrapPanel>
            <CheckBox
                Content="鼠标下拉"
                IsChecked="{Binding MousePull, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="MousePull" />
            <CheckBox
                Content="手动完成"
                IsChecked="{Binding Manual, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="ManualComplete" />
            <CheckBox
                Content="下次模拟失败"
                IsChecked="{Binding Fail, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="FailNextRefresh" />
            <CheckBox
                Content="启用刷新区域"
                IsChecked="{Binding Enabled, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="EnableRefresh" />
            <CheckBox
                Content="刷新动效"
                IsChecked="{Binding MotionEnabled, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="RefreshMotionEnabled" />
        </WrapPanel>
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button
                Classes="primary"
                Click="OnRequestRefresh"
                Content="刷新数据"
                Name="RequestRefresh" />
            <TextBlock
                FontWeight="SemiBold"
                Grid.Column="1"
                HorizontalAlignment="Center"
                Name="RefreshStateLabel"
                Text="{Binding State}"
                VerticalAlignment="Center" />
            <Button
                Click="OnCompleteRefresh"
                Content="完成刷新"
                Grid.Column="2"
                IsEnabled="False"
                Name="CompleteRefresh" />
        </Grid>
        <RefreshContainer
            AutomationProperties.Name="千条数据下拉刷新区域"
            Height="400"
            IsEnabled="{Binding Enabled}"
            IsMouseEnabled="{Binding MousePull}"
            Name="RefreshSample"
            RefreshRequested="OnRefreshRequested">
            <ListBox
                AutomationProperties.Name="刷新数据列表"
                BorderThickness="0"
                CornerRadius="0"
                ItemsSource="{Binding Rows}"
                Name="RefreshList"
                ScrollViewer.IsScrollChainingEnabled="False"
                SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:RefreshRow">
                        <Grid ColumnDefinitions="60,*,Auto" ColumnSpacing="12">
                            <TextBlock
                                Foreground="{DynamicResource One.Muted}"
                                Text="{Binding Number, StringFormat='{}{0:0000}'}"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Name="RefreshRowTitle"
                                Text="{Binding Title}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Foreground="{DynamicResource One.Muted}"
                                Grid.Column="2"
                                Text="{Binding Revision, StringFormat='第 {0} 次更新'}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </RefreshContainer>
        <WrapPanel>
            <Button
                Click="OnFirstRow"
                Content="回到顶部"
                Margin="0,0,8,8"
                Name="FirstRefreshRow" />
            <Button
                Click="OnLastRow"
                Content="第 1,000 条"
                Margin="0,0,8,8"
                Name="LastRefreshRow" />
            <Button
                Click="OnReset"
                Content="重置"
                Margin="0,0,8,8"
                Name="ResetRefreshDemo" />
        </WrapPanel>
        <TextBlock
            Classes="helper"
            Name="RefreshMetrics"
            Text="{Binding Metrics}" />
        <Border
            Background="{DynamicResource One.Subtle}"
            CornerRadius="8"
            Padding="16">
            <StackPanel Spacing="6">
                <TextBlock
                    Name="RefreshStatus"
                    Text="{Binding Status}"
                    TextWrapping="Wrap" />
                <TextBlock Classes="helper" Text="自动刷新约 1 秒完成。开启手动完成，在刷新中反复切换刷新动效；关闭后保留下拉和状态提示，重新开启恢复旋转。通过全局工具栏切换尺寸、明暗主题和动效；重置恢复全局动效设置。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>