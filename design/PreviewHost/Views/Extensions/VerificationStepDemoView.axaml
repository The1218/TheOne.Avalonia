<UserControl
    x:Class="TheOne.DesignPreview.VerificationStepDemoView"
    x:CompileBindings="True"
    x:DataType="local:VerificationStepDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="VerificationStep · 带验证的 Step" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="模型属性声明验证规则 · 输入与错误提示由控件库生成 · 验证通过才能前进"
            TextWrapping="Wrap" />
        <WrapPanel>
            <TextBlock
                Margin="0,0,8,8"
                Text="步骤条对齐"
                VerticalAlignment="Center" />
            <ComboBox
                ItemsSource="{Binding HeaderAlignments}"
                Margin="0,0,12,8"
                MinWidth="120"
                SelectedItem="{Binding HeaderAlignment, Mode=TwoWay}" />
            <Button
                Click="ResetClicked"
                Content="重置三步表单"
                Margin="0,0,8,8" />
            <Button
                Click="ThousandClicked"
                Content="加载 1,000 步"
                Margin="0,0,8,8" />
            <Button
                Click="LastClicked"
                Content="尝试跳到末步"
                Margin="0,0,8,8" />
        </WrapPanel>
        <one:VerificationStep
            CompletedCommand="{Binding CompletedCommand}"
            HeaderHorizontalAlignment="{Binding HeaderAlignment}"
            Height="590"
            ItemsSource="{Binding Steps}"
            Name="StepSample" />
        <TextBlock
            Name="StepStatus"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>