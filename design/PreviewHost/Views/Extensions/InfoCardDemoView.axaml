<UserControl
    x:Class="TheOne.DesignPreview.InfoCardDemoView"
    x:CompileBindings="True"
    x:DataType="local:InfoCardDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:DataType="local:InfoCardDemoViewModel" x:Key="InfoCardIconTemplate">
            <PathIcon
                Data="{CompiledBinding IconData}"
                Foreground="{DynamicResource One.Accent}"
                Height="{CompiledBinding $parent[one:InfoCard].HeaderIconSize}"
                Name="InfoCardTypedIcon"
                Width="{CompiledBinding $parent[one:InfoCard].HeaderIconSize}" />
        </DataTemplate>
        <DataTemplate x:DataType="local:InfoCardDemoViewModel" x:Key="InfoCardActionsTemplate">
            <Button
                Command="{CompiledBinding DetailsCommand}"
                Content="{CompiledBinding DetailsLabel}"
                Name="InfoCardTypedHeaderAction" />
        </DataTemplate>
        <DataTemplate x:DataType="local:InfoCardDemoViewModel" x:Key="InfoCardFooterTemplate">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Name="InfoCardTypedFooterStatus"
                    Text="{CompiledBinding FooterStatus}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <Button
                    Command="{CompiledBinding SyncCommand}"
                    Content="同步"
                    Grid.Column="1"
                    Name="InfoCardFooterAction" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                FontSize="22"
                FontWeight="SemiBold"
                Text="InfoCard · 信息卡片" />
            <TextBlock Classes="helper" Text="标题、图标、操作区、正文与页脚自由组合；切换顶部主题和尺寸，查看 TheOne 表面与间距。卡片内的输入、按钮和列表保留各自的原生交互。" />
        </StackPanel>
        <WrapPanel>
            <CheckBox Content="hove · 鼠标移入效果" IsChecked="{CompiledBinding HoverEnabled, Mode=TwoWay}" Margin="0,0,16,8" />
            <CheckBox Content="shadow · 常驻阴影" IsChecked="{CompiledBinding ShadowEnabled, Mode=TwoWay}" Margin="0,0,16,8" />
            <CheckBox
                Content="显示标题"
                IsChecked="{CompiledBinding ShowHeader, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowHeader" />
            <CheckBox
                Content="显示图标"
                IsChecked="{CompiledBinding ShowIcon, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowIcon" />
            <CheckBox
                Content="显示操作区"
                IsChecked="{CompiledBinding ShowHeaderActions, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowHeaderActions" />
            <CheckBox
                Content="显示页脚"
                IsChecked="{CompiledBinding ShowFooter, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowFooter" />
            <CheckBox
                Content="标题分割线"
                IsChecked="{CompiledBinding ShowHeaderSeparator, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowHeaderSeparator" />
            <CheckBox
                Content="页脚分割线"
                IsChecked="{CompiledBinding ShowFooterSeparator, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardShowFooterSeparator" />
            <CheckBox
                Content="启用卡片"
                IsChecked="{CompiledBinding Enabled, Mode=TwoWay}"
                Margin="0,0,16,8"
                Name="InfoCardEnabled" />
            <Button
                Command="{CompiledBinding UpdateCommand}"
                Content="更新绑定内容"
                Margin="0,0,8,8"
                Name="InfoCardUpdate" />
            <Button
                Command="{CompiledBinding ResetCommand}"
                Content="重置"
                Margin="0,0,8,8"
                Name="InfoCardReset" />
        </WrapPanel>
        <one:InfoCard
            Classes.hove="{CompiledBinding HoverEnabled}" Classes.shadow="{CompiledBinding ShadowEnabled}"
            Content="{CompiledBinding Description}"
            Header="{CompiledBinding VisibleTitle}"
            IsEnabled="{CompiledBinding Enabled}"
            Name="InfoCardSample"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}" />
        <one:InfoCard
            Content="{CompiledBinding Description}"
            Footer="{CompiledBinding VisibleFooter}"
            FooterTemplate="{CompiledBinding ShowFooter, Converter={x:Static local:InfoCardTemplateVisibilityConverter.Instance}, ConverterParameter={StaticResource InfoCardFooterTemplate}}"
            Header="{CompiledBinding VisibleTitle}"
            HeaderActions="{CompiledBinding VisibleHeaderActions}"
            HeaderActionsTemplate="{CompiledBinding ShowHeaderActions, Converter={x:Static local:InfoCardTemplateVisibilityConverter.Instance}, ConverterParameter={StaticResource InfoCardActionsTemplate}}"
            HeaderIcon="{CompiledBinding VisibleHeaderIcon}"
            HeaderIconTemplate="{CompiledBinding ShowIcon, Converter={x:Static local:InfoCardTemplateVisibilityConverter.Instance}, ConverterParameter={StaticResource InfoCardIconTemplate}}"
            IsEnabled="{CompiledBinding Enabled}"
            Name="InfoCardSlots"
            Classes.hove="{CompiledBinding HoverEnabled}" Classes.shadow="{CompiledBinding ShadowEnabled}"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}" />
        <one:InfoCard
            IsEnabled="{CompiledBinding Enabled}"
            Name="InfoCardForm"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}">
            <one:InfoCard.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="工作区设置"
                        VerticalAlignment="Center" />
                    <Button
                        Classes="primary"
                        Command="{CompiledBinding SaveCommand}"
                        Content="保存"
                        Grid.Column="1"
                        Name="InfoCardHeaderAction" />
                </Grid>
            </one:InfoCard.Header>
            <StackPanel Spacing="12">
                <Label Content="工作区名称" Target="{CompiledBinding #InfoCardName}" />
                <TextBox
                    AutomationProperties.Name="工作区名称"
                    Name="InfoCardName"
                    PlaceholderText="输入名称"
                    Text="{CompiledBinding WorkspaceName, Mode=TwoWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Name="InfoCardSaveStatus"
                    Text="{CompiledBinding SaveStatus}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </one:InfoCard>
        <one:InfoCard
            Content="{CompiledBinding}"
            Header="{CompiledBinding}"
            IsEnabled="{CompiledBinding Enabled}"
            Name="InfoCardTemplated"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}">
            <one:InfoCard.HeaderTemplate>
                <DataTemplate x:DataType="local:InfoCardDemoViewModel">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock
                            FontWeight="SemiBold"
                            Name="InfoCardTypedTitle"
                            Text="{CompiledBinding Title}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource One.Muted}"
                            Grid.Column="1"
                            Text="{CompiledBinding Revision, StringFormat='{}版本 {0}'}"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </one:InfoCard.HeaderTemplate>
            <one:InfoCard.ContentTemplate>
                <DataTemplate x:DataType="local:InfoCardDemoViewModel">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Name="InfoCardTypedDescription"
                            Text="{CompiledBinding Description}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource One.Muted}"
                            Text="HeaderTemplate 与 ContentTemplate 使用独立、明确的编译绑定类型。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </one:InfoCard.ContentTemplate>
        </one:InfoCard>
        <one:InfoCard
            Content="不提供 Header 时，内容从卡片内边距起始处布局，不保留标题间隙。"
            Name="InfoCardHeaderless"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}" />
        <one:InfoCard
            Header="成员 · 1,000 条数据"
            Name="InfoCardList"
            ShowFooterSeparator="{CompiledBinding ShowFooterSeparator}"
            ShowHeaderSeparator="{CompiledBinding ShowHeaderSeparator}">
            <StackPanel Spacing="12">
                <ListBox
                    AutomationProperties.Name="卡片内的一千条成员列表"
                    Height="180"
                    ItemsSource="{CompiledBinding Members}"
                    Name="InfoCardMembers"
                    SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
                    SelectionChanged="OnMemberChanged" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock
                        Classes="helper"
                        Name="InfoCardListMetrics"
                        Text="固定高度视口，容器按需创建。"
                        VerticalAlignment="Center" />
                    <Button
                        Click="OnJumpLast"
                        Content="跳到第 1,000 项"
                        Grid.Column="1"
                        Name="InfoCardJumpLast" />
                </Grid>
            </StackPanel>
        </one:InfoCard>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <one:InfoCard
                Classes="glow"
                Content="与全库配色同步的渐变标题。"
                Footer="正文和页脚保留细微色差"
                Header="柔光标题" />
            <one:InfoCard
                Classes="outlined"
                Content="适合需要强调的信息。"
                Header="强调描边" />
            <one:InfoCard
                Classes="flat"
                Content="无边框、无分割线的展示。"
                Header="嵌入布局" />
        </StackPanel>
    </StackPanel>
</UserControl>
