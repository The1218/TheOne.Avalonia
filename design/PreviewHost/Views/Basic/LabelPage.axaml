<local:BasicControlPage
    x:Class="TheOne.DesignPreview.LabelPage"
    x:DataType="local:LabelPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Label" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="字段标题 / 辅助说明 / 禁用 · 点击字段标题聚焦输入框"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <Label
                Content="工作区名称"
                Name="ControlSample"
                Target="{CompiledBinding #LabelInput}" />
            <TextBox
                MaxWidth="420"
                Name="LabelInput"
                Text="{CompiledBinding Text, Mode=TwoWay}" />
            <Label Content="字段说明 · 可使用内容模板" Foreground="{DynamicResource One.Muted}" />
            <Label Content="禁用标签" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
