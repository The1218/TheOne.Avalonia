<local:BasicControlPage
    styling:Motion.Enabled="{CompiledBinding MotionEnabled}"
    x:Class="TheOne.DesignPreview.ButtonPage"
    x:DataType="local:ButtonPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:styling="using:TheOne.Avalonia.Styling"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="20">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Button · 操作层次" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="主操作推进任务，次要操作补充流程，状态色说明结果与风险。使用顶部工具栏调整尺寸和主题。"
            TextWrapping="Wrap" />
        <CheckBox Content="启用交互" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <TextBlock FontWeight="SemiBold" Text="主次与轻操作" />
            <WrapPanel>
                <Button
                    Classes="primary"
                    Command="{CompiledBinding InvokeCommand}"
                    CommandParameter="保存"
                    Content="保存修改"
                    Margin="0,0,12,8"
                    Name="ControlSample" />
                <Button
                    Command="{CompiledBinding InvokeCommand}"
                    CommandParameter="取消"
                    Content="取消"
                    Margin="0,0,12,8" />
                <Button
                    Classes="outline"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="查看详情"
                    Margin="0,0,12,8" />
                <Button
                    Classes="ghost"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="稍后处理"
                    Margin="0,0,12,8" />
                <Button
                    Classes="link"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="了解更多"
                    Margin="0,0,12,8" />
            </WrapPanel>
            <TextBlock FontWeight="SemiBold" Text="语义状态" />
            <WrapPanel>
                <Button
                    Classes="success"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="确认完成"
                    Margin="0,0,12,8" />
                <Button
                    Classes="info"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="查看提示"
                    Margin="0,0,12,8" />
                <Button
                    Classes="warning"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="检查风险"
                    Margin="0,0,12,8" />
                <Button
                    Classes="danger"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="删除记录"
                    Margin="0,0,12,8" />
                <Button
                    Content="暂无权限"
                    IsEnabled="False"
                    Margin="0,0,12,8" />
            </WrapPanel>
            <TextBlock FontWeight="SemiBold" Text="Button · 语义色 × 外观组合" />
            <one:Description LabelWidth="130">
                <one:DescriptionItem Header="语义颜色" Content="primary / accent、danger、success、warning、info。未指定外观时保留原来的单独 Classes 效果。" />
                <one:DescriptionItem Header="外观" Content="solid、ghost、link、outline、soft、gradient。" />
                <one:DescriptionItem Header="优先级" Content="颜色：info &gt; warning &gt; success &gt; danger &gt; primary/accent；外观：gradient &gt; soft &gt; outline &gt; link &gt; ghost &gt; solid。与书写顺序无关，禁用统一使用禁用配色。" />
                <one:DescriptionItem Header="组合示例">
                    <TextBlock Text="&lt;Button Classes=&quot;danger outline&quot; Content=&quot;删除&quot; /&gt;&#10;&lt;Button Classes=&quot;success soft&quot; Content=&quot;已完成&quot; /&gt;" TextWrapping="Wrap" />
                </one:DescriptionItem>
            </one:Description>
            <StackPanel Name="CombinationsPanel" Spacing="12" />
            <TextBlock FontWeight="SemiBold" Text="ThemeButton · 快捷主题切换" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <one:ThemeButton Name="ThemeSample" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="点击在浅色与深色间切换"
                    VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="加载状态 · 运行三秒，可在过程中关闭／开启动效" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="手动加载" IsChecked="{CompiledBinding IsLoading, Mode=TwoWay}" />
            <CheckBox Content="启用动效" IsChecked="{CompiledBinding MotionEnabled, Mode=TwoWay}" />
        </StackPanel>
        <Button
            Classes="primary"
            Command="{CompiledBinding LoadCommand}"
            Content="保存并加载"
            IsEnabled="{CompiledBinding Enabled, Mode=TwoWay}"
            Name="LoadingSample"
            one:ButtonLoading.IsLoading="{CompiledBinding IsLoading}" />
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <WrapPanel>
                <Button
                    Classes="soft"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="柔和操作"
                    Margin="0,0,12,8"
                    Name="SoftActionSample" />
                <Button
                    Classes="gradient"
                    Command="{CompiledBinding InvokeCommand}"
                    Content="渐变操作"
                    Margin="0,0,12,8"
                    Name="GradientActionSample" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
