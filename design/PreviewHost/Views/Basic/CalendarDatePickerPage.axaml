<local:BasicControlPage
    x:Class="TheOne.DesignPreview.CalendarDatePickerPage"
    x:DataType="local:CalendarDatePickerPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="CalendarDatePicker" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="标准格式 / 精简格式 / 禁用 · 保留原生日期与时间弹窗"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <CalendarDatePicker
                    Margin="0,0,12,12"
                    Name="ControlSample"
                    SelectedDate="{CompiledBinding CalendarDate, Mode=TwoWay}" />
                <CalendarDatePicker
                    Margin="0,0,12,12"
                    PlaceholderText="选择日期"
                    SelectedDate="{CompiledBinding CalendarDate, Mode=TwoWay}" />
                <CalendarDatePicker
                    IsEnabled="False"
                    Margin="0,0,12,12"
                    SelectedDate="{CompiledBinding CalendarDate}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <CalendarDatePicker
                Classes="filled"
                Name="FilledCalendarSample"
                SelectedDate="{CompiledBinding CalendarDate, Mode=TwoWay}"
                Width="300" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
