<local:BasicControlPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOne.DesignPreview" xmlns:one="using:TheOne.Avalonia.Controls" x:Class="TheOne.DesignPreview.CalendarDatePickerPage" x:DataType="local:CalendarDatePickerPageViewModel">
 <StackPanel Spacing="18">
  <TextBlock Text="CalendarDatePicker" FontSize="22" FontWeight="SemiBold" />
  <TextBlock Text="标准格式 / 精简格式 / 禁用 · 保留原生日期与时间弹窗" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap" />
  <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
  <StackPanel Spacing="16" IsEnabled="{Binding Enabled}">
    <WrapPanel><CalendarDatePicker Name="ControlSample" SelectedDate="{Binding CalendarDate, Mode=TwoWay}" Margin="0,0,12,12" /><CalendarDatePicker SelectedDate="{Binding CalendarDate, Mode=TwoWay}" PlaceholderText="选择日期" Margin="0,0,12,12" /><CalendarDatePicker SelectedDate="{Binding CalendarDate}" IsEnabled="False" Margin="0,0,12,12" /></WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
 <TextBlock Text="外观样式" FontWeight="SemiBold" />
<StackPanel Spacing="12" IsEnabled="{Binding Enabled}"><CalendarDatePicker Name="FilledCalendarSample" Classes="filled" SelectedDate="{Binding CalendarDate, Mode=TwoWay}" Width="300" /></StackPanel>
</StackPanel>
</local:BasicControlPage>
