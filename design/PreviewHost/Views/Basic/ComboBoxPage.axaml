<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ComboBoxPage"
    x:DataType="local:ComboBoxPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ComboBox" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="已选值 / 占位提示 / 禁用 · 1,000 项按需生成"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <ComboBox
                    ItemsSource="{CompiledBinding Items}"
                    Margin="0,0,12,12"
                    Name="ControlSample"
                    SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
                    Width="260" />
                <ComboBox
                    ItemsSource="{CompiledBinding Items}"
                    Margin="0,0,12,12"
                    PlaceholderText="请选择工作区"
                    Width="260" />
                <ComboBox
                    IsEnabled="False"
                    ItemsSource="{CompiledBinding Items}"
                    Margin="0,0,12,12"
                    SelectedIndex="1"
                    Width="260" />
            </WrapPanel>
        </StackPanel>
        <Button
            Command="{CompiledBinding LastCommand}"
            Content="第 1,000 项"
            HorizontalAlignment="Left" />
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <WrapPanel>
                <ComboBox
                    Classes="filled"
                    ItemsSource="{CompiledBinding Items}"
                    Margin="0,0,12,12"
                    SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
                    Width="260" />
                <ComboBox
                    Classes="underlined"
                    ItemsSource="{CompiledBinding Items}"
                    Margin="0,0,12,12"
                    SelectedIndex="{CompiledBinding SelectedIndex, Mode=TwoWay}"
                    Width="260" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
