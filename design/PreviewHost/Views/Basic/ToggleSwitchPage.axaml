<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ToggleSwitchPage"
    x:DataType="local:ToggleSwitchPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ToggleSwitch" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="关闭 / 开启 / 禁用"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <WrapPanel>
                <ToggleSwitch
                    Content="自动同步"
                    IsChecked="{Binding Checked, Mode=TwoWay}"
                    Margin="0,0,12,12"
                    Name="ControlSample" />
                <ToggleSwitch
                    Content="已开启"
                    IsChecked="True"
                    Margin="0,0,12,12" />
                <ToggleSwitch
                    Content="禁用开关"
                    IsChecked="True"
                    IsEnabled="False"
                    Margin="0,0,12,12" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>