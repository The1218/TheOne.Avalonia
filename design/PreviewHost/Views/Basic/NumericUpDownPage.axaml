<local:BasicControlPage
    x:Class="TheOne.DesignPreview.NumericUpDownPage"
    x:DataType="local:NumericUpDownPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="NumericUpDown" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="整数步进 / 小数步进 / 无微调按钮 / 禁用"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <NumericUpDown
                    Margin="0,0,12,12"
                    Maximum="1000"
                    Minimum="0"
                    Name="ControlSample"
                    Value="{CompiledBinding Number, Mode=TwoWay}"
                    Width="220" />
                <NumericUpDown
                    FormatString="0.0"
                    Increment="0.5"
                    Margin="0,0,12,12"
                    Value="12.5"
                    Width="220" />
                <NumericUpDown
                    Margin="0,0,12,12"
                    ShowButtonSpinner="False"
                    Value="42"
                    Width="220" />
                <NumericUpDown
                    IsEnabled="False"
                    Margin="0,0,12,12"
                    Value="28"
                    Width="220" />
            </WrapPanel>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <WrapPanel>
                <NumericUpDown
                    Classes="filled"
                    Margin="0,0,12,12"
                    Value="{CompiledBinding Number, Mode=TwoWay}"
                    Width="220" />
                <NumericUpDown
                    Classes="underlined"
                    Margin="0,0,12,12"
                    Value="{CompiledBinding Number, Mode=TwoWay}"
                    Width="220" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
