<local:BasicControlPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOne.DesignPreview" xmlns:one="using:TheOne.Avalonia.Controls" x:Class="TheOne.DesignPreview.NumericUpDownPage" x:DataType="local:NumericUpDownPageViewModel">
 <StackPanel Spacing="18">
  <TextBlock Text="NumericUpDown" FontSize="22" FontWeight="SemiBold" />
  <TextBlock Text="整数步进 / 小数步进 / 无微调按钮 / 禁用" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap" />
  <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
  <StackPanel Spacing="16" IsEnabled="{Binding Enabled}">
    <WrapPanel><NumericUpDown Name="ControlSample" Value="{Binding Number, Mode=TwoWay}" Minimum="0" Maximum="1000" Width="220" Margin="0,0,12,12" /><NumericUpDown Value="12.5" Increment="0.5" FormatString="0.0" Width="220" Margin="0,0,12,12" /><NumericUpDown Value="42" ShowButtonSpinner="False" Width="220" Margin="0,0,12,12" /><NumericUpDown Value="28" IsEnabled="False" Width="220" Margin="0,0,12,12" /></WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
 </StackPanel>
</local:BasicControlPage>
