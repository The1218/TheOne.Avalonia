<local:BasicControlPage
    x:Class="TheOne.DesignPreview.TextBoxPage"
    x:DataType="local:TextBoxPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="TextBox" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="普通 / 占位提示 / 密码 / 只读 / 多行输入"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <TextBox
                HorizontalAlignment="Stretch"
                MaxWidth="420"
                Name="ControlSample"
                PlaceholderText="普通输入"
                Text="{CompiledBinding Text, Mode=TwoWay}" />
            <TextBox
                HorizontalAlignment="Stretch"
                MaxWidth="420"
                PlaceholderText="空输入与占位提示" />
            <TextBox
                HorizontalAlignment="Stretch"
                MaxWidth="420"
                PasswordChar="●"
                Text="密码输入" />
            <TextBox
                HorizontalAlignment="Stretch"
                IsReadOnly="True"
                MaxWidth="420"
                Text="只读内容，可选择复制" />
            <TextBox
                AcceptsReturn="True"
                Height="100"
                HorizontalAlignment="Stretch"
                MaxWidth="420"
                Text="多行内容&#10;回车继续编辑"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <TextBox
                Classes="filled"
                MaxWidth="420"
                Name="FilledInputSample"
                Text="{CompiledBinding Text, Mode=TwoWay}" />
            <TextBox
                Classes="underlined"
                MaxWidth="420"
                Name="UnderlinedInputSample"
                Text="{CompiledBinding Text, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
