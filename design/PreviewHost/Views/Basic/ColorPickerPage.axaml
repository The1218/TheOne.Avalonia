<UserControl
    x:Class="TheOne.DesignPreview.ColorPickerPage"
    x:CompileBindings="True"
    x:DataType="local:ColorPickerPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="22">
        <StackPanel Spacing="7">
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Text="ColorPicker · 颜色选择器" />
            <TextBlock
                Foreground="{DynamicResource One.Muted}"
                Text="色谱、调色板与 RGB / HSV · 透明度与 Hex 输入"
                TextWrapping="Wrap" />
        </StackPanel>
        <WrapPanel>
            <CheckBox
                Content="启用透明度"
                IsChecked="{Binding AlphaEnabled, Mode=TwoWay}"
                Margin="0,0,24,8"
                Name="AlphaToggle" />
            <CheckBox
                Content="显示调色板"
                IsChecked="{Binding PaletteVisible, Mode=TwoWay}"
                Margin="0,0,0,8"
                Name="PaletteToggle" />
        </WrapPanel>
        <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="下拉选择" />
            <WrapPanel>
                <ColorPicker
                    AutomationProperties.Name="选择颜色"
                    Color="{Binding SelectedColor, Mode=TwoWay}"
                    IsAlphaEnabled="{Binding AlphaEnabled}"
                    IsColorPaletteVisible="{Binding PaletteVisible}"
                    Margin="0,0,16,8"
                    Name="ControlSample" />
                <ColorPicker
                    AutomationProperties.Name="不透明颜色"
                    Color="#C86835"
                    IsAlphaEnabled="False"
                    Margin="0,0,16,8"
                    Name="OpaqueSample" />
                <ColorPicker
                    AutomationProperties.Name="禁用颜色选择"
                    Color="#778080"
                    IsEnabled="False"
                    Margin="0,0,0,8"
                    Name="DisabledSample" />
            </WrapPanel>
        </StackPanel>
        <Grid
            ColumnDefinitions="340,28,*"
            Name="ColorLayout"
            RowDefinitions="Auto,Auto">
            <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="精细调色" />
                <Border HorizontalAlignment="Left" Name="InlineFrame">
                    <ColorView
                        AutomationProperties.Name="精细颜色选择"
                        Color="{Binding SelectedColor, Mode=TwoWay}"
                        IsAlphaEnabled="{Binding AlphaEnabled}"
                        IsColorPaletteVisible="{Binding PaletteVisible}"
                        Name="ColorViewSample" />
                </Border>
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Left"
                MaxWidth="250"
                Name="ColorSummary"
                Spacing="14">
                <TextBlock FontWeight="SemiBold" Text="当前颜色" />
                <Border
                    Background="{DynamicResource ColorControlCheckeredBackgroundBrush}"
                    BorderBrush="{DynamicResource One.InputLine}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="72">
                    <Border Background="{Binding SelectedBrush}" CornerRadius="6" />
                </Border>
                <SelectableTextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding Hex}" />
                <TextBlock
                    Foreground="{DynamicResource One.Muted}"
                    Text="{Binding Channels}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource One.Muted}"
                    Text="颜色预览为 #AARRGGBB。编辑器内 Hex 输入沿用官方顺序。"
                    TextWrapping="Wrap" />
                <Button
                    Click="ResetColor"
                    Content="恢复主题色"
                    HorizontalAlignment="Left" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>