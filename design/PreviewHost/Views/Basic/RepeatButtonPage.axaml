<local:BasicControlPage
    x:Class="TheOne.DesignPreview.RepeatButtonPage"
    x:DataType="local:RepeatButtonPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="RepeatButton" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="标准重复 / 快速重复 / 禁用 · 操作次数显示在下方"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <RepeatButton
                    Command="{CompiledBinding InvokeCommand}"
                    Content="按住重复执行"
                    Margin="0,0,12,12"
                    Name="ControlSample" />
                <RepeatButton
                    Command="{CompiledBinding InvokeCommand}"
                    Content="快速重复"
                    Delay="200"
                    Interval="50"
                    Margin="0,0,12,12" />
                <RepeatButton
                    Content="禁用"
                    IsEnabled="False"
                    Margin="0,0,12,12" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
