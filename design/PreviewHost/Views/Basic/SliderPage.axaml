<local:BasicControlPage xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOne.DesignPreview" xmlns:one="using:TheOne.Avalonia.Controls" x:Class="TheOne.DesignPreview.SliderPage" x:DataType="local:SliderPageViewModel">
 <StackPanel Spacing="18">
  <TextBlock Text="Slider" FontSize="22" FontWeight="SemiBold" />
  <TextBlock Text="连续值 / 刻度吸附 / 禁用" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap" />
  <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
  <StackPanel Spacing="16" IsEnabled="{Binding Enabled}">
    <Slider Name="ControlSample" Value="{Binding Value, Mode=TwoWay}" Minimum="0" Maximum="100" MaxWidth="420"/>
    <Slider Value="{Binding Value, Mode=TwoWay}" TickFrequency="20" TickPlacement="BottomRight" IsSnapToTickEnabled="True" MaxWidth="420"/>
    <Slider Value="64" IsEnabled="False" MaxWidth="420"/>
  </StackPanel>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
 </StackPanel>
</local:BasicControlPage>
