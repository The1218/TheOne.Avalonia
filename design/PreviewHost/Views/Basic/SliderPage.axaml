<local:BasicControlPage
    x:Class="TheOne.DesignPreview.SliderPage"
    x:DataType="local:SliderPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Slider" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="连续值 / 刻度吸附 / 禁用"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <Slider
                MaxWidth="420"
                Maximum="100"
                Minimum="0"
                Name="ControlSample"
                Value="{Binding Value, Mode=TwoWay}" />
            <Slider
                IsSnapToTickEnabled="True"
                MaxWidth="420"
                TickFrequency="20"
                TickPlacement="BottomRight"
                Value="{Binding Value, Mode=TwoWay}" />
            <Slider
                IsEnabled="False"
                MaxWidth="420"
                Value="64" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>