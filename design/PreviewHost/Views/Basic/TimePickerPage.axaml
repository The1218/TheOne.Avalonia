<local:BasicControlPage
    x:Class="TheOne.DesignPreview.TimePickerPage"
    x:DataType="local:TimePickerPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="TimePicker" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="标准格式 / 精简格式 / 禁用 · 保留原生日期与时间弹窗"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <TimePicker
                    ClockIdentifier="24HourClock"
                    Margin="0,0,12,12"
                    Name="ControlSample"
                    SelectedTime="{CompiledBinding Time, Mode=TwoWay}"
                    UseSeconds="True" />
                <TimePicker
                    ClockIdentifier="12HourClock"
                    Margin="0,0,12,12"
                    SelectedTime="{CompiledBinding Time, Mode=TwoWay}"
                    UseSeconds="False" />
                <TimePicker
                    IsEnabled="False"
                    Margin="0,0,12,12"
                    SelectedTime="{CompiledBinding Time}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <TimePicker
                Classes="filled"
                Name="FilledTimeSample"
                SelectedTime="{CompiledBinding Time, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
