<local:BasicControlPage
    x:Class="TheOne.DesignPreview.SelectableTextBlockPage"
    x:DataType="local:SelectableTextBlockPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="SelectableTextBlock" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="正文 / 强调 / 多行 / 辅助信息 · 保留文字选择与复制"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <SelectableTextBlock
                Name="ControlSample"
                Text="{Binding Text, Mode=TwoWay}"
                TextWrapping="Wrap" />
            <SelectableTextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource One.Accent}"
                Text="强调信息 · 可以选择并复制"
                TextWrapping="Wrap" />
            <SelectableTextBlock Text="多行文本展示&#10;拖动鼠标选择文字，使用快捷键复制。" TextWrapping="Wrap" />
            <SelectableTextBlock
                Foreground="{DynamicResource One.Muted}"
                Text="辅助说明"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
</local:BasicControlPage>