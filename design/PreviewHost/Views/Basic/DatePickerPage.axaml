<local:BasicControlPage
    x:Class="TheOne.DesignPreview.DatePickerPage"
    x:DataType="local:DatePickerPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="DatePicker" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="标准格式 / 精简格式 / 禁用 · 保留原生日期与时间弹窗"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <WrapPanel>
                <DatePicker
                    Margin="0,0,12,12"
                    Name="ControlSample"
                    SelectedDate="{CompiledBinding Date, Mode=TwoWay}" />
                <DatePicker
                    DayVisible="False"
                    Margin="0,0,12,12"
                    SelectedDate="{CompiledBinding Date, Mode=TwoWay}" />
                <DatePicker
                    IsEnabled="False"
                    Margin="0,0,12,12"
                    SelectedDate="{CompiledBinding Date}" />
            </WrapPanel>
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <DatePicker
                Classes="filled"
                Name="FilledDateSample"
                SelectedDate="{CompiledBinding Date, Mode=TwoWay}" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
