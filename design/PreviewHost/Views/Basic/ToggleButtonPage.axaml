<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ToggleButtonPage"
    x:DataType="local:ToggleButtonPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ToggleButton" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="未选中 / 选中 / 不确定 / 禁用 · 可点击对比切换状态"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <StackPanel Name="CombinationsPanel" Spacing="12" />
            <WrapPanel>
                <ToggleButton
                    Content="点击切换"
                    IsChecked="{CompiledBinding Checked, Mode=TwoWay}"
                    Margin="0,0,12,12"
                    Name="ControlSample" />
                <ToggleButton
                    Content="已选中"
                    IsChecked="True"
                    Margin="0,0,12,12" />
                <ToggleButton
                    Content="三态切换"
                    IsChecked="{x:Null}"
                    IsThreeState="True"
                    Margin="0,0,12,12" />
                <ToggleButton
                    Content="禁用选中"
                    IsChecked="True"
                    IsEnabled="False"
                    Margin="0,0,12,12" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
