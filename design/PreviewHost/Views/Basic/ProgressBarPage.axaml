<local:BasicControlPage
    x:Class="TheOne.DesignPreview.ProgressBarPage"
    x:DataType="local:ProgressBarPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="ProgressBar" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="确定进度 / 完成 / 不确定进度 · 拖动滑块调整"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{CompiledBinding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="16">
            <ProgressBar
                Height="10"
                MaxWidth="420"
                Maximum="100"
                Minimum="0"
                Name="ControlSample"
                Value="{CompiledBinding Value, Mode=TwoWay}" />
            <ProgressBar
                Height="16"
                MaxWidth="420"
                Value="100" />
            <ProgressBar
                Height="10"
                IsIndeterminate="True"
                MaxWidth="420" />
            <Slider MaxWidth="420" Value="{CompiledBinding Value, Mode=TwoWay}" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="外观样式" />
        <StackPanel IsEnabled="{CompiledBinding Enabled}" Spacing="12">
            <ProgressBar
                Classes="gradient"
                MaxWidth="420"
                Value="{CompiledBinding Value}" />
            <ProgressBar
                Classes="success"
                MaxWidth="420"
                Value="100" />
            <ProgressBar
                Classes="warning"
                MaxWidth="420"
                Value="48" />
            <ProgressBar
                Classes="danger"
                MaxWidth="420"
                Value="24" />
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>
