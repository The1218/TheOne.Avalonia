<local:BasicControlPage
    styling:Motion.Enabled="{CompiledBinding MotionEnabled}"
    x:Class="TheOne.DesignPreview.IconButtonPage"
    x:DataType="local:IconButtonPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:kinds="clr-namespace:Material.Icons;assembly=Material.Icons"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:styling="using:TheOne.Avalonia.Styling"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <StackPanel Name="CombinationsPanel" IsEnabled="{CompiledBinding Enabled}" Spacing="12" />
        <TextBlock FontWeight="SemiBold" Text="IconButton · 图标属性与模板" />
        <WrapPanel>
            <one:IconButton
                Content="内置 OneIcon"
                Icon="{x:Static one:OneIconKind.Save}"
                Command="{CompiledBinding InvokeCommand}"
                Margin="0,0,12,8" />
            <one:IconButton
                Classes="primary"
                Command="{CompiledBinding InvokeCommand}"
                Content="新建项目"
                Icon="{CompiledBinding Icon}"
                Margin="0,0,12,8"
                Name="GeometryIcon" />
            <one:IconButton
                Command="{CompiledBinding InvokeCommand}"
                Content="工作区"
                Icon="{CompiledBinding MaterialIcon}"
                Margin="0,0,12,8"
                Name="MaterialIcon">
                <one:IconButton.IconTemplate>
                    <DataTemplate x:DataType="kinds:MaterialIconKind">
                        <material:MaterialIcon Kind="{CompiledBinding}" />
                    </DataTemplate>
                </one:IconButton.IconTemplate>
            </one:IconButton>
            <one:IconButton
                AutomationProperties.Name="收藏"
                Classes="ghost"
                Command="{CompiledBinding InvokeCommand}"
                Margin="0,0,12,8"
                Name="PathIconControl"
                ToolTip.Tip="收藏">
                <one:IconButton.Icon>
                    <PathIcon Data="M8,1 L10,6 L15,6 L11,9 L13,15 L8,12 L3,15 L5,9 L1,6 L6,6 Z" />
                </one:IconButton.Icon>
            </one:IconButton>
            <one:IconButton
                Content="禁用图标操作"
                Icon="{CompiledBinding Icon}"
                IsEnabled="False"
                Margin="0,0,12,8" />
        </WrapPanel>
        <TextBlock FontWeight="SemiBold" Text="加载状态 · 运行三秒，可在过程中关闭／开启动效" />
        <StackPanel Orientation="Horizontal" Spacing="16">
            <CheckBox Content="手动加载" IsChecked="{CompiledBinding IsLoading, Mode=TwoWay}" />
            <CheckBox Content="启用动效" IsChecked="{CompiledBinding MotionEnabled, Mode=TwoWay}" />
        </StackPanel>
        <WrapPanel>
            <one:IconButton
                Command="{CompiledBinding LoadCommand}"
                Content="左侧"
                Icon="{CompiledBinding Icon}"
                IconPlacement="Left"
                IsLoading="{CompiledBinding IsLoading}"
                Margin="0,0,16,8"
                Name="PlacementLeft" />
            <one:IconButton
                Command="{CompiledBinding LoadCommand}"
                Content="右侧"
                Icon="{CompiledBinding Icon}"
                IconPlacement="Right"
                IsLoading="{CompiledBinding IsLoading}"
                Margin="0,0,16,8"
                Name="PlacementRight" />
            <one:IconButton
                Command="{CompiledBinding LoadCommand}"
                Content="上方"
                Icon="{CompiledBinding Icon}"
                IconPlacement="Top"
                IsLoading="{CompiledBinding IsLoading}"
                Margin="0,0,16,8"
                Name="PlacementTop" />
            <one:IconButton
                Command="{CompiledBinding LoadCommand}"
                Content="下方"
                Icon="{CompiledBinding Icon}"
                IconPlacement="Bottom"
                IsLoading="{CompiledBinding IsLoading}"
                Margin="0,0,16,8"
                Name="PlacementBottom" />
        </WrapPanel>
    </StackPanel>
</local:BasicControlPage>
