<local:BasicControlPage
    x:Class="TheOne.DesignPreview.CalendarPage"
    x:DataType="local:CalendarPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Calendar" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="月份 / 年份 / 十年视图"
            TextWrapping="Wrap" />
        <CheckBox Content="启用控件" IsChecked="{Binding Enabled, Mode=TwoWay}" />
        <StackPanel IsEnabled="{Binding Enabled}" Spacing="16">
            <WrapPanel>
                <Calendar
                    Margin="0,0,12,12"
                    Name="ControlSample"
                    SelectedDate="{Binding CalendarDate, Mode=TwoWay}" />
                <Calendar DisplayMode="Year" Margin="0,0,12,12" />
                <Calendar DisplayMode="Decade" Margin="0,0,12,12" />
            </WrapPanel>
        </StackPanel>
    </StackPanel>
</local:BasicControlPage>