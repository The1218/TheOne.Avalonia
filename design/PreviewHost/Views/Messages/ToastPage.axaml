<UserControl
    x:Class="TheOne.DesignPreview.ToastPage"
    x:DataType="local:MessagePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        HorizontalAlignment="Stretch"
        MaxWidth="760"
        Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Toast · 即时反馈" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="仅展示状态图标与正文，两者垂直居中。支持多行内容、自动消失、点击关闭及关闭全部。"
            TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="状态 / 类型" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{CompiledBinding Types}"
                    Name="MessageType"
                    SelectedItem="{CompiledBinding Type, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="显示尺寸" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{CompiledBinding Sizes}"
                    SelectedItem="{CompiledBinding Size, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <TextBox
            AcceptsReturn="True"
            MinHeight="76"
            Name="MessageText"
            PlaceholderText="提示内容"
            Text="{CompiledBinding Message, Mode=TwoWay}"
            TextWrapping="Wrap" />
        <CheckBox Content="启用动效" IsChecked="{CompiledBinding MotionEnabled, Mode=TwoWay}" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="显示位置" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{CompiledBinding Positions}"
                    SelectedItem="{CompiledBinding Position, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="停留秒数" />
                <NumericUpDown
                    Increment="0.5"
                    IsEnabled="{CompiledBinding AutoClose}"
                    Maximum="120"
                    Minimum="0.1"
                    Value="{CompiledBinding Seconds, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="同时显示上限" />
                <NumericUpDown
                    Maximum="10"
                    Minimum="1"
                    Value="{CompiledBinding Maximum, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <CheckBox Content="自动关闭" IsChecked="{CompiledBinding AutoClose, Mode=TwoWay}" />
        <WrapPanel>
            <Button
                Classes="primary"
                Command="{CompiledBinding ToastCommand}"
                Content="显示 Toast"
                Margin="0,0,12,0"
                Name="ShowMessage" />
            <Button
                Classes="ghost"
                Command="{CompiledBinding CloseToastCommand}"
                Content="关闭全部" />
        </WrapPanel>
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="{CompiledBinding Status}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
