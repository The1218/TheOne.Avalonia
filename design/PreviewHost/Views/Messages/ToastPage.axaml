<UserControl
    x:Class="TheOne.DesignPreview.ToastPage"
    x:DataType="local:MessagePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        HorizontalAlignment="Stretch"
        MaxWidth="760"
        Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Toast · 即时反馈" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="默认顶部居中。配置标题、状态、停留时间和位置后，点击显示观察效果。"
            TextWrapping="Wrap" />
        <local:MessageDemoSettings />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="显示位置" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding Positions}"
                    SelectedItem="{Binding Position, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="停留秒数" />
                <NumericUpDown
                    Increment="0.5"
                    IsEnabled="{Binding AutoClose}"
                    Maximum="120"
                    Minimum="0.1"
                    Value="{Binding Seconds, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="同时显示上限" />
                <NumericUpDown
                    Maximum="10"
                    Minimum="1"
                    Value="{Binding Maximum, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <CheckBox Content="自动关闭" IsChecked="{Binding AutoClose, Mode=TwoWay}" />
        <WrapPanel>
            <Button
                Classes="primary"
                Command="{Binding ToastCommand}"
                Content="显示 Toast"
                Margin="0,0,12,0"
                Name="ShowMessage" />
            <Button
                Classes="ghost"
                Command="{Binding CloseToastCommand}"
                Content="关闭全部" />
        </WrapPanel>
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="{Binding Status}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>