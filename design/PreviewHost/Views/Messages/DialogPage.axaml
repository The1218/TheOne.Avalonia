<UserControl
    x:Class="TheOne.DesignPreview.DialogPage"
    x:DataType="local:MessagePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        HorizontalAlignment="Stretch"
        MaxWidth="760"
        Spacing="18">
        <TextBlock
            FontSize="22"
            FontWeight="SemiBold"
            Text="Dialog · 确认与表单" />
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="配置对话框外观和关闭行为。表单通过独立 VM 的命令返回结果。"
            TextWrapping="Wrap" />
        <local:MessageDemoSettings />
        <StackPanel Spacing="6">
            <TextBlock Text="确认按钮组合" />
            <ComboBox
                HorizontalAlignment="Stretch"
                ItemsSource="{CompiledBinding ButtonSets}"
                SelectedItem="{CompiledBinding Buttons, Mode=TwoWay}" />
        </StackPanel>
        <WrapPanel>
            <CheckBox
                Content="显示关闭按钮"
                IsChecked="{CompiledBinding ShowClose, Mode=TwoWay}"
                Margin="0,0,20,8" />
            <CheckBox
                Content="显示确认按钮"
                IsChecked="{CompiledBinding ShowButtons, Mode=TwoWay}"
                Margin="0,0,20,8" />
            <CheckBox
                Content="点击蒙层关闭"
                IsChecked="{CompiledBinding OverlayClose, Mode=TwoWay}"
                Margin="0,0,20,8" />
            <CheckBox Content="Esc 关闭" IsChecked="{CompiledBinding EscapeClose, Mode=TwoWay}" />
        </WrapPanel>
        <WrapPanel>
            <Button
                Classes="primary"
                Command="{CompiledBinding DialogCommand}"
                Content="显示确认对话框"
                Margin="0,0,12,0"
                Name="ShowDialog" />
            <Button
                Classes="outline"
                Command="{CompiledBinding FormDialogCommand}"
                Content="打开 VM 表单" />
        </WrapPanel>
        <TextBlock
            Foreground="{DynamicResource One.Muted}"
            Text="{CompiledBinding Status}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
