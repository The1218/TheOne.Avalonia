<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOne.DesignPreview" x:Class="TheOne.DesignPreview.DialogPage" x:DataType="local:MessagePageViewModel">
  <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
    <TextBlock Text="Dialog · 确认与表单" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="配置对话框外观和关闭行为。表单通过独立 VM 的命令返回结果。" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap" />
    <local:MessageDemoSettings />
    <StackPanel Spacing="6"><TextBlock Text="确认按钮组合" /><ComboBox ItemsSource="{Binding ButtonSets}" SelectedItem="{Binding Buttons, Mode=TwoWay}" HorizontalAlignment="Stretch" /></StackPanel>
    <WrapPanel>
      <CheckBox Content="显示关闭按钮" IsChecked="{Binding ShowClose, Mode=TwoWay}" Margin="0,0,20,8" />
      <CheckBox Content="显示确认按钮" IsChecked="{Binding ShowButtons, Mode=TwoWay}" Margin="0,0,20,8" />
      <CheckBox Content="点击蒙层关闭" IsChecked="{Binding OverlayClose, Mode=TwoWay}" Margin="0,0,20,8" />
      <CheckBox Content="Esc 关闭" IsChecked="{Binding EscapeClose, Mode=TwoWay}" />
    </WrapPanel>
    <WrapPanel><Button Name="ShowDialog" Classes="primary" Content="显示确认对话框" Command="{Binding DialogCommand}" Margin="0,0,12,0" /><Button Classes="outline" Content="打开 VM 表单" Command="{Binding FormDialogCommand}" /></WrapPanel>
    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource One.Muted}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
