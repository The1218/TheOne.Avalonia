<UserControl
    x:Class="TheOne.DesignPreview.DialogEditorView"
    x:CompileBindings="True"
    x:DataType="local:DialogEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <TextBlock FontWeight="SemiBold" Text="工作区名称" />
        <TextBox
            Name="WorkspaceName"
            PlaceholderText="输入名称"
            Text="{Binding Name, Mode=TwoWay}" />
        <TextBlock Text="保存和取消由内部 ViewModel 发出关闭事件，父页面 await 获取结果。" TextWrapping="Wrap" />
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{Binding CancelCommand}"
                Content="取消"
                Name="EditorCancel" />
            <Button
                Classes="primary"
                Command="{Binding SaveCommand}"
                Content="保存"
                Name="EditorSave" />
        </StackPanel>
    </StackPanel>
</UserControl>