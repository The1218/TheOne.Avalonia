<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TheOne.DesignPreview" x:Class="TheOne.DesignPreview.DialogEditorView"
             x:DataType="local:DialogEditorViewModel" x:CompileBindings="True">
  <StackPanel Spacing="16">
    <TextBlock Text="工作区名称" FontWeight="SemiBold" />
    <TextBox Name="WorkspaceName" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="输入名称" />
    <TextBlock Text="保存和取消由内部 ViewModel 发出关闭事件，父页面 await 获取结果。" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="EditorCancel" Content="取消" Command="{Binding CancelCommand}" />
      <Button Name="EditorSave" Content="保存" Classes="primary" Command="{Binding SaveCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
