<UserControl
    x:Class="TheOne.DesignPreview.MessageDialogView"
    x:DataType="local:MessagePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <one:Tag Content="{Binding Type}" Status="{Binding MessageStatus}" />
        <TextBlock
            MaxWidth="520"
            Text="{Binding Message}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>