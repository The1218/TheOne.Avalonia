<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>TheOne.DesignPreview.Program</StartupObject>
    <ApplicationIcon>Assets/Brand/theone-app.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <AvaloniaVersion>12.1.4</AvaloniaVersion>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Views/**/*.axaml;Views/**/*.cs;ViewModels/**/*.cs" />
    <EmbeddedResource Include="Infrastructure/Printing/PreviewPrinting.cs" />
    <EmbeddedResource Include="Verification/Fixtures/DataGridTreeFixture.axaml;Verification/Fixtures/DataGridTreeFixture.axaml.cs" />
    <Compile Remove="Consumers/**/*.cs" />
    <AvaloniaResource Remove="Consumers/**/*.axaml" />
    <AvaloniaXaml Remove="Consumers/**/*.axaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../TheOne.Avalonia/TheOne.Avalonia.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="TheOne.PrintingTools.Avalonia" Version="1.0.0-preview.3" />
    <PackageReference Include="TheOne.Avalonia.CodeEditor" Version="1.0.0-preview.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ReportOnlyPreview)' == 'true'">
    <StartupObject>TheOne.DesignPreview.ReportOnlyProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReportOnlyPreview)' == 'true'">
    <Compile Remove="**/*.cs" />
    <AvaloniaResource Remove="@(AvaloniaResource)" />
    <AvaloniaXaml Remove="@(AvaloniaXaml)" />
    <Compile Include="Verification/DataDisplay/Report*Preview.cs" />
    <Compile Include="Verification/DataDisplay/ReportOnlyProgram.cs" />
    <Compile Include="Views/ReportDesign/ReportDesignDemo.cs" />
  </ItemGroup>
</Project>
