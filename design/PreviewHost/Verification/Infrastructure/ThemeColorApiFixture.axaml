<UserControl
    x:Class="TheOne.DesignPreview.ThemeColorApiFixture"
    x:CompileBindings="True"
    x:DataType="local:ThemeColorApiModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16" Spacing="12">
        <one:ThemeColorPicker Name="Picker" SelectThemeColor="{Binding Color}" />
        <one:ThemeColorPicker Name="LegacyPicker" SelectedColor="{Binding Color}" />
        <TextBlock
            Foreground="{DynamicResource One.Text}"
            Name="ColorText"
            Text="Palette" />
        <Border Height="6" Name="RawColor">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource One.AccentColor}" />
            </Border.Background>
        </Border>
        <Button Classes="primary" Content="枚举配色" />
    </StackPanel>
</UserControl>