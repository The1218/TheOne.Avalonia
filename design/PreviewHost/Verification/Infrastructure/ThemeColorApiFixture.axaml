<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:one="using:TheOne.Avalonia.Controls" xmlns:local="using:TheOne.DesignPreview"
             x:Class="TheOne.DesignPreview.ThemeColorApiFixture" x:DataType="local:ThemeColorApiModel" x:CompileBindings="True">
  <StackPanel Spacing="12" Margin="16">
    <one:ThemeColorPicker Name="Picker" SelectThemeColor="{Binding Color}" />
    <one:ThemeColorPicker Name="LegacyPicker" SelectedColor="{Binding Color}" />
    <TextBlock Name="ColorText" Text="Palette" Foreground="{DynamicResource One.Text}" />
    <Border Name="RawColor" Height="6"><Border.Background><SolidColorBrush Color="{DynamicResource One.AccentColor}" /></Border.Background></Border>
    <Button Classes="primary" Content="枚举配色" />
  </StackPanel>
</UserControl>
