<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TheOne.DesignPreview"
             x:Class="TheOne.DesignPreview.DataGridCollectionsFixture" x:DataType="local:DataGridBindingDemoViewModel">
    <Grid RowDefinitions="*,*,*" RowSpacing="12">
        <DataGrid Name="ListGrid" ItemsSource="{Binding ListRows}" AutoGenerateColumns="False" MaxColumnWidth="280">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Id}" IsReadOnly="True" />
                <DataGridTextColumn Header="设备" Binding="{Binding Name, Mode=TwoWay}" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" />
                <DataGridTemplateColumn Header="按钮" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Name="ObservableGrid" Grid.Row="1" ItemsSource="{Binding ObservableRows}" AutoGenerateColumns="False"
                  MaxColumnWidth="280">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Id}" IsReadOnly="True" />
                <DataGridTextColumn Header="设备" Binding="{Binding Name, Mode=TwoWay}" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" />
                <DataGridTemplateColumn Header="按钮" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DataGrid Name="TypedViewGrid" Grid.Row="2" ItemsSource="{Binding TypedView}" AutoGenerateColumns="False"
                  MaxColumnWidth="280">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Id}" IsReadOnly="True" />
                <DataGridTextColumn Header="设备" Binding="{Binding Name, Mode=TwoWay}" />
                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" />
                <DataGridTemplateColumn Header="按钮" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>