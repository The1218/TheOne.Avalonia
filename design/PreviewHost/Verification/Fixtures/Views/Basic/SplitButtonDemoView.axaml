<UserControl
    x:Class="TheOne.DesignPreview.SplitButtonDemoView"
    x:DataType="local:SplitButtonDemoViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource One.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.demo-region">
            <Setter Property="Background" Value="{DynamicResource One.Subtle}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style Selector="SplitButton">
            <Setter Property="Margin" Value="0,0,16,8" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                FontWeight="SemiBold"
                Text="21  分裂按钮 / SplitButton · ToggleSplitButton"
                TextWrapping="Wrap" />
            <TextBlock Classes="note" Text="主区域执行操作，箭头打开菜单 · Enter / Space 执行 · F4 / Alt + ↓ 打开 · Esc 关闭" />
        </StackPanel>
        <WrapPanel>
            <CheckBox
                Content="启用交互"
                IsChecked="{Binding IsEnabled}"
                Margin="0,0,16,8"
                Name="SplitDemoEnabled" />
            <CheckBox
                Content="命令可执行"
                IsChecked="{Binding AllowCommand}"
                Margin="0,0,16,8"
                Name="SplitCommandEnabled" />
            <Button
                Classes="ghost"
                Command="{Binding ResetCommand}"
                Content="重置"
                Name="ResetSplitDemo" />
        </WrapPanel>
        <Border Classes="demo-region">
            <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="主操作 + 更多选择" />
                <WrapPanel>
                    <SplitButton
                        Command="{Binding MainActionCommand}"
                        CommandParameter="导出"
                        Content="{Binding ExportLabel}"
                        IsEnabled="{Binding IsEnabled}"
                        Name="ExportSplit">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding ChooseFormatCommand}"
                                    CommandParameter="PDF"
                                    Header="导出为 PDF" />
                                <MenuItem
                                    Command="{Binding ChooseFormatCommand}"
                                    CommandParameter="CSV"
                                    Header="导出为 CSV" />
                                <MenuItem
                                    Command="{Binding ChooseFormatCommand}"
                                    CommandParameter="Excel"
                                    Header="导出为 Excel" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton
                        Classes="primary"
                        Command="{Binding MainActionCommand}"
                        CommandParameter="发布版本"
                        IsEnabled="{Binding IsEnabled}"
                        Name="PublishSplit">
                        <SplitButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon
                                    Data="M0,6 L14,0 L8,14 L6,8 Z"
                                    Height="14"
                                    Width="14" />
                                <TextBlock Text="发布版本" />
                            </StackPanel>
                        </SplitButton.Content>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="立即发布"
                                    Header="立即发布" />
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="安排发布"
                                    Header="安排发布" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton Content="不可用" IsEnabled="False" />
                </WrapPanel>
                <TextBlock Classes="note" Text="选择菜单项更新操作选项，主操作只执行一次。两侧独立反馈，外框保持连续。" />
            </StackPanel>
        </Border>
        <Border Classes="demo-region">
            <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="切换状态 + 更多设置" />
                <WrapPanel>
                    <ToggleSplitButton
                        Command="{Binding MainActionCommand}"
                        CommandParameter="切换自动发布"
                        Content="自动发布"
                        IsChecked="{Binding AutoPublish, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled}"
                        Name="AutoSplit">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding ChooseFrequencyCommand}"
                                    CommandParameter="每天"
                                    Header="每天" />
                                <MenuItem
                                    Command="{Binding ChooseFrequencyCommand}"
                                    CommandParameter="每周"
                                    Header="每周" />
                                <MenuItem
                                    Command="{Binding ChooseFrequencyCommand}"
                                    CommandParameter="每月"
                                    Header="每月" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </ToggleSplitButton>
                    <ToggleSplitButton
                        Classes="primary"
                        Content="固定视图"
                        IsChecked="True"
                        IsEnabled="{Binding IsEnabled}"
                        Name="PinnedSplit">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="固定当前视图"
                                    Header="固定当前视图" />
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="查看全部视图"
                                    Header="查看全部视图" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </ToggleSplitButton>
                    <ToggleSplitButton
                        Content="已选且禁用"
                        IsChecked="True"
                        IsEnabled="False" />
                </WrapPanel>
                <TextBlock Classes="note" Text="{Binding FrequencyLabel}" />
                <TextBlock Classes="note" Text="主区域切换 IsChecked 并同步绑定；箭头及菜单设置保持当前勾选状态。" />
            </StackPanel>
        </Border>
        <Border Classes="demo-region">
            <StackPanel Spacing="12">
                <TextBlock FontWeight="SemiBold" Text="独立尺寸与大量菜单项" />
                <WrapPanel>
                    <SplitButton
                        Classes="small"
                        Command="{Binding MainActionCommand}"
                        CommandParameter="小尺寸"
                        Content="小尺寸">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="小尺寸"
                                    Header="小尺寸菜单" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <ToggleSplitButton
                        Classes="normal"
                        Content="正常尺寸"
                        IsChecked="True">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="正常尺寸"
                                    Header="正常尺寸菜单" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </ToggleSplitButton>
                    <SplitButton
                        Classes="large primary"
                        Command="{Binding MainActionCommand}"
                        CommandParameter="大尺寸"
                        Content="大尺寸">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem
                                    Command="{Binding MenuCommand}"
                                    CommandParameter="大尺寸"
                                    Header="大尺寸菜单" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton
                        Command="{Binding MainActionCommand}"
                        CommandParameter="使用模板"
                        Content="选择模板 · 10,000"
                        IsEnabled="{Binding IsEnabled}"
                        Name="TemplateSplit">
                        <SplitButton.Flyout>
                            <MenuFlyout ItemsSource="{Binding Templates}">
                                <MenuFlyout.ItemTemplate>
                                    <DataTemplate x:DataType="local:SplitTemplateOption">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </MenuFlyout.ItemTemplate>
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme
                                        BasedOn="{StaticResource {x:Type MenuItem}}"
                                        TargetType="MenuItem"
                                        x:DataType="local:SplitTemplateOption">
                                        <Setter Property="Command" Value="{Binding Command}" />
                                        <Setter Property="CommandParameter" Value="{Binding Name}" />
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                </WrapPanel>
                <TextBlock Classes="note" Text="{Binding MenuMetrics}" />
            </StackPanel>
        </Border>
        <StackPanel Spacing="6">
            <TextBlock Name="SplitCounts" Text="{Binding Counts}" />
            <TextBlock
                Foreground="{DynamicResource One.Accent}"
                Name="SplitStatus"
                Text="{Binding Status}"
                TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>