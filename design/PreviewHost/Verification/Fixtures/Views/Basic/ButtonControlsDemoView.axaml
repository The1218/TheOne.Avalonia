<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:TheOne.DesignPreview" x:Class="TheOne.DesignPreview.ButtonControlsDemoView" x:DataType="local:ButtonControlsDemoView">
  <UserControl.Styles>
    <Style Selector="TextBlock.matrix-text"><Setter Property="Foreground" Value="{DynamicResource One.Text}" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource One.Muted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Border.demo-region"><Setter Property="Background" Value="{DynamicResource One.Subtle}" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="20" /></Style>
    <Style Selector="Border.theme-region"><Setter Property="Background" Value="{DynamicResource One.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource One.Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16" /></Style>
    <Style Selector="Border.size-region"><Setter Property="Background" Value="{DynamicResource One.Subtle}" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="20">
    <StackPanel Spacing="6">
      <TextBlock Text="25  按钮控件对比 / Button · ToggleButton · RepeatButton" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="note" Text="统一圆角与内边距 · 明暗主题并排 · 三档尺寸 · 普通、切换与长按重复" />
    </StackPanel>
    <Border Classes="demo-region">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="实时交互 / 跟随顶部主题与尺寸" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Name="ResetButtonDemo" Grid.Column="1" Content="重置" Classes="ghost" Click="OnReset" />
        </Grid>
        <CheckBox Name="ButtonInteractionEnabled" Content="启用以下按钮" IsChecked="True" IsCheckedChanged="OnEnabledChanged" />
        <WrapPanel Name="LiveButtonControls">
          <StackPanel Spacing="8" Margin="0,0,24,8">
            <TextBlock Classes="note" Text="Button / 单次操作" />
            <Button Name="LiveAction" Content="执行一次" Classes="primary" Click="OnAction" />
          </StackPanel>
          <StackPanel Spacing="8" Margin="0,0,24,8">
            <TextBlock Classes="note" Text="ToggleButton / 保留选中" />
            <ToggleButton Name="LiveToggle" Content="固定工具栏" IsCheckedChanged="OnToggleChanged" />
          </StackPanel>
          <StackPanel Spacing="8" Margin="0,0,0,8">
            <TextBlock Classes="note" Text="RepeatButton / 长按重复" />
            <RepeatButton Name="LiveRepeat" Content="长按 +1" ClickMode="Press" Delay="280" Interval="80" Click="OnRepeat" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Name="ButtonStatus" Text="准备就绪" TextWrapping="Wrap" />
        <TextBlock Classes="note" Text="可点击或按 Space 操作。重复按钮立即触发一次，长按 280 ms 后每 80 ms 触发；松开或禁用后停止。" />
      </StackPanel>
    </Border>
    <StackPanel Spacing="6">
      <TextBlock Text="固定状态矩阵 / 明暗 × 三档尺寸" FontWeight="SemiBold" />
      <TextBlock Classes="note" Text="固定样例不响应点击。ToggleButton 同时展示未选中和选中；每组另有主按钮的四种状态。" />
    </StackPanel>
    <Grid Name="ButtonThemeColumns" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnMatrixSizeChanged">
      <ThemeVariantScope Name="LightButtonScope" RequestedThemeVariant="Light">
        <Border Classes="theme-region"><StackPanel Name="LightButtonMatrix" Spacing="16"><TextBlock Classes="matrix-text" Text="LIGHT / 浅色" FontWeight="SemiBold" /></StackPanel></Border>
      </ThemeVariantScope>
      <ThemeVariantScope Name="DarkButtonScope" Grid.Column="1" RequestedThemeVariant="Dark">
        <Border Classes="theme-region"><StackPanel Name="DarkButtonMatrix" Spacing="16"><TextBlock Classes="matrix-text" Text="DARK / 深色" FontWeight="SemiBold" /></StackPanel></Border>
      </ThemeVariantScope>
    </Grid>
  </StackPanel>
</UserControl>
