<one:OneWindow
    Height="960"
    MinHeight="540"
    MinWidth="640"
    ThemeButtonScope="Application"
    Title="TheOne · 控件库预览"
    Width="1280"
    WindowState="Maximized"
    x:Class="TheOne.DesignPreview.LegacyPreviewWindow"
    x:DataType="local:LegacyGalleryViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:TheOne.DesignPreview"
    xmlns:one="using:TheOne.Avalonia.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <one:OneWindow.LeftContent>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.Name="展开或折叠导航"
                Classes="ghost small"
                Click="OnToggleNavigation"
                Content="☰"
                Name="NavigationToggle" />
            <TextBlock
                FontSize="11"
                Foreground="{DynamicResource One.Muted}"
                Text="PREVIEW"
                VerticalAlignment="Center" />
        </StackPanel>
    </one:OneWindow.LeftContent>
    <one:OneWindow.RightContent>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Classes="ghost small"
                Click="OnWindowNotification"
                Content="通知" />
            <Button
                Classes="ghost small"
                Click="OnWindowDialog"
                Content="对话框" />
        </StackPanel>
    </one:OneWindow.RightContent>
    <Grid ColumnDefinitions="256,*" Name="Shell">
        <Border
            Background="{DynamicResource One.Surface}"
            BorderBrush="{DynamicResource One.Line}"
            BorderThickness="0,0,1,0"
            Name="Sidebar"
            Padding="16,24">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Spacing="32">
                    <StackPanel
                        Margin="8,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Border
                            Background="{DynamicResource One.Accent}"
                            CornerRadius="8"
                            Height="32"
                            Width="32">
                            <TextBlock
                                FontSize="21"
                                FontWeight="Bold"
                                Foreground="{DynamicResource One.OnAccent}"
                                HorizontalAlignment="Center"
                                Text="1"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            FontSize="21"
                            FontWeight="SemiBold"
                            IsVisible="{Binding !NavigationCollapsed}"
                            Text="TheOne"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <one:NavMenu
                    AutomationProperties.Name="控件导航"
                    ChildrenBinding="{Binding Entries}"
                    ExpandedBinding="{Binding IsExpanded, Mode=TwoWay}"
                    Grid.Row="1"
                    IsCollapsed="{Binding NavigationCollapsed, Mode=TwoWay}"
                    IsGroupBinding="{Binding IsGroup}"
                    ItemsSource="{Binding NavigationRoots}"
                    Margin="0,24,0,16"
                    Name="Navigation"
                    SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                    SelectionChanged="OnNavigationChanged">
                    <one:NavMenu.IconTemplate>
                        <DataTemplate>
                            <Path
                                Data="{Binding Icon}"
                                Stretch="Uniform"
                                Stroke="{Binding $parent[ContentPresenter].Foreground}"
                                StrokeThickness="1.3" />
                        </DataTemplate>
                    </one:NavMenu.IconTemplate>
                    <one:NavMenu.ContentTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </one:NavMenu.ContentTemplate>
                </one:NavMenu>
                <StackPanel
                    Grid.Row="2"
                    IsVisible="{Binding !NavigationCollapsed}"
                    Margin="8,0"
                    Spacing="6">
                    <Separator />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource One.Accent}"
                        Text="STILL / LIGHT + DARK" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource One.Muted}"
                        Text="Avalonia 12.1.4 · OneTheme" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="64,*,Auto">
            <Border
                Background="{DynamicResource One.Surface}"
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="0,0,0,1"
                Padding="28,0">
                <Grid ColumnDefinitions="*,118,12,220,16,150">
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource One.Muted}"
                        Text="{Binding NavigationTitle}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <ComboBox
                        AutomationProperties.Name="控件尺寸"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Name="SizePicker"
                        SelectedIndex="1"
                        SelectionChanged="OnDensityChanged"
                        VerticalAlignment="Center">
                        <ComboBoxItem Content="小尺寸" />
                        <ComboBoxItem Content="正常尺寸" />
                        <ComboBoxItem Content="大尺寸" />
                    </ComboBox>
                    <TextBox
                        AutomationProperties.Name="搜索控件"
                        Grid.Column="3"
                        Name="Search"
                        PlaceholderText="搜索控件，例如 TextBox"
                        TextChanged="OnSearchChanged"
                        VerticalAlignment="Center" />
                    <ComboBox
                        AutomationProperties.Name="主题"
                        Grid.Column="5"
                        HorizontalAlignment="Stretch"
                        Name="ThemePicker"
                        SelectedIndex="1"
                        SelectionChanged="OnThemeChanged"
                        VerticalAlignment="Center">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色主题" />
                        <ComboBoxItem Content="深色主题" />
                    </ComboBox>
                </Grid>
            </Border>
            <local:LegacyControlGallery Grid.Row="1" Name="Gallery" />
            <Border
                Background="{DynamicResource One.Surface}"
                BorderBrush="{DynamicResource One.Line}"
                BorderThickness="0,1,0,0"
                Grid.Row="2"
                Padding="28,10">
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{DynamicResource One.Muted}"
                    Text="{Binding Status}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
    <Window.KeyBindings>
        <KeyBinding
            Command="{Binding MenuCommand}"
            CommandParameter="新建项目"
            Gesture="Ctrl+N" />
        <KeyBinding
            Command="{Binding MenuCommand}"
            CommandParameter="新建项目"
            Gesture="Meta+N" />
    </Window.KeyBindings>
</one:OneWindow>